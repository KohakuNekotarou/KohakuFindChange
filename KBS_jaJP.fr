#ifdef __ODFRC__


// Japanese string table is defined here

resource StringTable (kSDKDefStringsResourceID + index_jaJP)
{
        k_jaJP,	// Locale Id
        // Character encoding converter - stays 0, and THIS FILE IS SAVED AS SHIFT-JIS (CP932),
        // not UTF-8. That is the SDK samples' convention for a Japanese string table
        // (sdksamples/chlinguistic/CHL_jaJP.fr is CP932 with a 0 here).
        //
        // UTF-8 + kResourceUTF8Encoded - what the built-in panels use
        // (open/components/layerpanel/LayerPanelStrings_jaJP.fr) - was tried first and does NOT
        // compile: this SDK's ODFRC lexes the file as CP932, so a 3-byte UTF-8 character is read
        // as one and a half double-byte characters, the closing quote is swallowed, and every
        // Japanese line fails with "error R1: End of line in string".
        //
        // Consequence for editing: keep this file in CP932. Characters outside CP932 (an em dash,
        // for one) cannot be used here at all.
        //
        // Escaping the UTF-8 bytes as \0xNN was tried as well, to keep this file ASCII. ODFRC
        // COMPILES it, but the strings come out EMPTY at run time - \0 is taken as a NUL
        // terminator, so each string ends before its first character. Do not go back to it.
        //
        // And a warning about checking this: converter 0 means "read these bytes in the running
        // application's own encoding", so these strings can only be proof-read on a JAPANESE
        // InDesign. On an English one they come out as mojibake no matter what is done here -
        // measured 2026-07-28, do not read that as a bug in the table.
        0,

        {
        	// ----- Menu strings
                kKBSCompanyKey,					"Kohaku Plug-Ins",	// メニュー束ね名(表示。KESCM同様、会社名kKBSCompanyValueとは別)
                kKBSAboutMenuKey,					kKBSDisplayName "...",
                kKBSPluginsMenuKey,				kKBSDisplayName,

                kSDKDefAboutThisPlugInMenuKey,			kSDKDefAboutThisPlugInMenuValue_jaJP,

                // ----- Command strings
                kKBSSearchBookMenuKey,			"Search",
                kKBSFindMissingGlyphsMenuKey,	"Find Missing Glyphs",
                kKBSFindOversetMenuKey,			"Find Overset",
                kKBSBookScopeMenuKey,			"Book Scope",
                kKBSHidePrevChapterMenuKey,		"Hide Previous Chapter",
                kKBSReplaceCheckedMenuKey,		"Change Checked",
                kKBSCheckAllMenuKey,			"Check All",
                kKBSUncheckAllMenuKey,			"Uncheck All",
                kKBSSaveResultsMenuKey,			"Save Results...",
                kKBSHowToMenuKey,				"How to Use...",

                // ----- Window strings

                // ----- Panel/dialog strings
                kKBSPanelTitleKey,				kKBSDisplayName,
                kKBSStaticTextKey,				"Type what to find in Edit > Find/Change, then run Find in Document from this panel's menu.",

                // ----- Change Checked confirmation prompt
                // The panel, its menu and its status line stay English on purpose (they echo the
                // official Find/Change wording); this prompt is the one place where the user is
                // asked to authorise a rewrite of their book, so it speaks their language.
                kKBSConfirmReplaceOneKey,		"チェックした 1 件を置換しますか？",
                kKBSConfirmReplaceManyKey,		"チェックした ^1 件を置換しますか？",
                kKBSConfirmFindKey,				"検索文字列: ^1",
                kKBSConfirmChangeToKey,			"置換文字列: ^1",
                kKBSConfirmEmptyReplaceKey,		"（空欄：一致した箇所は削除されます）",
                kKBSConfirmFindFormatKey,		"検索形式",
                kKBSConfirmChangeFormatKey,		"置換形式",
                kKBSConfirmUnsavedOneKey,		"下のチェックを入れない場合、章は開かれたまま未保存の状態で残ります。取り消し（Undo）は Ctrl+Z 一回で戻せます。",
                kKBSConfirmUnsavedManyKey,		"下のチェックを入れない場合、^1 個の章が開かれたまま未保存の状態で残ります。取り消し（Undo）は Ctrl+Z 一回で、すべての章が元に戻ります。",

                // ----- Glyph tab confirmation (the dialog that draws the glyphs themselves)
                // 件数の行と末尾の未保存の行は上の CAlert 用と共用。新規はこの4つだけ。
                kKBSGlyphConfirmFindLabelKey,	"検索",
                kKBSGlyphConfirmChangeLabelKey,	"置換後",
                kKBSGlyphConfirmArrowKey,		"→",
                kKBSGlyphConfirmDontShowKey,	"次回から表示しない",

                // ----- "Save after replace" (the box, and what it does besides saving)
                kKBSSaveAfterReplaceKey,		"置換後保存",
                kKBSSaveAfterReplaceNoteKey,	"章は1つずつ開かれ、保存後にプラグインが閉じます。",
                kKBSSaveAfterReplaceWarningKey,	"「置換後保存」にチェックが入っています。" kLineSeparatorString kLineSeparatorString "ドキュメントは置換が済んだ順に保存され、プラグインが開いたものはその後、閉じられます。途中でキャンセルしても保存されたファイルは元に戻りません。" kLineSeparatorString kLineSeparatorString "続けますか？",

              // ----- Error strings

                // ----- Misc strings
                kKBSAboutBoxStringKey,			kKBSDisplayName "、version " kKBSVersion "\n\n"
                	"Adobe InDesign C++ SDK プラグイン。\n"
                	"InDesign 標準の検索/置換ダイアログで設定したクエリを使い、前面のドキュメント、またはアクティブなブック（.indb）の全章を一度に検索して、ヒットをツリーに一覧します。行をクリックするとその場所へジャンプし、チェックした行だけを置換できます。\n\n"
                	"本プラグインは KohakuNekotarou が、Anthropic の AI Claude（Claude Code）と協働して設計・実装しました。\n\n"
                	"ソース: " kKBSRepoURL,

        }

};

#endif // __ODFRC__
