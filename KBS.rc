#include "WinRezFlags.h"
#include "BuildNumber.h"
#include "KBSID.h"

1 VERSIONINFO
 FILEVERSION kMajorVersionNumberForResource, kMinorVersionNumberForResource, 0, kBuildNumber
 PRODUCTVERSION kMajorVersionNumberForResource, kMinorVersionNumberForResource, 0, 0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Kohaku Plug-Ins\0"
            VALUE "FileDescription", kKBSDisplayName " - Adobe InDesign SDK Plug-in\0"
            VALUE "FileVersion", kKBSVersion, "\0"
            VALUE "InternalName", kKBSPluginName, "\0"
            VALUE "LegalCopyright", kShortCopyRightStr, "\0"

            // The build's actual output name. The SDK's stock TargetName appends ".sdk"; KBS
            // overrides it in all four configurations (as KESCM does) so the file is plainly
            // KohakuBookSearch.pln - which is what kKBSPluginName means everywhere else too: the
            // .pln on disk, this InternalName, and the ID system. Verified on the built .pln.
            VALUE "OriginalFilename", kKBSPluginName ".pln\0"
            VALUE "ProductName", "Adobe InDesign\0"
            VALUE "ProductVersion", kVersionNumberStr, "\0"
            VALUE "Copyright", kVersionCopyRightStr, "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

