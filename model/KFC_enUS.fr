#ifdef __ODFRC__

// English string table is defined here

resource StringTable (kSDKDefStringsResourceID + index_enUS)
{
        k_enUS,									// Locale Id
        kEuropeanWinToMacEncodingConverter,		// Character encoding converter (irp) I made this WinToMac as we have a bias to generate on Win...
        {
                // The model half's strings: what the model writes itself. Every other string is the UI
                // half's (ui/KFCUI_enUS.fr). English in every UI language - one table (the author's call).
                // What Edit > Undo calls KFC's writes: a row's Replace (rows replaced together too), the
                // query run, and Change All in Book.
                kKFCReplaceStepKey,				"Replace",
                kKFCCreateOutlinesStepKey,		"Create Outlines",
                kKFCRestoreOriginalStepKey,		"Restore from Copy",
                // An object row's other Special Operations (KFCObjectSpecial) - InDesign's own English command names.
                kKFCFillFramePropStepKey,			"Fill Frame Proportionally",
                kKFCFitContentPropStepKey,			"Fit Content Proportionally",
                kKFCContentAwareFitStepKey,			"Content-Aware Fit",
                kKFCFrameToContentStepKey,			"Fit Frame to Content",
                kKFCFitContentToFrameStepKey,		"Fit Content to Frame",
                kKFCCenterContentStepKey,			"Center Content",
                kKFCBringFrontStepKey,				"Bring to Front",
                kKFCBringForwardStepKey,			"Bring Forward",
                kKFCSendBackwardStepKey,			"Send Backward",
                kKFCSendToBackStepKey,				"Send to Back",
                kKFCRotate90CWStepKey,				"Rotate 90 Degrees Clockwise",
                kKFCRotate90CCWStepKey,				"Rotate 90 Degrees Counter-clockwise",
                kKFCRotate180StepKey,				"Rotate 180 Degrees",
                kKFCFlipHorizontalStepKey,			"Flip Horizontal",
                kKFCFlipVerticalStepKey,			"Flip Vertical",
                kKFCRedefineScalingStepKey,			"Redefine Scaling as 100%",
                kKFCClearTransformationsStepKey,	"Clear Transformations",
                kKFCLockStepKey,					"Lock",
                kKFCUnlockStepKey,					"Unlock",
                kKFCHideStepKey,					"Hide",
                kKFCShowStepKey,					"Show",
                kKFCMoveToLayerStepKey,				"Move to Active Layer",
                kKFCClearStyleOverridesStepKey,		"Clear Object Style Overrides",
                kKFCDeleteStepKey,					"Delete",
                kKFCMoveStepKey,					"Move",
                kKFCScaleStepKey,					"Scale",
                kKFCRotateStepKey,					"Rotate",
                kKFCShearStepKey,					"Shear",
                kKFCRunScriptStepKey,				"Run Script",
                kKFCRunQueriesStepKey,			"Run Queries",
                kKFCChangeAllStepKey,			"Change All",
        }

};

#endif // __ODFRC__
