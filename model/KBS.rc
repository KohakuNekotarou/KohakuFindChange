// ***** READ THIS FILE AS CP1252, NOT AS THE MACHINE'S ANSI CODE PAGE. ***** (2026-08-11.)
//
// Without this line the copyright sign comes out as a halfwidth katakana on a Japanese Windows.
// The SDK writes the sign as a raw byte - CC21BuildNumber.h:107 is
//     #define kCC21ShortCopyRightStr "\xa9 1999-2025 Adobe. All rights reserved."
// - and 0xA9 is the copyright sign only in CP1252. rc.exe defaults to the SYSTEM's ANSI code page,
// which on this machine is CP932, where 0xA9 is U+FF69 (halfwidth katakana small U). So the .pln's
// LegalCopyright read "ｩ 1999-2025 Adobe..." while InDesign's own binaries, built on an English
// system, read "© 1999-2025 Adobe..." - measured on both, 2026-08-11.
//
// *It affects nothing but the string Windows shows under file Properties > Details. It is here
//  because this plug-in is submitted to Adobe Exchange, and because the SDK's own text was never
//  meant to say that.
// *KESCM's model half was fixed the same way on 2026-08-15 (audit B1). Its UI half (KCMUI.rc),
//  KESCL and KT still carry the same fault - they share this template.
#pragma code_page(1252)

#include "WinRezFlags.h"
#include "BuildNumber.h"
#include "KBSID.h"

1 VERSIONINFO
 FILEVERSION kMajorVersionNumberForResource, kMinorVersionNumberForResource, 0, kBuildNumber
 PRODUCTVERSION kMajorVersionNumberForResource, kMinorVersionNumberForResource, 0, 0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Kohaku Plug-Ins\0"
            VALUE "FileDescription", kKBSDisplayName " - Adobe InDesign SDK Plug-in\0"
            VALUE "FileVersion", kKBSVersion, "\0"
            VALUE "InternalName", kKBSPluginName, "\0"
            VALUE "LegalCopyright", kShortCopyRightStr, "\0"

            // The build's actual output name, which is deliberately NOT the InternalName above:
            // the file on disk follows the display name (KohakuFindChange.pln) while
            // kKBSPluginName stays at the original KohakuBookSearch so nothing in the ID system
            // moves. The SDK's stock TargetName would append ".sdk"; KBS overrides it in all four
            // configurations, as KESCM does. kKBSFileName must match the vcxproj TargetName.
            VALUE "OriginalFilename", kKBSFileName ".pln\0"
            VALUE "ProductName", "Adobe InDesign\0"
            VALUE "ProductVersion", kVersionNumberStr, "\0"
            VALUE "Copyright", kVersionCopyRightStr, "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

