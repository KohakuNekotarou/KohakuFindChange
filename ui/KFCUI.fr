/*
 * One row of either list, made by KFCQueryListWidgetMgr: one cell, its text written on every apply ("<kind>  <name>" on
 * the left, "<n>  <kind>  <name>" on the right). The cell is bound on both sides and the row maker's ApplyIndentToWidget
 * is empty (a flat list), so its left edge stands as written here (KCM's KCMBookTreeWidgetMgr, which measured the
 * framework's indent throwing it away). Convert ampersands kFalse: a query named "A&B" would otherwise read "AB".
 */
resource KFCQueryRowWidget(kKFCQueryRowRsrcID + index_enUS)
{
	__FILE__, __LINE__,
	kKFCQueryRowWidgetID, kPMRsrcID_None,	// WidgetId, RsrcId
	kBindLeft | kBindRight,					// Frame binding: follow the list's width
	Frame(0, 0, 260, kKFCQueryRowHeight),	// Frame - stretched to the list it is in
	kTrue, kTrue,							// Visible, Enabled
	"",										// Panel name
	{
		KFCQueryRowTextWidget				// the stock cell with the query's tooltip (kKFCQueryRowTextWidgetBoss)
		(
			kKFCQueryRowTextWidgetID,		// WidgetId
			kPMRsrcID_None,					// RsrcId
			kBindLeft | kBindRight,			// Frame binding
			Frame(6, 1, 254, kKFCQueryRowHeight - 2),	// Frame
			kTrue, kTrue,					// Visible, Enabled
			kAlignLeft,						// Alignment
			kEllipsizeEnd, kFalse,			// Ellipsize style, Convert ampersands
			"",								// Text Control Data
			0,								// WidgetId for associated control for shortcut focus
			kDialogWindowSystemScriptFontId, kDialogWindowSystemScriptFontId,
		),
	}
};

/*
 * The dialog: [ Saved Queries: + list | Add >, < Remove, Move Up, Move Down, Clear | Run Order: + list, and under it
 * Save Order... and Load Order... ], the "Runs on:" line, the dialog's message line, then Find, Run and Close at the right.
 * Modeless, with a minimize box (KFCQueryDialog.cpp). EVE lays it out; the root frame is NOT the
 * window's size - EVE sizes the window from the children's frames (KCM's book dialog measured this over eight builds).
 * Run is the dialog's default button (Enter) and Close its cancel button (Escape) - the framework's own OK and Cancel ids.
 */
resource KFCQueryDialogWidget (kKFCQueryDialogRsrcID + index_enUS)
{
	__FILE__, __LINE__,
	kKFCQueryDialogWidgetID,		// WidgetID
	kPMRsrcID_None,					// RsrcID
	kBindNone,						// Binding
	Frame(0, 0, 660, 420),			// Frame (l,t,r,b) - not the window's size; see above
	kTrue, kTrue,					// Visible, Enabled
	kKFCQueryDialogTitleKey,		// Dialog name
	{
		// ----- the two lists, the buttons between them -----
		EVEGenericPanelWidget
		(
			kInvalidWidgetID, kPMRsrcID_None,	// WidgetId, RsrcId
			kBindNone,							// Frame binding
			Frame(0, 0, 640, 340)				// Frame
			kTrue, kTrue,						// Visible, Enabled
			kEVEAlignLeft | kEVERegularSpaceAfter | kEVEArrangeChildrenInRow,
			{
				// --- left: the saved queries ---
				EVEGenericPanelWidget
				(
					kInvalidWidgetID, kPMRsrcID_None,
					kBindNone,
					Frame(0, 0, 260, 340)
					kTrue, kTrue,
					kEVEAlignLeft | kEVELargeSpaceAfter | kEVEArrangeChildrenInColumn,
					{
						EVEStaticTextWidget
						(
							kInvalidWidgetID,			// WidgetId
							kSysStaticTextPMRsrcId,		// RsrcId
							kBindNone,					// Frame binding
							Frame(0, 0, 260, 20)		// Frame
							kTrue, kTrue, kAlignLeft,	// Visible, Enabled, Alignment
							kDontEllipsize, kTrue,		// Ellipsize style, Convert ampersands
							kKFCQuerySavedLabelKey,		// "Saved Queries:"
							kInvalidWidgetID			// Associated control (none)
							kEVEVerySmallSpaceAfter,
						),
						// Single selection; kDrawBorder makes it read as a list box (basicselectabledialog's tree, KCM's).
						KFCQueryListWidget
						(
							kKFCQuerySavedListWidgetID, kPMRsrcID_None,	// WidgetId, RsrcId
							kBindNone,						// Frame binding (EVE places it)
							Frame(0, 0, 260, kKFCQueryRowHeight * 13)	// Frame - thirteen rows at a glance
							kTrue, kTrue,					// Visible, Enabled
							kTrue,							// EraseBeforeDraw
							kInterfacePaletteFill,			// InterfaceColor
							"",								// Panel name
							kHideRootNode | kDrawBorder,	// Options: the root is not a row
							kFalse,							// Use H scroll bar
							kTrue,							// Use V scroll bar
							kKFCQueryRowHeight,				// fVScrollButtonIncrement (one row)
							kKFCQueryRowHeight,				// fVThumbScrollIncrement
							kKFCQueryRowHeight,				// fHScrollButtonIncrement (unused, no H bar)
							kKFCQueryRowHeight,				// fHThumbScrollIncrement
							1,								// Items selectable: 1 = single selection
							kFalse,							// Allow children from multiple parents to be selected
							kFalse,							// Allow discontiguous selection
							{
							},
							kEVEAlignFill | kEVENoSpaceAfter,
						),
					}
				),

				// --- middle: the four buttons, under a blank line the height of the lists' headings ---
				EVEGenericPanelWidget
				(
					kInvalidWidgetID, kPMRsrcID_None,
					kBindNone,
					Frame(0, 0, 100, 340)
					kTrue, kTrue,
					kEVEAlignLeft | kEVELargeSpaceAfter | kEVEArrangeChildrenInColumn,
					{
						EVEStaticTextWidget
						(
							kInvalidWidgetID, kSysStaticTextPMRsrcId, kBindNone,
							Frame(0, 0, 100, 20)
							kTrue, kTrue, kAlignLeft,
							kDontEllipsize, kTrue,
							"",
							kInvalidWidgetID
							kEVEVerySmallSpaceAfter,
						),
						EVEButtonWidget
						(
							kKFCQueryAddButtonWidgetID,		// widget ID
							kSysButtonPMRsrcId,				// PMRsrc ID
							kBindNone,						// frame binding
							Frame(0, 0, 100, 20)			// a floor: EVE widens a button to its label
							kTrue,							// visible
							kTrue,							// enabled
							kKFCQueryAddKey,				// "Add >"
							kEVERegularSpaceAfter,
						),
						EVEButtonWidget
						(
							kKFCQueryRemoveButtonWidgetID, kSysButtonPMRsrcId, kBindNone,
							Frame(0, 0, 100, 20)
							kTrue, kTrue,
							kKFCQueryRemoveKey,				// "< Remove"
							kEVELargeSpaceAfter,
						),
						EVEButtonWidget
						(
							kKFCQueryUpButtonWidgetID, kSysButtonPMRsrcId, kBindNone,
							Frame(0, 0, 100, 20)
							kTrue, kTrue,
							kKFCQueryUpKey,					// "Move Up"
							kEVERegularSpaceAfter,
						),
						EVEButtonWidget
						(
							kKFCQueryDownButtonWidgetID, kSysButtonPMRsrcId, kBindNone,
							Frame(0, 0, 100, 20)
							kTrue, kTrue,
							kKFCQueryDownKey,				// "Move Down"
							kEVELargeSpaceAfter,
						),
						// Clear (the author's addition): the whole run order out - set apart from the four
						// that move one row.
						EVEButtonWidget
						(
							kKFCQueryClearButtonWidgetID, kSysButtonPMRsrcId, kBindNone,
							Frame(0, 0, 100, 20)
							kTrue, kTrue,
							kKFCQueryClearKey,				// "Clear"
							kEVENoSpaceAfter,
						),
					}
				),

				// --- right: the run order ---
				EVEGenericPanelWidget
				(
					kInvalidWidgetID, kPMRsrcID_None,
					kBindNone,
					Frame(0, 0, 260, 340)
					kTrue, kTrue,
					kEVEAlignLeft | kEVENoSpaceAfter | kEVEArrangeChildrenInColumn,
					{
						EVEStaticTextWidget
						(
							kInvalidWidgetID, kSysStaticTextPMRsrcId, kBindNone,
							Frame(0, 0, 260, 20)
							kTrue, kTrue, kAlignLeft,
							kDontEllipsize, kTrue,
							kKFCQueryOrderLabelKey,			// "Run Order:"
							kInvalidWidgetID
							kEVEVerySmallSpaceAfter,
						),
						KFCQueryListWidget
						(
							kKFCQueryOrderListWidgetID, kPMRsrcID_None,
							kBindNone,
							Frame(0, 0, 260, kKFCQueryRowHeight * 13)
							kTrue, kTrue,
							kTrue,
							kInterfacePaletteFill,
							"",
							kHideRootNode | kDrawBorder,
							kFalse,
							kTrue,
							kKFCQueryRowHeight,
							kKFCQueryRowHeight,
							kKFCQueryRowHeight,
							kKFCQueryRowHeight,
							1,
							kFalse,
							kFalse,
							{
							},
							kEVEAlignFill | kEVERegularSpaceAfter,
						),
						// Save Order... / Load Order... (the author's call, of two offered): the run order to a
						// file of its own and back (KFCQueryOrderFile.h) - under the list they act on, at its right.
						EVEGenericPanelWidget
						(
							kInvalidWidgetID, kPMRsrcID_None,
							kBindNone,
							Frame(0, 0, 260, 24)
							kTrue, kTrue,
							kEVEAlignRight | kEVENoSpaceAfter | kEVEArrangeChildrenInRow,
							{
								EVEButtonWidget
								(
									kKFCQuerySaveOrderButtonWidgetID, kSysButtonPMRsrcId, kBindNone,
									Frame(0, 0, 110, 20)		// a floor: EVE widens a button to its label
									kTrue, kTrue,
									kKFCQuerySaveOrderKey,		// "Save Order..."
									kEVERegularSpaceAfter,
								),
								EVEButtonWidget
								(
									kKFCQueryLoadOrderButtonWidgetID, kSysButtonPMRsrcId, kBindNone,
									Frame(0, 0, 110, 20)
									kTrue, kTrue,
									kKFCQueryLoadOrderKey,		// "Load Order..."
									kEVENoSpaceAfter,
								),
							}
						),
					}
				),
			}
		),

		// ----- what Run would run on, or why it cannot run (KFCQueryDialogController fills it) -----
		KFCQueryFixedTextWidget
		(
			kKFCQueryScopeTextWidgetID,	// WidgetId
			kSysStaticTextPMRsrcId,		// RsrcId
			kBindNone,					// Frame binding
			Frame(0, 0, 640, 20)		// Frame - the width it gets, not a floor (kKFCQueryFixedTextWidgetBoss)
			kTrue, kTrue, kAlignLeft,	// Visible, Enabled, Alignment
			kEllipsizeEnd, kFalse,		// Ellipsize style (a sentence is read from the front), Convert ampersands
			"",							// Text (the controller fills it)
			kInvalidWidgetID			// Associated control (none)
			kEVEAlignFill | kEVERegularSpaceAfter,
		),

		// ----- what the last Run said - the panel's message line, here too (the author's call): the dialog
		//       is modeless and stands with the KFC panel closed, and a run's result was then shown nowhere -----
		KFCQueryFixedTextWidget
		(
			kKFCQueryMessageTextWidgetID,	// WidgetId
			kSysStaticTextPMRsrcId,		// RsrcId
			kBindNone,					// Frame binding
			Frame(0, 0, 640, 20)		// Frame - the width it gets, not a floor (kKFCQueryFixedTextWidgetBoss)
			kTrue, kTrue, kAlignLeft,	// Visible, Enabled, Alignment
			kEllipsizeEnd, kFalse,		// Ellipsize style (a sentence is read from the front), Convert ampersands
			"",							// Text (the controller fills it; empty at every open)
			kInvalidWidgetID			// Associated control (none)
			kEVEAlignFill | kEVERegularSpaceAfter,
		),

		// ----- Find, Run and Close, at the right -----
		EVEGenericPanelWidget
		(
			kInvalidWidgetID, kPMRsrcID_None,
			kBindNone,
			Frame(0, 0, 300, 24)
			kTrue, kTrue,
			kEVEAlignRight | kEVENoSpaceAfter | kEVEArrangeChildrenInRow,
			{
				// Find (docs/superpowers/specs/2026-10-14-kfc-stacked-results-design.md section 2-1): the run order's next
				// query searched, as a new tier on the panel. Not the default button - Enter stays Run's.
				EVEButtonWidget
				(
					kKFCQueryFindButtonWidgetID,	// WidgetID
					kSysButtonPMRsrcId,		// RsrcID
					kBindNone,				// Binding
					Frame(0, 0, 90, 20)		// Frame (l,t,r,b)
					kTrue, kTrue,			// Visible, Enabled
					kKFCQueryFindKey,		// "Find"
					kEVERegularSpaceAfter,
				),
				EVEDefaultButtonWidget
				(
					kOKButtonWidgetID,		// WidgetID - the dialog's default button: Enter
					kSysButtonPMRsrcId,		// RsrcID
					kBindNone,				// Binding
					Frame(0, 0, 90, 20)		// Frame (l,t,r,b)
					kTrue, kTrue,			// Visible, Enabled
					kKFCQueryRunKey,		// "Run"
					kEVERegularSpaceAfter,
				),
				EVECancelButtonWidget
				(
					kCancelButton_WidgetID,	// WidgetID - the dialog's cancel button: Escape
					kSysButtonPMRsrcId,		// RsrcID
					kBindNone,				// Binding
					Frame(0, 0, 90, 20)		// Frame (l,t,r,b)
					kTrue, kTrue,			// Visible, Enabled
					kKFCQueryCloseKey,		// "Close"
					kFalse,					// NOT turned into "Reset" by Alt: the order is kept as it is changed, so there is nothing to reset
					kEVENoSpaceAfter,
				),
			}
		),
	},

	kEVEArrangeChildrenInColumn | kEVERegularMargin,
};

/*
 * THE VALUE DIALOGS' VIEWS (KFCSpecialDialogs.cpp - the design's section 3:
 * docs/superpowers/specs/2026-10-23-kfc-native-value-dialogs-design.md): InDesign's own fields, laid out as InDesign's
 * Move, Scale, Rotate and Shear - the fields on the left, OK and Cancel stacked on the right. Each field's range is its
 * own check on OK, refused in InDesign's words: a distance in points (a value beyond the pasteboard is refused by the
 * model - KFCObjectSpecial), an angle in degrees (Shear's between -90 and 90), a percentage. Move's and Scale's fields
 * tell of every key stroke: the observer follows which of Move's pairs was typed, and copies a Scale value to the
 * other while the chain is linked.
 */
resource KFCValueDialogWidget (kKFCMoveDialogRsrcID + index_enUS)
{
	__FILE__, __LINE__,
	kKFCValueDialogWidgetID,		// WidgetID
	kPMRsrcID_None,					// RsrcID
	kBindNone,						// Binding
	Frame(0, 0, 300, 160)			// Frame (l,t,r,b) - not the window's size: EVE sizes it from the children
	kTrue, kTrue,					// Visible, Enabled
	kKFCValueMoveDialogKey,		// Dialog name - "... - Move"
	{
		EVEGroupPanelWidget
		(
			kInvalidWidgetID, kPMRsrcID_None,	// WidgetId, RsrcId
			kBindNone,							// Frame binding
			Frame(0, 0, 0, 0)					// Frame (EVE sizes it)
			kTrue, kTrue,						// Visible, Enabled
			kKFCValuePositionLabelWidgetID,		// Header widget - the group's title
			kEVEAlignLeft | kEVELargeSpaceAfter | kEVEArrangeChildrenInColumn | kEVERegularMargin,
			{
				EVEStaticTextWidget
				(
					kKFCValuePositionLabelWidgetID,	// WidgetId - the header
					kSysStaticTextPMRsrcId,		// RsrcId
					kBindNone,					// Frame binding
					Frame(0, 0, 0, 0)			// Frame
					kTrue, kTrue, kAlignLeft,	// Visible, Enabled, Alignment
					kDontEllipsize, kTrue,		// Ellipsize style, Convert ampersands
					kKFCValuePositionKey,		// "Position"
					kInvalidWidgetID			// Associated control (none)
					kEVERegularSpaceAfter,
				),
				EVEGenericPanelWidget
				(
					kInvalidWidgetID, kPMRsrcID_None,	// WidgetId, RsrcId
					kBindNone,							// Frame binding
					Frame(0, 0, 0, 0)					// Frame (EVE sizes it)
					kTrue, kTrue,						// Visible, Enabled
					kEVEAlignLeft | kEVERegularSpaceAfter | kEVEArrangeChildrenInRow,
					{
						EVEStaticTextWidget
						(
							kInvalidWidgetID,			// WidgetId
							kSysStaticTextPMRsrcId,		// RsrcId
							kBindNone,					// Frame binding
							Frame(0, 0, 72, 0)			// Frame - the column's one width
							kTrue, kTrue, kAlignRight,	// Visible, Enabled, Alignment
							kDontEllipsize, kTrue,		// Ellipsize style, Convert ampersands
							kKFCValueHorizontalKey,		// "Horizontal:"
							kKFCValueXWidgetID			// Associated control - the field
							kEVESmallSpaceAfter,
						),
						EVEXMeasureEditBoxWidget
						(
							kKFCValueXWidgetID,			// WidgetId
							kSysEditBoxPMRsrcId,		// RsrcId
							kBindNone,					// Frame binding
							Frame(0, 0, kKFCValueFieldWidth, 0)	// Frame - a height of 0: the field's own
							kTrue, kTrue,				// Visible, Enabled
							kInvalidWidgetID,			// Nudge control (none, as in InDesign's own)
							1.0, 10.0,					// Small / large nudge (the arrow keys, with Shift)
							0,							// Max chars (no limit)
							kFalse,						// Read only
							kTrue,						// Notify every key stroke - which pair was typed
							kTrue,						// Range checking
							kFalse,						// Blank entry allowed
							100000.0, -100000.0,		// Upper / lower limits
							"0",						// Initial text (the controller fills it)
							kEVENoSpaceAfter,
						),
					}
				),
				EVEGenericPanelWidget
				(
					kInvalidWidgetID, kPMRsrcID_None,	// WidgetId, RsrcId
					kBindNone,							// Frame binding
					Frame(0, 0, 0, 0)					// Frame (EVE sizes it)
					kTrue, kTrue,						// Visible, Enabled
					kEVEAlignLeft | kEVERegularSpaceAfter | kEVEArrangeChildrenInRow,
					{
						EVEStaticTextWidget
						(
							kInvalidWidgetID,			// WidgetId
							kSysStaticTextPMRsrcId,		// RsrcId
							kBindNone,					// Frame binding
							Frame(0, 0, 72, 0)			// Frame - the column's one width
							kTrue, kTrue, kAlignRight,	// Visible, Enabled, Alignment
							kDontEllipsize, kTrue,		// Ellipsize style, Convert ampersands
							kKFCValueVerticalKey,		// "Vertical:"
							kKFCValueYWidgetID			// Associated control - the field
							kEVESmallSpaceAfter,
						),
						EVEYMeasureEditBoxWidget
						(
							kKFCValueYWidgetID,			// WidgetId
							kSysEditBoxPMRsrcId,		// RsrcId
							kBindNone,					// Frame binding
							Frame(0, 0, kKFCValueFieldWidth, 0)	// Frame - a height of 0: the field's own
							kTrue, kTrue,				// Visible, Enabled
							kInvalidWidgetID,			// Nudge control (none, as in InDesign's own)
							1.0, 10.0,					// Small / large nudge (the arrow keys, with Shift)
							0,							// Max chars (no limit)
							kFalse,						// Read only
							kTrue,						// Notify every key stroke - which pair was typed
							kTrue,						// Range checking
							kFalse,						// Blank entry allowed
							100000.0, -100000.0,		// Upper / lower limits
							"0",						// Initial text (the controller fills it)
							kEVENoSpaceAfter,
						),
					}
				),
				EVESeparatorWidget
				(
					kInvalidWidgetID, kPMRsrcID_None,	// WidgetId, RsrcId
					kBindNone,							// Frame binding
					Frame(0, 0, 159, 1)					// Frame - the rows' width, one line high (the product's)
					kTrue, kTrue,						// Visible, Enabled
					kEVEAlignLeft | kEVERegularSpaceAfter,
				),
				EVEGenericPanelWidget
