#include "ObjectModelTypes.fh"
#include "ShuksanID.h"
#include "ActionID.h"
#include "CommandID.h"			// IID_ICOMMANDINTERCEPTOR (the Book panel's command watch), IID_IBOOLDATA (eye trace)
#include "WorkspaceID.h"
#include "WidgetID.h"
#include "BuildNumber.h"
#include "PlugInModel_UIAttributes.h"
#include "PanelList.fh"
#include "InterfaceColorDefines.h"
#include "IControlViewDefs.h"
#include "SysControlIDs.h"
#include "Widgets.fh"	// for PalettePanelWidget or DialogBoss
#include "EveInfo.fh"	// EVE widget types and layout flags - the query dialog, laid out by EVE as KCM's book dialog
#include "DialogLayoutID.h"	// IID_IEVEINFO / kFixedSizeEVEInfoImpl - the query dialog's "Runs on:" line
#include "TreeViewDefs.h"	// kHideRootNode etc. - the result tree list
#include "IconRsrcDefs.h"	// kTreeBranchCollapsed/ExpandedRsrcID - the tree's expander arrows; kEyeballIcon - the row eye
#include "IconStyleDefs.h"	// kIconNoCentering / kIconRaisedLook and the icon buttons' looks (pictures, row eye)
#include "TipsID.h"			// IID_ITIP - the tooltips on the panel's illustration and on the query dialog's rows
#include "XMLParserID.h"	// IID_ISAXCONTENTHANDLER - the query dialog's reading of a saved query's file
#include "DragDropID.h"		// IID_IDRAGDROPSOURCE / IID_IDRAGDROPTARGET / IID_IDATAEXCHANGEHANDLER - the row eye's trace
#include "IDList.fh"		// the Kohaku tab's offer to Find/Change (IDList / IDListPair - KFCKohakuTab.cpp)
#include "IDListPair.fh"
#include "FindChangeID.h"	// kFindChangeMiniTabbedDialogService - the dialog the QR Code tab is offered to

// Project includes:
#include "KFCUIID.h"


#ifdef __ODFRC__

/*
 * Plugin version definition.
 */
resource PluginVersion (kSDKDefPluginVersionResourceID)
{
	kTargetVersion,
	kKFCUIPluginID,
	kSDKDefPlugInMajorVersionNumber, kSDKDefPlugInMinorVersionNumber,
	kSDKDefHostMajorVersionNumber, kSDKDefHostMinorVersionNumber,
	kKFCUICurrentMajorFormatNumber, kKFCUICurrentMinorFormatNumber,
	{ kInDesignProduct },
	{ kWildFS },
	kUIPlugIn,
	kKFCVersion			// one version for both halves (KFCBoundaryID.h)
};

/*
 * The ExtraPluginInfo resource adds extra information to the Missing Plug-in dialog.
 */
resource ExtraPluginInfo(1)
{
	kKFCCompanyValue,			// Company name (KFCBoundaryID.h - the same publisher for both halves)
	kKFCUIMissingPluginURLValue,	// URL
	kKFCUIMissingPluginAlertValue,	// Missing plug-in alert text
};

/*
 * This half does not stand on its own: the panel's rows, its commands and its status all come from
 * the model half through the three session interfaces (IKFCResults / IKFCRuns / IKFCChapters). Guide
 * gs-03 - a UI plug-in makes no sense without its model half - so say so here. What InDesign then does with
 * the declaration (whether it enforces the load order, how it reports a missing half) is written neither in
 * the guide nor in the resource type (objectmodeltypes.fh), and has not been measured here: the declaration
 * is kept because it states the dependency. The SDK's shape (transparencyeffectui/TranFxUI.fr), and KCM's.
 * The dependency is ONE-WAY: the model half declares none, and has to keep working on its own.
 */
resource PluginDependency(kSDKDefPluginDependencyResourceID)
{
	kWildFS
	{
		kKFCPluginID,			// the model half's PluginID (KFCBoundaryID.h)
		kKFCPluginName,			// "KohakuBookSearch" (KFCBoundaryID.h)
		kSDKDefPlugInMajorVersionNumber,
		kSDKDefPlugInMinorVersionNumber,
	}
}

/*
 * Boss class definitions.
 */
resource ClassDescriptionTable(kSDKDefClassDescriptionTableResourceID)
{{{


	/*
	 * The plug-in's menu commands. It inherits kBaseActionComponentBoss, which is what EVERY action
	 * component in the product does - layerpanel/LayerPanelClass.fr:403, spellpanel:339,
	 * linksui:170 and :178, buttonui:103 - and what the samples do (basicpanel/BscPnl.fr:92).
	 *
	 * What the parent brings, read off the running application's object model (debug-boss-registry/
	 * IObjectModel_RomanFS.txt:492-493, kAboutMenuComponentBoss): IID_IPMPERSIST (kPMPersistImpl)
	 * AND IID_NEVERWRITESTODOCUMENT (kNeverWritesToDocumentImpl).
	 *
	 * Not kInvalidClass with IID_IPMPERSIST written out by hand - the shape candlechartui/CdlChtUI.fr:93
	 * has. That shape runs, but it is missing the second interface, and the product's form gives both
	 * without spelling either out.
	 *
	 * @ingroup KFC
	 */
	Class
	{
		kKFCActionComponentBoss,
		kBaseActionComponentBoss,
		{
			// Handle the actions from the menu. The rest comes from the parent boss above.
			IID_IACTIONCOMPONENT, kKFCActionComponentImpl,
		}
	},

	/*
	 * The panel: the API's palette panel boss with interfaces of ours on it - the flyout menu's data (the
	 * API's implementation), the panel's observer, its view and its roll-over (each line below says what).
	 *
	 * @ingroup KFC
	 */
	Class
	{
		kKFCPanelWidgetBoss,
		kPalettePanelWidgetBoss,
		{
			/*
			 * The flyout menu's data (IPanelMenuData): the name of the menu the panel pops - kKFCInternalPopupMenuNameKey,
			 * the last field of the panel's resource below. The API's implementation (CPanelMenuData).
			 */
			IID_IPANELMENUDATA, kCPanelMenuDataImpl,
			/*
			 * The panel's observer (KFCPanelTitle.cpp): what has to be written on each time the panel
			 * is shown, because the panel is rebuilt every time - the tab's name, the layout for the
			 * UI language, the picture, the message - and, while it is up, the picture's click and
			 * what the tab's name follows (the Find/Change settings and the selection: it is an
			 * ActiveSelectionObserver).
			 */
			IID_IOBSERVER, kKFCPanelObserverImpl,
			/*
			 * The panel's view replaced: PalettePanelView plus a floor under how small the panel can
			 * be dragged, and a height rounded down to whole result rows, both through
			 * ConstrainDimensions. See KFCPanelView.cpp - the same shape KESCL uses, which took it
			 * from customconditionaltextui.
			 */
			IID_ICONTROLVIEW, kKFCPanelViewImpl,
			/*
			 * Roll-over (ported from KCM): while the "Translucent Panel" toggle is ON, the panel goes
			 * back to solid with the pointer on it. Verified over the whole panel area in KCM.
			 * Note that IMouseRollOver has no usage example anywhere in the SDK; besides this line
			 * it needs CREATE_PMINTERFACE *and* an entry in KFCUIFactoryList.h - a missing factory
			 * entry fails completely silently. Implementation: KFCPanelAlpha.cpp.
			 */
			IID_IMOUSEROLLOVER, kKFCPanelRollOverImpl,
		}
	},

	/*
	 * The panel's illustration: the system rollover icon button plus a tooltip of our own, so
	 * hovering the picture says where clicking it goes. Nothing else is added - the click itself is
	 * heard by the panel's observer (KFCPanelTitle.cpp), which is already there.
	 *
	 * Same shape as kLinksUIButtonBoss in open/components/linksui, and as KCM's
	 * kKCMIconWidgetBoss - which is where this panel's layout comes from.
	 */
	Class
	{
		kKFCIconWidgetBoss,
		kRollOverIconButtonBoss,
		{
			IID_ITIP, kKFCIconTipImpl,
		}
	},

	/*
	 * Result tree list: the tree-view widget with our hierarchy adapter, row widget manager, selection
	 * controller and key handler (each line below says what it adds). A row's click is the row's own
	 * handler (kKFCResultNodeWidgetBoss, below).
	 */
	Class
	{
		kKFCResultListWidgetBoss,
		kTreeViewWidgetBoss,
		{
			IID_ITREEVIEWHIERARCHYADAPTER, kKFCResultListAdapterImpl,
			IID_ITREEVIEWWIDGETMGR, kKFCResultListWidgetMgrImpl,
			/* The selection rules: hit rows of one kind selected together, of any story, spread or
			   document - the stock controller made a multiple-selection one, with KFC's rule on top
			   (KFCResultTreeController.cpp). Persistent, as the stock one it replaces is (CREATE_PERSIST_PMINTERFACE - a
			   non-persistent implementation over an inherited persistent one fails as the resource is read). */
			IID_ITREEVIEWCONTROLLER, kKFCResultTreeControllerImpl,
			/* The list's own keys over the stock handler, listed at the head of KFCResultTreeEH.cpp - the arrows among
			   them open a closed row they land on and run its action (a book search's chapters come up closed, and the
			   stock keys walk visible rows only).
			   NOTE: this line alone does not create the handler; it is made on its first QueryInterface -
			   the framework's as an event reaches the list, or KFC's own as it hands the list the keyboard
			   (KFCResultTree::TakeKeyboard). */
			IID_IEVENTHANDLER, kKFCResultTreeEHImpl,
		}
	},

	/*
	 * The hit line's multi-colour text cell: a generic panel widget whose IControlView
	 * is our self-drawing view (KFCColorTextView), plus the per-row draw data it paints.
	 */
	Class
	{
		kKFCColorTextWidgetBoss,
		kGenericPanelWidgetBoss,
		{
			IID_ICONTROLVIEW, kKFCColorTextViewImpl,
			IID_IKFCROWDATA, kKFCRowDataImpl,
		}
	},

	/*
	 * A HIT ROW'S EYE (docs/superpowers/specs/2026-10-17-kfc-row-eye-keep-design.md - the row eye, D-13): an icon button
	 * that draws InDesign's own eyeball while the row is kept and nothing while it is not (KFCResultListWidgetMgr sets
	 * which, row by row), with a click handler of its own (KFCResultEyeEH) - the SDK's way of a tree row's icon
	 * (customconditionaltextui: kIconSuiteWidgetBoss and IID_IEVENTHANDLER).
	 */
	Class
	{
		kKFCResultEyeWidgetBoss,
		kIconSuiteWidgetBoss,
		{
			IID_IEVENTHANDLER, kKFCResultEyeEHImpl,
			/* ...and its TRACE (the author: "like the Layers panel"): the eye is a drag's source and every
			   eye its target, as the Layers panel's kLayerPanelEyeballBoss is (LayerPanelClass.fr) - KFCResultEyeDrag.cpp.
			   kIconSuiteWidgetBoss carries neither (KIDMCP's inspect_ui boss), so nothing inherited is replaced. */
			IID_IDRAGDROPSOURCE, kKFCResultEyeDragSourceImpl,
			IID_IDRAGDROPTARGET, kKFCResultEyeDropTargetImpl,
		}
	},

	/*
	 * THE TRACE'S DATA EXCHANGE HANDLER (KFCResultEyeDrag.cpp): the drag's flavor, and the first eye's state - the Layers
	 * panel's kLayerEyeDEHandlerBoss (LayerPanelClass.fr), whose IUIDData held a layer; a row is held by the trace itself.
	 * Found by the data exchange controller through its IDataExchangeHandler - the Layers panel's has no service either.
	 */
	Class
	{
		kKFCResultEyeDEHandlerBoss,
		kInvalidClass,
		{
			IID_IDATAEXCHANGEHANDLER, kKFCResultEyeDEHandlerImpl,
			IID_IBOOLDATA, kBoolDataImpl,			// the first eye's state: kept or not
			IID_IPMPERSIST, kPMPersistImpl,
		}
	},

	/*
	 * The panel's MESSAGE AREA, built the same way as the cell above and for the same
	 * reason: a selected GREP row's Preview Text shows here what its Replace would write - the written
	 * characters at full colour between the row's context faded - which one colour cannot draw (KFCStatusTextView.cpp).
	 * Brought over from KCM, whose kKCMStatusTextWidgetBoss replaced the same stock widget.
	 * ! No ITextControlData of our own: the one kGenericPanelWidgetBoss carries is persistent, and the
	 *   data implementation writes the message into it for a reader that walks the widgets.
	 */
	Class
	{
		kKFCStatusTextWidgetBoss,
		kGenericPanelWidgetBoss,
		{
			IID_ICONTROLVIEW, kKFCStatusTextViewImpl,
			IID_IKFCSTATUSTEXTDATA, kKFCStatusTextDataImpl,
		}
	},

	/*
	 * Result tree row: the node boss carries the click handler - a hit row jumps to its match, a branch row
	 * brings its document or book forward - and the right-click menus.
	 * Shared by the branch and hit row resources; the handler tells them apart by the node.
	 * And its observer: a branch row CLOSED takes the rows selected under it out of the selection (the tree manager
	 * tells the row on its own subject - kTreeNodeCollapsedMsg; KFCResultNodeObserver.cpp). The node observer is the
	 * paneltreeview sample's shape (kPnlTrvNodeWidgetBoss, PnlTrv.fr), on the same parent boss.
	 */
	Class
	{
		kKFCResultNodeWidgetBoss,
		kTreeNodeWidgetBoss,
		{
			IID_IEVENTHANDLER, kKFCResultNodeEHImpl,
			IID_IOBSERVER, kKFCResultNodeObserverImpl,
		}
	},

	/*
	 * Marker-expiry idle task boss: a one-shot idle task, armed each time the marker is
	 * shown, that takes it back off the screen a second later. IID_IIDLETASK comes from ShuksanID.h.
	 */
	Class
	{
		kKFCMarkerExpiryIdleTaskBoss,
		kInvalidClass,
		{
			IID_IIDLETASK, kKFCMarkerExpiryIdleTaskImpl,
		}
	},

	/*
	 * The UI half's startup/shutdown service boss (KFCUIStartupShutdown.cpp): the saved settings, the
	 * windows the panel follows, the marker's countdown and the ear on the model half. A boss of its own
	 * because a startup/shutdown service is declared per boss. UI code, so this half's; lazy here.
	 */
	Class
	{
		kKFCUIStartupShutdownBoss,
		kInvalidClass,
		{
			IID_ISTARTUPSHUTDOWN, kKFCUIStartupShutdownImpl,
			IID_IK2SERVICEPROVIDER, kLazyStartupShutdownProviderImpl,
		}
	},

	/*
	 * The result list's Return, taken before the widget layer gets it (KFCResultTreeEH.cpp). A Return the
	 * list handled was followed by InDesign's own DVEventHandler::RestoreFocusOnDocument, which handed the keyboard to
	 * the document - and the down arrow then moved a page item. This handler is pushed on the application's
	 * IEventDispatcher (whose stack sees an event before anything below it) while the list holds the keyboard, and
	 * takes the list's Return there - on a selected hit row it writes, on any other row it does nothing. A boss of its
	 * own, created once and released at shutdown, so its life is not a widget's.
	 */
	Class
	{
		kKFCReturnFilterBoss,
		kInvalidClass,
		{
			IID_IEVENTHANDLER, kKFCReturnFilterEHImpl,
		}
	},

	/*
	 * The UI half's ear on the model half: the observer that draws what KFCModelNotify.h sends on the
	 * session's subject. Attached by the startup (KFCModelObserver.cpp); this line only puts our IID, and
	 * so the implementation, onto the session. An AddIn that points at UI code, in this half's resource.
	 */
	AddIn
	{
		kSessionBoss,
		kInvalidClass,
		{
			IID_IKFCMODELOBSERVER, kKFCModelObserverImpl,
		}
	},

	/*
	 * What the model half asks the UI half for (IKFCUIServices.h): the progress bar, the windows, the
	 * Book panel's front tab and the chapters selected in it. A UI implementation on a model boss, which the guide allows
	 * only through an AddIn in the UI plug-in's resource (vol1-07, Object-Model Rule 2) - and which a
	 * background thread does not see, where the model does without. With them, this half's boundary stamp,
	 * which the model half checks before it asks them for anything (model/IKFCBoundary.h).
	 */
	AddIn
	{
		kSessionBoss,
		kInvalidClass,
		{
			IID_IKFCUISERVICES, kKFCUIServicesImpl,
			IID_IKFCUIBOUNDARY, kKFCUIBoundaryImpl,
		}
	},

	/*
	 * Panel visibility observer (ported from KCM). Subscribes to the panel
	 * manager's subject and waits for kPaletteVisibilityChangedMessage, which fires whenever a panel
	 * is opened, closed, restored from an icon or drawer-expanded. The "Translucent Panel" toggle
	 * puts its alpha on the panel's CURRENT top-level window (an OWL.Dock), and that window is thrown
	 * away and recreated by those very actions - so without this the translucency would be silently
	 * lost. The attach itself is in KFCPanelAlpha.cpp; this line only puts our IID, and so the
	 * observer implementation, onto the boss.
	 *
	 * It goes on kActiveContextBoss rather than the kSessionBoss above because that is the proven
	 * arrangement: KCM carries its observers there, this one among them. (A free-floating
	 * observer boss did NOT receive these notifications in practice - see KCMUI.fr.)
	 */
	AddIn
	{
		kActiveContextBoss,
		kInvalidClass,
		{
			IID_IKFCPANELVISIBILITYOBSERVER, kKFCPanelVisibilityObserverImpl,
		}
	},

	/*
	 * "Link the Application Bar's Search Field to This Panel": the observer that makes the
	 * application bar's search field show what Edit > Find/Change holds. On kActiveContextBoss for the same
	 * reason as the one above; attached to the Find/Change settings while the toggle is ON
	 * (KFCAppBarSearchEnter.cpp). An AddIn that points at UI code, in this half's resource.
	 */
	AddIn
	{
		kActiveContextBoss,
		kInvalidClass,
		{
			IID_IKFCAPPBARMIRROROBSERVER, kKFCAppBarMirrorObserverImpl,
		}
	},

	/*
	 * "Remember Book Panel Placement": the observer that puts InDesign's own Book panel
	 * back where it was when it appears (kPaletteVisibilityChangedMessage, on the panel manager's
	 * subject - the subject the observer above listens to). Measuring it as it closes is the command
	 * interceptor's job further down: a closing book says nothing on this subject (measured).
	 * On kActiveContextBoss for the same reason as the one above. The attach
	 * itself is in KFCBookPanelPlacement.cpp; this line only puts our IID onto the boss.
	 * An AddIn that points at UI code, in this half's resource.
	 */
	AddIn
	{
		kActiveContextBoss,
		kInvalidClass,
		{
			IID_IKFCBOOKPANELOBSERVER, kKFCBookPanelObserverImpl,
		}
	},

	/*
	 * ...and the service that tells it when to start and stop - and the Translucent Panel observer when to stop:
	 * kPaletteMgrService, which calls PaletteMgrStarted once the palettes are laid out and PaletteMgrAboutToShutdown
	 * just before they close (IPaletteMgrService.h). InDesign's own Book panel is the one product user of this
	 * service (kBookPanelStartupShutdownBoss). No stock provider exists for it, hence ours.
	 */
	Class
	{
		kKFCBookPanelServiceBoss,
		kInvalidClass,
		{
			IID_IK2SERVICEPROVIDER, kKFCBookPanelServiceProviderImpl,
			IID_IPALETTEMGRSERVICE, kKFCBookPanelPaletteMgrServiceImpl,
		}
	},

	/*
	 * InDesign's hidden-spread alert answered OK inside a walk of ours (KFCAlertAnswer.cpp - the spec map's OBJ-23):
	 * the alert handler, registered under kAlertHandlerService - "If alerts are set to not show, rather than showing an
	 * alert we ask the service registry for a list of IAlertHandlers" (IAlertHandler.h). No parent class: a service is
	 * found by the ServiceID its provider states, so there is nothing to inherit.
	 *
	 */
	Class
	{
		kKFCAlertAnswerBoss,
		kInvalidClass,
		{
			IID_IALERTHANDLER,		kKFCAlertAnswerImpl,
			IID_IK2SERVICEPROVIDER,	kKFCAlertAnswerServiceImpl,
		}
	},

	/*
	 * ...and the command interceptor that catches a book as it is about to close. Measured:
	 * closing a book - by script and by the Book panel's own "Close Book" alike -
	 * destroys its panel without one notification on the panel manager's subject, so the observer
	 * above never hears of it. Created by name and handed to ICommandProcessor::InstallInterceptor
	 * (the shape KIDMCP's command watcher uses); nothing looks it up, so it inherits nothing.
	 * IID_ICOMMANDINTERCEPTOR is CommandID.h's, included above.
	 */
	Class
	{
		kKFCBookPanelCmdWatchBoss,
		kInvalidClass,
		{
			IID_ICOMMANDINTERCEPTOR, kKFCBookPanelCmdWatchImpl,
		}
	},

	/*
	 * Run Saved Queries... (docs/superpowers/specs/_done/2026-10-07-kfc-query-dialog-and-selected-documents-design.md):
	 * the query dialog. Its controller fills it (KFCQueryDialogOpen again on every open - the run order it shows is the
	 * session's, KFCQueryOrder) and keeps where it stood as it closed; its observer hears every button
	 * but Close, and the two lists' selections (KFCQueryDialog.cpp's AutoAttach names them). That observer REPLACES the
	 * stock CDialogObserver that kDialogBoss carries and calls it, so Cancel (Close) and the close box keep working -
	 * basicdialog's BscDlgDialogObserver is the same shape - but takes Run (OK) itself. The scope observer beside it
	 * follows what the Runs on: line is made of while the dialog is open (KFCQueryScopeObserver.cpp - its own IID:
	 * IID_IOBSERVER is the dialog's observer's), attached and detached by that observer.
	 */
	Class
	{
		kKFCQueryDialogBoss,
		kDialogBoss,
		{
			IID_IDIALOGCONTROLLER, kKFCQueryDialogControllerImpl,
			IID_IOBSERVER, kKFCQueryDialogObserverImpl,
			IID_IKFCQUERYSCOPEOBSERVER, kKFCQueryScopeObserverImpl,
		}
	},

	/*
	 * The value dialogs - Move..., Scale..., Rotate..., Shear... (an object row's Special Operations > Transform) and
	 * Narrow Down > Pages... (docs/superpowers/specs/2026-10-23-kfc-native-value-dialogs-design.md): one boss for the
	 * five, each its own view below. The controller fills the dialog from what was answered last, checks it on OK
	 * and keeps it; the observer stands in for the stock CDialogObserver kDialogBoss carries and calls it, so OK,
	 * Cancel and the close box keep working (KFCSpecialDialogs.cpp).
	 */
	Class
	{
		kKFCValueDialogBoss,
		kDialogBoss,
		{
			IID_IDIALOGCONTROLLER, kKFCValueDialogControllerImpl,
			IID_IOBSERVER, kKFCValueDialogObserverImpl,
		}
	},

	/*
	 * The Kohaku+ tab's queries in Find/Change's own Query menu (KFCKohakuQueryMenu.cpp): the watch that takes InDesign's load of a query of KFC's, and the filter - pushed on the application's event dispatcher while the tab
	 * is shown - that takes the press of its Save Query.
	 */
	Class
	{
		kKFCKohakuQueryWatchBoss,
		kInvalidClass,
		{
			IID_ICOMMANDINTERCEPTOR, kKFCKohakuQueryWatchImpl,
		}
	},

	Class
	{
		kKFCKohakuSaveFilterBoss,
		kInvalidClass,
		{
			IID_IEVENTHANDLER, kKFCKohakuSaveFilterEHImpl,
		}
	},

	/*
	 * The query dialog's two lists - the saved queries and the run order. A flat list says what its rows are and how they
	 * are drawn, and kTreeViewWidgetBoss brings the rest (selection, scrolling, keys) - KCM's book dialog list is the same.
	 * One adapter and one row maker serve both: each asks its own widget id which list it is.
	 */
	Class
	{
		kKFCQueryListWidgetBoss,
		kTreeViewWidgetBoss,
		{
			IID_ITREEVIEWHIERARCHYADAPTER, kKFCQueryListAdapterImpl,
			IID_ITREEVIEWWIDGETMGR, kKFCQueryListWidgetMgrImpl,
		}
	},

	/*
	 * A row of those two lists: the stock tree row with one interface replaced - its event handler, so a saved query
	 * DOUBLE-CLICKED goes into Find/Change (KFCQueryRowEH.cpp; the author's call). The result list's rows are made the
	 * same way (kKFCResultNodeWidgetBoss above), and so are KCM's book dialog rows.
	 */
	Class
	{
		kKFCQueryRowWidgetBoss,
		kTreeNodeWidgetBoss,
		{
			IID_IEVENTHANDLER, kKFCQueryRowEHImpl,
		}
	},

	/*
	 * ...and the row's text cell: the stock cell (an InfoStaticTextWidget's boss) with its tooltip replaced - the whole of
	 * what the row's query does (KFCQueryRowTip.cpp, which says why the cell and not the row, and why nothing is read
	 * into what replaces it).
	 */
	Class
	{
		kKFCQueryRowTextWidgetBoss,
		kInfoStaticTextWidgetBoss,
		{
			IID_ITIP, kKFCQueryRowTipImpl,
		}
	},

	/*
	 * What a picked query does, read off its file (KFCQueryContents.cpp): the content handler InDesign's XML parser calls
	 * as it reads - created for one parse and let go, the shape of the SDK's own (chlinguistic's
	 * kCHLUserDictContentHandlerBoss).
	 */
	Class
	{
		kKFCQueryContentsHandlerBoss,
		kInvalidClass,
		{
			IID_ISAXCONTENTHANDLER, kKFCQueryContentsHandlerImpl,
		}
	},

	/*
	 * The query dialog's "Runs on:" line. EVE treats a static text's .fr width as a MINIMUM and grows the widget - and
	 * the dialog - to fit its words; this line names a book, so it would. IID_IEVEINFO answers EVE's size question with
	 * the resource's frame instead (kFixedSizeEVEInfoImpl), and the widget's own ellipsis shortens what does not fit.
	 * KCM's kKCMBookPathTextWidgetBoss, which measured the effect, is the same two lines.
	 */
	Class
	{
		kKFCQueryFixedTextWidgetBoss,
		kStaticTextWidgetBoss,
		{
			IID_IEVEINFO, kFixedSizeEVEInfoImpl,
		}
	},

	/*
	 * THE KOHAKU TAB'S FACE in InDesign's Find/Change dialog (KFCKohakuTab.cpp - the shape of InDesign's own faces:
	 * docs/superpowers/specs/2026-10-27-kfc-qr-code-search-design.md D3, kFindMiniTabbedDialogTextPanelBoss and its
	 * siblings in the 20.5 dump - KT's face of the same four, measured): the dialog panel service that offers it, a
	 * creator that names its resource, an observer for its widgets and a controller for the dialog's calls.
	 */
	Class
	{
		kKFCKohakuTabPanelBoss,
		kPrimaryResourcePanelWidgetBoss,
		{
			IID_IK2SERVICEPROVIDER, kDialogPanelServiceImpl,
			IID_IPANELCREATOR, kKFCKohakuTabPanelCreatorImpl,
			IID_IOBSERVER, kKFCKohakuTabObserverImpl,
			IID_IDIALOGCONTROLLER, kKFCKohakuTabControllerImpl,
		}
	},

}}};

/*  
 * Implementation definition.
 */
resource FactoryList (kSDKDefFactoryListResourceID)
{
	kImplementationIDSpace,
	{
		#include "KFCUIFactoryList.h"
	}
};

/*  
 * Menu definition.
 */
resource MenuDef (kSDKDefMenuResourceID)
{
	{
		// The About sub-menu item for this plug-in.
		kKFCAboutActionID,			// ActionID (kInvalidActionID for positional entries)
		kKFCAboutMenuPath,			// Menu Path.
		kSDKDefAlphabeticPosition,											// Menu Position.
		kSDKDefIsNotDynamicMenuFlag,										// kSDKDefIsNotDynamicMenuFlag or kSDKDefIsDynamicMenuFlag

		// ----- The panel's flyout menu -----
		// Written here in the order it is DRAWN. What actually decides that order is each item's
		// position number, and the blocks those numbers form are laid out in KFCUIID.h. The
		// separators' names are in the order they were added, not the order they appear in - the
		// first one written was the rule above About, which is why it is Separator1 down at 10.0.

		// --- Block 1: the commands (each below; their order is the positions in KFCUIID.h) ---

		// Open Find/Change... (the author's call): InDesign's own Find/Change dialog, opened from here -
		// with no document open as well, where the Edit menu greys it out. Open, type the query, then search.
		kKFCOpenFindChangeActionID,
		kKFCTargetMenuPath
		kKFCOpenFindChangeMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Find in <scope>: run the search over the current scope using the settings in InDesign's own
		// Find/Change dialog. Drawn under the name the scope calls for (see the action definition below).
		kKFCSearchBookActionID,
		kKFCTargetMenuPath
		kKFCSearchBookMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Next Result / Previous Result (the next-overrides-restore spec's A1): the live tier's next / previous hit row
		// selected and landed on, as the list's arrow keys land (KFCResultStep) - with a key of the person's own, from the text.
		kKFCNextResultActionID,
		kKFCTargetMenuPath
		kKFCNextResultMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCPreviousResultActionID,
		kKFCTargetMenuPath
		kKFCPreviousResultMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Change All in Book (No List): InDesign's own Change All over the book's chapters, no list (KFCChangeAll).
		// Greyed with Book Scope off (F18 - a document's Change All is InDesign's own dialog's).
		kKFCChangeAllActionID,
		kKFCTargetMenuPath
		kKFCChangeAllMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Clear Results: the list emptied, so Change All can run.
		kKFCClearResultsActionID,
		kKFCTargetMenuPath
		kKFCClearResultsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Copy Results (docs/superpowers/specs/2026-10-18-kfc-copy-results-progress-share-design.md): every row of the live list as
		// text on the clipboard - a line of column names, a tab between columns (KFCCopyResults - the Links panel's Copy Info).
		kKFCCopyResultsActionID,
		kKFCTargetMenuPath
		kKFCCopyResultsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Run Saved Queries...: the query dialog - saved queries put in an order and run with InDesign's own
		// Change All, one after another (KFCQueryDialog.cpp). Last in the block (the author's call).
		kKFCRunSavedQueriesActionID,
		kKFCTargetMenuPath
		kKFCRunSavedQueriesMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// (No block 2: Find Missing Glyphs and Find Overset are the Book panel's preflight's - the author's call.)

		// Separator between Run Saved Queries... and the toggles.
		kKFCSeparator3ActionID,
		kKFCInternalPopupMenuNameKey kSDKDefDelimiterAndSeparatorPath,	// :- to mark an item as a separator.
		kKFCSeparator3MenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// --- Block 3: the check-mark toggles, in alphabetical order (the author's arrangement - the
		// positions and the reason Book Scope comes first are in KFCUIID.h) ---

		// Book Scope: toggle (check mark). ON = the whole book, OFF = what Edit > Find/Change's Search:
		// names. What the commands in block 1 run on.
		kKFCScopeBookActionID,
		kKFCTargetMenuPath
		kKFCBookScopeMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Find/Change Selected Documents (Book): toggle (check mark). With Book Scope on, a run takes only the
		// Book panel's selected documents; grey with Book Scope off - so it stands right under it.
		kKFCSelectedDocumentsActionID,
		kKFCTargetMenuPath
		kKFCSelectedDocumentsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Hide Previous Chapter: toggle (check mark). Closes the previous chapter window on jump.
		kKFCHidePrevChapterActionID,
		kKFCTargetMenuPath
		kKFCHidePrevChapterMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Link the Application Bar's Search Field to This Panel: toggle (check mark). Return in the search
		// field of InDesign's application bar searches with this panel. *Windows only. KFCAppBarSearchEnter.h.
		kKFCAppBarSearchEnterActionID,
		kKFCTargetMenuPath
		kKFCAppBarSearchEnterMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Minimizable Find/Change: toggle (check mark). Puts a minimize box on InDesign's OWN
		// Find/Change dialog, so it can be sent to the taskbar instead of closed - the window Translucent
		// Find/Change acts on. *Windows only.
		kKFCMinimizableFindChangeActionID,
		kKFCTargetMenuPath
		kKFCMinimizableFindChangeMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Remember Book Panel Placement: toggle (check mark). InDesign's own Book panel comes back
		// where it was closed.
		kKFCRememberBookPanelActionID,
		kKFCTargetMenuPath
		kKFCRememberBookPanelMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Translucent Find/Change: toggle (check mark) for InDesign's OWN Find/Change dialog.
		// *Windows only.
		kKFCTranslucentFindChangeActionID,
		kKFCTargetMenuPath
		kKFCTranslucentFindChangeMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Translucent Panel: Translucent Find/Change's idea applied to this panel - drawn faint while it
		// floats, and back to solid while the pointer is on it. *Windows only.
		kKFCTranslucentPanelActionID,
		kKFCTargetMenuPath
		kKFCTranslucentPanelMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Separator between the toggles and the command that writes a file.
		kKFCSeparator4ActionID,
		kKFCInternalPopupMenuNameKey kSDKDefDelimiterAndSeparatorPath,	// :- to mark an item as a separator.
		kKFCSeparator4MenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// --- Block 4: the command that writes a file of our own ---

		// Save Panel Settings: write the toggles above to a JSON file of our own in the user's
		// preferences folder, read back at startup. A plain command, not a toggle.
		kKFCSavePanelSettingsActionID,
		kKFCTargetMenuPath
		kKFCSavePanelSettingsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Separator between those and the two reference items that close the menu.
		kKFCSeparator1ActionID,
		kKFCInternalPopupMenuNameKey kSDKDefDelimiterAndSeparatorPath,	// :- to mark an item as a separator.
		kKFCSeparator1MenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// --- Block 5: the two reference items ---

		// "How to Use...": the plug-in's operating reference, in a scrollable dialog (KFCHowTo.cpp).
		// Between the separator and About.
		kKFCHowToActionID,
		kKFCTargetMenuPath
		kKFCHowToMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// About this plug-in sub-menu for the popup menu on the panel
		kKFCPopupAboutThisActionID,
		kKFCTargetMenuPath
		kKFCAboutThisMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ----- A hit row's right-click menu -----
		// Popped by KFCResultNodeEH::RButtonDn over a hit row: Replace replaces that row - or the rows selected
		// together, when it is one of them - with no prompt.
		kKFCReplaceHitActionID,
		kKFCResultHitMenuName
		kKFCReplaceHitMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ...and Restore from Copy under it (the copy-restore spec's C1): the copy the row's Replace took put back -
		// or the copies of the rows selected together it is one of (KFCReplaceEngine::RestoreHits).
		kKFCRestoreOriginalActionID,
		kKFCResultHitMenuName
		kKFCRestoreOriginalMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ...and its Special Operations > Create Outlines (docs/superpowers/specs/2026-10-18-kfc-text-outlines-design.md X1): the
		// matched characters alone outlined - the row's, or the rows' selected together (KFCReplaceEngine::OutlineHits). The
		// object row's action, the object row's submenu name; the parent node as there (ActionID 0, the path and a delimiter).
		0,
		kKFCHitSpecialOpsSubmenuPath kSDKDefDelimitMenuPath
		kKFCHitSpecialOpsSubmenuPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCCreateOutlinesActionID,
		kKFCHitSpecialOpsSubmenuPath
		kKFCCreateOutlinesMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ...and Clear Overrides (docs/superpowers/specs/2026-10-30-kfc-next-overrides-restore-design.md B2): the overrides of
		// the row's match - or the rows' selected together - taken off, as the paragraph styles panel's Clear Overrides takes
		// them off a selection (KFCReplaceEngine::ClearOverridesHits). A text row's alone (an object row has Clear Object
		// Style Overrides). Above Create Outlines - the abc order.
		kKFCClearTextOverridesActionID,
		kKFCHitSpecialOpsSubmenuPath
		kKFCClearTextOverridesMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ----- A story row's right-click menu -----
		// Popped by KFCResultNodeEH::RButtonDn over a story row: Search This Story Again walks that story alone with
		// the search's query and puts its rows back (KFCSearchEngine::SearchStoryAgain).
		kKFCSearchStoryAgainActionID,
		kKFCResultStoryMenuName
		kKFCSearchStoryAgainMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ----- A document row's right-click menu -----
		// Popped by KFCResultNodeEH::RButtonDn over a document row: Search This Document Again walks that document whole
		// with the search's query and puts its rows back (KFCSearchEngine::SearchDocumentAgain).
		kKFCSearchDocumentAgainActionID,
		kKFCResultDocumentMenuName
		kKFCSearchDocumentAgainMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ----- Select All Rows: the book, document and story rows' menus (the author's call) -----
		// Every hit row under the row right-clicked selected, for Return to replace them all together
		// (KFCResultTree::SelectAllRows).
		kKFCSelectAllRowsActionID,
		kKFCResultStoryMenuName
		kKFCSelectAllRowsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCSelectAllRowsActionID,
		kKFCResultDocumentMenuName
		kKFCSelectAllRowsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCSelectAllRowsActionID,
		kKFCResultBookMenuName
		kKFCSelectAllRowsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ...and the book row's Copy Rows: every row of the list (the copy-results spec).
		kKFCCopyRowsActionID,
		kKFCResultBookMenuName
		kKFCCopyRowsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ----- A tier's own row's right-click menu (the author's call) -----
		// Popped by KFCResultNodeEH::RButtonDn over a tier's row: Clear These Results lets that tier alone go - a grey one, or
		// the live list (KFCResultHistory::ClearTier).
		kKFCClearTheseResultsActionID,
		kKFCResultTierMenuName
		kKFCClearTheseResultsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ...and Copy These Results above it (the copy-results spec): that tier's rows as text on the clipboard - a grey tier's
		// as its copy holds them (KFCCopyResults::CopyTier).
		kKFCCopyTheseResultsActionID,
		kKFCResultTierMenuName
		kKFCCopyTheseResultsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ...and Search These Results Again (the author's call): that tier's own search run once more - a grey one
		// switched to first (KFCResultTree::SearchListAgain).
		kKFCSearchTierAgainActionID,
		kKFCResultTierMenuName
		kKFCSearchTierAgainMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ...and Search Text in These Objects (docs/superpowers/specs/2026-10-21-kfc-text-in-object-results-design.md T2):
		// the text inside a tier of objects, into a new tier - a grey tier switched to first
		// (KFCResultHistory::SearchTextInObjects); grey over a tier of text rows.
		kKFCSearchTextInObjectsActionID,
		kKFCResultTierMenuName
		kKFCSearchTextInObjectsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ...and Search Text in These Tables (the author, 10-31): the same over a tier of the Table kind; grey over any other.
		kKFCSearchTextInTablesActionID,
		kKFCResultTierMenuName
		kKFCSearchTextInTablesMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ...and Narrow Down (docs/superpowers/specs/2026-10-18-kfc-narrow-down-design.md N1, N2): that tier's search run once more
		// with its conditions and the one chosen, into a new tier - a grey tier switched to first (KFCResultHistory::Narrow). The
		// submenu's parent node: ActionID 0 and its path ending in the delimiter (Special Operations' idiom).
		0,
		kKFCNarrowDownSubmenuPath kSDKDefDelimitMenuPath
		kKFCNarrowDownSubmenuPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCNarrowInFootnotesActionID,
		kKFCNarrowDownSubmenuPath
		kKFCNarrowInFootnotesMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCNarrowInEndnotesActionID,
		kKFCNarrowDownSubmenuPath
		kKFCNarrowInEndnotesMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCNarrowPagesActionID,
		kKFCNarrowDownSubmenuPath
		kKFCNarrowPagesMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCNarrowOnPasteboardActionID,
		kKFCNarrowDownSubmenuPath
		kKFCNarrowOnPasteboardMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCNarrowFramesActionID,
		kKFCNarrowDownSubmenuPath
		kKFCNarrowFramesMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// On Active Layer (the author's call: off the panel menu, text tiers too): the tier's rows kept to the front
		// document's active layer, by its name (KFCNarrow - a text row by its frame's layer).
		kKFCNarrowOnLayerActionID,
		kKFCNarrowDownSubmenuPath
		kKFCNarrowOnLayerMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// With Overrides (the next-overrides-restore spec's B1): the tier's rows kept to the matches whose text InDesign calls
		// overridden (KFCNarrow - KFCTextOverrides::HasOverrides). Last in the abc order.
		kKFCNarrowWithOverridesActionID,
		kKFCNarrowDownSubmenuPath
		kKFCNarrowWithOverridesMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ----- Clear from Results: the hit, object, story and document rows' menus (docs/superpowers/specs/2026-10-18-kfc-clear-from-results-design.md K2) -----
		// (In abc order with the rest - the positions in KFCUIID.h; the spec put it last, under a rule): a hit or object row's
		// rows - the rows selected together when it is one of them - or every hit row under a story or document row, taken off the
		// list (KFCResultTree::ClearRows). The document is not touched.
		kKFCClearFromResultsActionID,
		kKFCResultHitMenuName
		kKFCClearFromResultsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCClearFromResultsActionID,
		kKFCResultObjectMenuName
		kKFCClearFromResultsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCClearFromResultsActionID,
		kKFCResultStoryMenuName
		kKFCClearFromResultsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCClearFromResultsActionID,
		kKFCResultDocumentMenuName
		kKFCClearFromResultsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ----- Copy Rows: the same four menus (the copy-results spec) -----
		// The rows Clear from Results would take off - the row's, the rows selected together, a story's or a document's - as text
		// on the clipboard (KFCCopyResults::CopyLiveRows). Nothing is taken away.
		kKFCCopyRowsActionID,
		kKFCResultHitMenuName
		kKFCCopyRowsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCCopyRowsActionID,
		kKFCResultObjectMenuName
		kKFCCopyRowsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCCopyRowsActionID,
		kKFCResultStoryMenuName
		kKFCCopyRowsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCCopyRowsActionID,
		kKFCResultDocumentMenuName
		kKFCCopyRowsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ----- An OBJECT row's right-click menu (the author's call) -----
		// Popped by KFCResultNodeEH::RButtonDn over an object row (the Object tab's): its Replace - the hit rows' own action -
		// and Special Operations > Create Outlines (KFCObjectOutline): the row's object outlined - or the rows' selected
		// together, when it is one of them - wherever they stand, across spreads and documents.
		kKFCReplaceHitActionID,
		kKFCResultObjectMenuName
		kKFCObjectReplaceMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// The submenu's parent node: ActionID 0 and its path ending in the delimiter (KCM's submenus - Adobe's idiom).
		0,
		kKFCSpecialOpsSubmenuPath kSDKDefDelimitMenuPath
		kKFCSpecialOpsSubmenuPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCCreateOutlinesActionID,
		kKFCSpecialOpsSubmenuPath
		kKFCCreateOutlinesMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ----- The other Special Operations (docs/superpowers/specs/2026-10-17-kfc-object-special-operations-design.md E2) -----
		// In abc order (the author's call - the positions in KFCUIID.h; the spec gave InDesign's own Object menu's order,
		// with rules). Each item's action stands for one KFCSpecialOp (KFCActionComponent.cpp's table) - the rows' objects
		// written where they stand.
		// Fitting (a submenu one level down: the same idiom).
		0,
		kKFCFittingSubmenuPath kSDKDefDelimitMenuPath
		kKFCFittingSubmenuPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCFillFramePropActionID,
		kKFCFittingSubmenuPath
		kKFCFillFramePropMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCFitContentPropActionID,
		kKFCFittingSubmenuPath
		kKFCFitContentPropMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCContentAwareFitActionID,
		kKFCFittingSubmenuPath
		kKFCContentAwareFitMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCFitFrameToContentActionID,
		kKFCFittingSubmenuPath
		kKFCFitFrameToContentMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCFitContentToFrameActionID,
		kKFCFittingSubmenuPath
		kKFCFitContentToFrameMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCCenterContentActionID,
		kKFCFittingSubmenuPath
		kKFCCenterContentMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Arrange.
		0,
		kKFCArrangeSubmenuPath kSDKDefDelimitMenuPath
		kKFCArrangeSubmenuPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCBringToFrontActionID,
		kKFCArrangeSubmenuPath
		kKFCBringToFrontMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCBringForwardActionID,
		kKFCArrangeSubmenuPath
		kKFCBringForwardMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCSendBackwardActionID,
		kKFCArrangeSubmenuPath
		kKFCSendBackwardMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCSendToBackActionID,
		kKFCArrangeSubmenuPath
		kKFCSendToBackMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Transform: those asking a value (a dialog first - KFCSpecialDialogs), the turns and flips, those putting a
		// transformation back - in abc order.
		0,
		kKFCTransformSubmenuPath kSDKDefDelimitMenuPath
		kKFCTransformSubmenuPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCMoveActionID,
		kKFCTransformSubmenuPath
		kKFCMoveMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCScaleActionID,
		kKFCTransformSubmenuPath
		kKFCScaleMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCRotateActionID,
		kKFCTransformSubmenuPath
		kKFCRotateMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCShearActionID,
		kKFCTransformSubmenuPath
		kKFCShearMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCRotate90CWActionID,
		kKFCTransformSubmenuPath
		kKFCRotate90CWMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCRotate90CCWActionID,
		kKFCTransformSubmenuPath
		kKFCRotate90CCWMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCRotate180ActionID,
		kKFCTransformSubmenuPath
		kKFCRotate180MenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCFlipHorizontalActionID,
		kKFCTransformSubmenuPath
		kKFCFlipHorizontalMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCFlipVerticalActionID,
		kKFCTransformSubmenuPath
		kKFCFlipVerticalMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCRedefineScalingActionID,
		kKFCTransformSubmenuPath
		kKFCRedefineScalingMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCClearTransformationsActionID,
		kKFCTransformSubmenuPath
		kKFCClearTransformationsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Lock, Unlock, Hide, Show.
		kKFCLockActionID,
		kKFCSpecialOpsSubmenuPath
		kKFCLockMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCUnlockActionID,
		kKFCSpecialOpsSubmenuPath
		kKFCUnlockMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCHideActionID,
		kKFCSpecialOpsSubmenuPath
		kKFCHideMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCShowActionID,
		kKFCSpecialOpsSubmenuPath
		kKFCShowMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Move to Active Layer, Clear Object Style Overrides.
		kKFCMoveToLayerActionID,
		kKFCSpecialOpsSubmenuPath
		kKFCMoveToLayerMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKFCClearStyleOverridesActionID,
		kKFCSpecialOpsSubmenuPath
		kKFCClearStyleOverridesMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Delete.
		kKFCDeleteActionID,
		kKFCSpecialOpsSubmenuPath
		kKFCDeleteMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

	}
};

/* 
 * Action definition.
 */
resource ActionDef (kSDKDefActionResourceID)
{
	{
		kKFCActionComponentBoss, 		// ClassID of boss class that implements the ActionID.
		kKFCAboutActionID,	// ActionID.
		kKFCAboutMenuKey,	// Sub-menu string.
		// The Help > About Plug-ins entry belongs to the help menu's area, which is what the samples
		// (basicpanel/BscPnl.fr:200) give it. The area only ever
		// matters to the keyboard shortcut editor, and every action here is invisible in it, but
		// this is the classification the SDK puts on this one item. The popup's own "About This
		// Plug-In..." below stays kOtherActionArea - so does basicpanel's (:230).
		kHelpMenuActionArea,			// Area name (see ActionDefs.h).
		kNormalAction,					// Type of action (see ActionDefs.h).
		kDisableIfLowMem,				// Enabling type (see ActionDefs.h).
		kInvalidInterfaceID,			// Selection InterfaceID this action cares about or kInvalidInterfaceID.
		kSDKDefInvisibleInKBSCEditorFlag, // kSDKDefVisibleInKBSCEditorFlag or kSDKDefInvisibleInKBSCEditorFlag.

		kKFCActionComponentBoss,
		kKFCPopupAboutThisActionID,
		kKFCAboutThisPlugInMenuKey,		// Key to the name of this action ("About This Plug-In..." - KFCUIID.h)
		kOtherActionArea,
		kNormalAction,
		kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Open Find/Change.... NOT kDisableIfNoFrontDocument - opening the dialog with no document is the
		// point of it. In the Keyboard Shortcuts editor under Palette Menus (the author's call), like the
		// search below.
		kKFCActionComponentBoss,
		kKFCOpenFindChangeActionID,
		kKFCOpenFindChangeMenuKey,		// "Open Find/Change..."
		kKFCPanelMenuActionArea,
		kNormalAction,
		kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefVisibleInKBSCEditorFlag,

		// The search command. kCustomEnabling is what lets UpdateActionStates rename it for the scope it
		// would search (KFCSearchEngine::FindCommandName - "Find in Book", "Find in Document", ...);
		// without it that hook is never called for this action.
		// NOT kDisableIfNoFrontDocument: a book search runs off the Book panel's book (or the active
		// book as a fallback - KFCBookScope::ResolveTargetBook) and opens
		// its chapters windowless, so "a book is open but no document window is" is a normal, working
		// state here. That flag would grey this out - and skip UpdateActionStates, losing the name -
		// exactly when the panel is most useful. The Layers panel can afford it; this one cannot.
		// "There is nothing to run on" IS answered, but in UpdateActionStates, where the question can
		// be put to the CURRENT scope (KFCBookScope::HasScopeTarget).
		// IN THE KEYBOARD SHORTCUTS EDITOR (the author's call), under Palette Menus
		// as "Kohaku Find/Change: <name>" - KCM's shape (kKFCPanelMenuActionArea). The enabling is
		// unchanged: a shortcut runs the same UpdateActionStates test the flyout does.
		kKFCActionComponentBoss,
		kKFCSearchBookActionID,
		kKFCSearchBookMenuKey,			// "Search" (renamed at run time to carry the scope)
		kKFCPanelMenuActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefVisibleInKBSCEditorFlag,

		// Next Result / Previous Result (the next-overrides-restore spec's A1): in the Keyboard Shortcuts editor under Palette
		// Menus, as Find is - no shortcut of their own (the person picks one). kCustomEnabling: grey with no hit row in the
		// live tier, or the panel closed (KFCResultStep::CanStep - the spec's A6).
		kKFCActionComponentBoss,
		kKFCNextResultActionID,
		kKFCNextResultMenuKey,			// "Next Result"
		kKFCPanelMenuActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefVisibleInKBSCEditorFlag,

		kKFCActionComponentBoss,
		kKFCPreviousResultActionID,
		kKFCPreviousResultMenuKey,		// "Previous Result"
		kKFCPanelMenuActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefVisibleInKBSCEditorFlag,

		kKFCActionComponentBoss,
		kKFCScopeBookActionID,
		kKFCBookScopeMenuKey,			// "Book Scope" (toggle, check mark)
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKFCActionComponentBoss,
		kKFCSelectedDocumentsActionID,
		kKFCSelectedDocumentsMenuKey,	// "Find/Change Selected Documents (Book)" (toggle, check mark)
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKFCActionComponentBoss,
		kKFCHidePrevChapterActionID,
		kKFCHidePrevChapterMenuKey,		// "Hide Previous Chapter" (toggle, check mark)
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Translucent Panel. kCustomEnabling for the check mark, like the toggles above - and for
		// nothing else: it is deliberately NOT greyed out while the panel is docked, where it has no
		// visible effect (the author's call, as in KCM). Pressing it there sets the flag,
		// which applies the moment the panel floats again, and the status line says so rather than
		// leaving a click with no result unexplained.
		kKFCActionComponentBoss,
		kKFCTranslucentPanelActionID,
		kKFCTranslucentPanelMenuKey,	// "Translucent Panel" (toggle, check mark)
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Translucent Find/Change. kCustomEnabling for the check mark, like the toggle above it. Not
		// greyed out while the dialog is closed, for the same reason the panel one is not greyed out
		// while docked: the flag is what the user is setting, and it applies the moment the dialog
		// opens. The status line says which of the two happened.
		kKFCActionComponentBoss,
		kKFCTranslucentFindChangeActionID,
		kKFCTranslucentFindChangeMenuKey,	// "Translucent Find/Change" (toggle, check mark)
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Link the Application Bar's Search Field to This Panel. kCustomEnabling for the check mark, like
		// the toggles beside it. Not greyed out while the field is hidden: the flag is what is being set.
		kKFCActionComponentBoss,
		kKFCAppBarSearchEnterActionID,
		kKFCAppBarSearchEnterMenuKey,	// "Link the Application Bar's Search Field to This Panel" (toggle, check mark)
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Minimizable Find/Change. kCustomEnabling for the check mark, like the toggle above it.
		// Not greyed out while the dialog is closed, for the same reason: the flag is what the user
		// is setting, and it applies the moment the dialog opens.
		kKFCActionComponentBoss,
		kKFCMinimizableFindChangeActionID,
		kKFCMinimizableFindChangeMenuKey,	// "Minimizable Find/Change" (toggle, check mark)
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Remember Book Panel Placement. kCustomEnabling for the check mark, like the toggles above -
		// without it the check mark never appears (ActionDefs.h:40). Not greyed out with no book open:
		// the flag is what is being set, and it acts the next time a book panel closes or opens.
		kKFCActionComponentBoss,
		kKFCRememberBookPanelActionID,
		kKFCRememberBookPanelMenuKey,	// "Remember Book Panel Placement" (toggle, check mark)
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Save Panel Settings. NO kCustomEnabling: there is nothing to enable it against - it writes
		// the settings down, which is possible with nothing loaded and no results.
		// !Without kCustomEnabling this action never reaches UpdateActionStates at all, so the blanket
		// disable at the top of that method does NOT cover it - the hook completes the enabling only
		// for actions that ask for it (ActionDefs.h:40). A run's progress bar is modal, so the flyout
		// cannot be opened while one is going (measured); the stand-in for a model half of another build
		// answers "a run standing" for good - KFCSavePanelState asks the run door itself, which says why.
		kKFCActionComponentBoss,
		kKFCSavePanelSettingsActionID,
		kKFCSavePanelSettingsMenuKey,	// "Save Panel Settings"
		kOtherActionArea,
		kNormalAction,
		kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Change All in Book (No List). kCustomEnabling: UpdateActionStates greys it (Book Scope off - F18 -, a list on
		// the panel, no book to run on, the Colour tab, nothing to find - on the Object tab an empty Find Object Format).
		// In the Keyboard Shortcuts editor under Palette Menus, like Find.
		kKFCActionComponentBoss,
		kKFCChangeAllActionID,
		kKFCChangeAllMenuKey,			// "Change All in Book (No List)"
		kKFCPanelMenuActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefVisibleInKBSCEditorFlag,

		// Run Saved Queries...: kCustomEnabling for the blanket grey while a run stands (UpdateActionStates'
		// first lines); otherwise always on - putting queries in an order needs no document, and what Run would run on is
		// said in the dialog itself. In the Keyboard Shortcuts editor under Palette Menus, like Find and Change All.
		kKFCActionComponentBoss,
		kKFCRunSavedQueriesActionID,
		kKFCRunSavedQueriesMenuKey,		// "Run Saved Queries..."
		kKFCPanelMenuActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefVisibleInKBSCEditorFlag,

		// Clear Results. kCustomEnabling: grey with no list.
		kKFCActionComponentBoss,
		kKFCClearResultsActionID,
		kKFCClearResultsMenuKey,		// "Clear Results"
		kKFCPanelMenuActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefVisibleInKBSCEditorFlag,

		// Replace - a hit row's and an object row's right-click menu.
		// kCustomEnabling: UpdateActionStates greys it by the row the menu is over.
		kKFCActionComponentBoss,
		kKFCReplaceHitActionID,
		kKFCReplaceHitMenuKey,			// "Replace"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Search This Story Again - a story row's right-click menu (the author's call).
		// kCustomEnabling: UpdateActionStates greys it when it comes with no story row (pressed by ID) or while a run is up.
		kKFCActionComponentBoss,
		kKFCSearchStoryAgainActionID,
		kKFCSearchStoryAgainMenuKey,	// "Search This Story Again"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Search This Document Again - a document row's right-click menu (the author's call).
		// kCustomEnabling: UpdateActionStates greys it when it comes with no document row (pressed by ID) or while a run is up.
		kKFCActionComponentBoss,
		kKFCSearchDocumentAgainActionID,
		kKFCSearchDocumentAgainMenuKey,	// "Search This Document Again"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Select All Rows - a book, document or story row's right-click menu (the author's call).
		// kCustomEnabling: UpdateActionStates greys it when it comes with no such row (pressed by ID), while that row has no hit
		// row under it, or while a run is up.
		kKFCActionComponentBoss,
		kKFCSelectAllRowsActionID,
		kKFCSelectAllRowsMenuKey,		// "Select All Rows"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Clear These Results - a tier's own row's right-click menu (the author's call).
		// kCustomEnabling: UpdateActionStates greys it when it comes with no tier row (pressed by ID) or while a run is up.
		kKFCActionComponentBoss,
		kKFCClearTheseResultsActionID,
		kKFCClearTierResultsMenuKey,	// "Clear These Results"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Search These Results Again - a tier's own row's right-click menu (the author's call). kCustomEnabling, as
		// Clear These Results.
		kKFCActionComponentBoss,
		kKFCSearchTierAgainActionID,
		kKFCSearchTierAgainMenuKey,	// "Search These Results Again"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Search Text in These Objects - a tier's own row's right-click menu (the text-in-objects spec's T2). kCustomEnabling:
		// grey over a tier of text rows, and with no tier row (pressed by ID) or while a run is up.
		kKFCActionComponentBoss,
		kKFCSearchTextInObjectsActionID,
		kKFCSearchTextInObjectsMenuKey,	// "Search Text in These Objects"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKFCActionComponentBoss,
		kKFCSearchTextInTablesActionID,
		kKFCSearchTextInTablesMenuKey,	// "Search Text in These Tables"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Create Outlines - a hit or object row's Special Operations. kCustomEnabling: grey when none can be outlined.
		kKFCActionComponentBoss,
		kKFCCreateOutlinesActionID,
		kKFCCreateOutlinesMenuKey,	// "Create Outlines"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// The other Special Operations - an object row's (docs/superpowers/specs/2026-10-17-kfc-object-special-operations-design.md).
		// kCustomEnabling: an object row's alone, greyed when none of the rows can take it (CanSpecialAny); what the write
		// refuses it says on the status line, row by row counted.
		kKFCActionComponentBoss,
		kKFCFillFramePropActionID,
		kKFCFillFramePropMenuKey,
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
