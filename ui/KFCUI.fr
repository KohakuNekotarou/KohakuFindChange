		// Clear from Results - a hit, object, story or document row's right-click menu (docs/superpowers/specs/2026-10-18-kfc-clear-from-results-design.md).
		// kCustomEnabling: UpdateActionStates greys it when it comes with no such row (pressed by ID), or while a run is up.
		kKFCActionComponentBoss,
		kKFCClearFromResultsActionID,
		kKFCClearRowsMenuKey,			// "Clear from Results"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Copy Results - the panel menu's (docs/superpowers/specs/2026-10-18-kfc-copy-results-progress-share-design.md).
		// kCustomEnabling: greyed with no row to copy. In the Keyboard Shortcuts editor under Palette Menus, like Clear Results
		// (the author's call - the spec map's SET-13).
		kKFCActionComponentBoss,
		kKFCCopyResultsActionID,
		kKFCCopyResultsMenuKey,			// "Copy Results"
		kKFCPanelMenuActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefVisibleInKBSCEditorFlag,

		// Copy Rows - a hit, object, story, document or book row's right-click menu. kCustomEnabling: greyed when it comes with no
		// such row (pressed by ID) or with no row to copy.
		kKFCActionComponentBoss,
		kKFCCopyRowsActionID,
		kKFCCopyRowsMenuKey,			// "Copy Rows"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Copy These Results - a tier's own row's right-click menu. kCustomEnabling: greyed with no tier row or no row to copy.
		kKFCActionComponentBoss,
		kKFCCopyTheseResultsActionID,
		kKFCCopyTierResultsMenuKey,		// "Copy These Results"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Narrow Down's items - a tier heading's submenu (docs/superpowers/specs/2026-10-18-kfc-narrow-down-design.md). kCustomEnabling:
		// UpdateActionStates greys them with no tier row (pressed by ID), and a text-only one over a tier of object rows.
		kKFCActionComponentBoss,
		kKFCNarrowInFootnotesActionID,
		kKFCNarrowInFootnotesMenuKey,	// "In Footnotes"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKFCActionComponentBoss,
		kKFCNarrowInEndnotesActionID,
		kKFCNarrowInEndnotesMenuKey,	// "In Endnotes"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKFCActionComponentBoss,
		kKFCNarrowPagesActionID,
		kKFCNarrowPagesMenuKey,	// "Pages..."
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKFCActionComponentBoss,
		kKFCNarrowOnPasteboardActionID,
		kKFCNarrowOnPasteboardMenuKey,	// "On Pasteboard"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKFCActionComponentBoss,
		kKFCNarrowFramesActionID,
		kKFCNarrowFramesMenuKey,	// "Frames of These Matches"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// On Active Layer (off the panel menu, text tiers too - the author's call). kCustomEnabling: greyed with no
		// layer active in the front document's Layers panel, as Move to Active Layer is.
		kKFCActionComponentBoss,
		kKFCNarrowOnLayerActionID,
		kKFCNarrowOnLayerMenuKey,	// "On Active Layer"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// With Overrides (the next-overrides-restore spec's B1). kCustomEnabling: greyed over a tier of object rows (a text-only
		// condition - NarrowIsTextOnly), kept on the menu.
		kKFCActionComponentBoss,
		kKFCNarrowWithOverridesActionID,
		kKFCNarrowWithOverridesMenuKey,	// "With Overrides"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Clear Overrides - a text row's Special Operations (the spec's B2). kCustomEnabling: grey when none of the rows can be
		// written (CanClearOverridesAny - their doors, read only).
		kKFCActionComponentBoss,
		kKFCClearTextOverridesActionID,
		kKFCClearTextOverridesMenuKey,	// "Clear Overrides"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Restore from Copy - a text row's right-click menu, under Replace (the copy-restore spec).
		// kCustomEnabling: a text row a Replace wrote (CanRestoreAny); why a copy cannot go back it says on the status line.
		kKFCActionComponentBoss,
		kKFCRestoreOriginalActionID,
		kKFCRestoreOriginalMenuKey,	// "Restore from Copy" (the author's later name - the IDs keep the first one)
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// "How to Use...". NO kCustomEnabling: this one has nothing to be enabled against. It reads a
		// text - no document, no result set, no selection - so it stays live with nothing loaded, which
		// is exactly when a first-time user reaches for it. (Not caught by the blanket disable at the top
		// of UpdateActionStates either - see Save Panel Settings above.)
		kKFCActionComponentBoss,
		kKFCHowToActionID,
		kKFCHowToMenuKey,				// "How to Use..."
		kOtherActionArea,
		kNormalAction,
		kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

	}
};


/*  
 * Locale Indicies.
 * The LocaleIndex should have indicies that point at your
 * localizations for each language system that you are localized for.
 */

/*  
 * String LocaleIndex.
 */
resource LocaleIndex ( kSDKDefStringsResourceID)
{
	kStringTableRsrcType,
	{
		// ONE wild row, the same as the model half's: model/KFC.fr's LocaleIndex says why (a single
		// table, matched by every locale; a named-locale list strands every locale it leaves out on raw
		// keys; the How to Use page's Japanese is switched in at run time - KFCHowTo.cpp).
		kWildFS, k_Wild, kSDKDefStringsResourceID + index_enUS
	}
};

resource LocaleIndex (kSDKDefStringsNoTransResourceID)
{
	kStringTableRsrcType,
	{
		kWildFS, k_Wild, kSDKDefStringsNoTransResourceID + index_enUS
	}
};

// Strings not being localized
resource StringTable (kSDKDefStringsNoTransResourceID + index_enUS)
{
	k_enUS,									// Locale Id
	kEuropeanMacToWinEncodingConverter,		// Character encoding converter
	{
		kKFCInternalPopupMenuNameKey,	kKFCInternalPopupMenuNameKey,		// No need to translate, internal menu name.
	
	}
};

/*  
 * Panel LocaleIndex.
 */
resource LocaleIndex (kSDKDefPanelResourceID)
{
	kViewRsrcType,
	{
		kWildFS, k_Wild, 	kSDKDefPanelResourceID + index_enUS
	}
};

/*
 * LocaleIndex wrappers for the result tree's row resources. KFCResultListWidgetMgr
 * creates these at runtime via RsrcSpec(..., kViewRsrcType, <base RsrcID>); these map that base
 * ID to the +index_enUS body. The rows carry no localized strings (text is stamped at runtime),
 * so one wild locale suffices.
 */
resource LocaleIndex (kKFCResultChapterNodeWidgetRsrcID)
{
	kViewRsrcType,
	{
		kWildFS, k_Wild, 	kKFCResultChapterNodeWidgetRsrcID + index_enUS
	}
};

resource LocaleIndex (kKFCResultHitNodeWidgetRsrcID)
{
	kViewRsrcType,
	{
		kWildFS, k_Wild, 	kKFCResultHitNodeWidgetRsrcID + index_enUS
	}
};

/*  
 * Type definition.
 */
type KFCPanelWidget(kViewRsrcType) : PalettePanelWidget(ClassID = kKFCPanelWidgetBoss)
{
	CPanelMenuData;
};

/*
 * Result tree types. The list on our tree boss; the row on our tree node boss (it carries
 * the row-click handler, KFCResultNodeEH), shared by the branch and hit row resources; the hit
 * line's colour cell on our generic-panel boss.
 */
type KFCResultListWidget(kViewRsrcType) : TreeViewWidget(ClassID = kKFCResultListWidgetBoss)
{
};

type KFCResultNodeWidget(kViewRsrcType) : PrimaryResourcePanelWidget(ClassID = kKFCResultNodeWidgetBoss)
{
};

type KFCColorTextWidget(kViewRsrcType) : GenericPanelWidget(ClassID = kKFCColorTextWidgetBoss)
{
};

// A hit row's eye (the row eye): an icon suite widget whose click is its own (kKFCResultEyeWidgetBoss).
type KFCResultEyeWidget(kViewRsrcType) : IconSuiteWidget(ClassID = kKFCResultEyeWidgetBoss)
{
};

// The panel's message area: drawn by hand for the same reason (see kKFCStatusTextWidgetBoss).
// ! The field list is GenericPanelWidget's, NOT StaticMultiLineTextWidget's - the line that uses it
// carries no alignment, ellipsize style, ampersand flag, font, LINE COUNT or initial string. The drawing
// code decides all of them, and the line count is the box's own height (KFCStatusTextView.cpp). KCM's
// KCMStatusTextWidget is the same type.
type KFCStatusTextWidget(kViewRsrcType) : GenericPanelWidget(ClassID = kKFCStatusTextWidgetBoss)
{
};

/*
 * The panel's illustration. KFCIconWidget rather than the plain RollOverIconButtonWidget so that it
 * comes up on kKFCIconWidgetBoss and therefore carries IID_ITIP (the tooltip naming the URL).
 */
type KFCIconWidget(kViewRsrcType) : RollOverIconButtonWidget(ClassID = kKFCIconWidgetBoss)
{
};

/*
 * The query dialog. "DialogBoss" is the widget type every SDK dialog is written with (basicdialog, KCM's
 * book dialog); WidgetEveInfo is required - EVE lays the dialog out. The lists carry WidgetEveInfo too: they sit among
 * EVE children (KCM's KCMBookTreeWidget, and the product's EVETreeViewWidget in LinksUIViews.fr). The row has none - it
 * is built by the list's row maker, outside EVE. The "Runs on:" line is an EVEStaticTextWidget on our fixed-size boss.
 */
type KFCQueryDialogWidget(kViewRsrcType) : DialogBoss(ClassID = kKFCQueryDialogBoss)
{
	WidgetEveInfo;
};
type KFCQueryListWidget(kViewRsrcType) : TreeViewWidget(ClassID = kKFCQueryListWidgetBoss)
{
	WidgetEveInfo;
};
type KFCQueryRowWidget(kViewRsrcType) : PrimaryResourcePanelWidget(ClassID = kKFCQueryRowWidgetBoss) { };
type KFCQueryRowTextWidget(kViewRsrcType) : InfoStaticTextWidget(ClassID = kKFCQueryRowTextWidgetBoss) { };
type KFCQueryFixedTextWidget(kViewRsrcType) : EVEStaticTextWidget(ClassID = kKFCQueryFixedTextWidgetBoss) { };
// The value dialogs (KFCSpecialDialogs.cpp): DialogBoss with WidgetEveInfo, as the query dialog - EVE lays them out.
type KFCValueDialogWidget(kViewRsrcType) : DialogBoss(ClassID = kKFCValueDialogBoss)
{
	WidgetEveInfo;
};

/*
 * The illustration's artwork, compiled into the plug-in. The same image is given to the normal
 * (PNGA) and rollover (PNGR) states: the picture is a link, not a control that changes state, so
 * there is no second look for it to take. KCM does the same with its status icons.
 *
 * !! Replacing the .png alone does NOT reach a build - the build watches the .fr's timestamp, not
 *   the image's, so the icon compile step is skipped and the old artwork is linked again (the
 *   .pln's own date still moves, which is what makes this hard to spot). Touch this file after
 *   swapping the picture.
 *
 * KohakuNeko_On.png sits in this folder beside the files named below and is DELIBERATELY not one of
 * them: it is the original artwork (400x400) the 32px icons were drawn down from, kept so they can
 * be redrawn from it rather than enlarged from a thumbnail. Nothing compiles it in and nothing
 * loads it - if it is ever wanted on screen, it needs a resource line of its own here, and a
 * properly sized version to point that line at.
 */
resource PNGA(kKFCIconResID) "Kohakuneko_OFF32.png"
resource PNGR(kKFCIconResID) "Kohakuneko_OFF32.png"
resource PNGA(kKFCIconFoundResID) "KohakuFind32.png"
resource PNGR(kKFCIconFoundResID) "KohakuFind32.png"
resource PNGA(kKFCIconChangedResID) "KohakuChange32.png"
resource PNGR(kKFCIconChangedResID) "KohakuChange32.png"

/*
 * The small dock-tab icon, shown in place of the tab's name once the panel is collapsed to its
 * narrowest. Named by the PanelList entry above (kKFCPaletteIconResID, kKFCUIPluginID), which is
 * where a palette is told which picture is its own - it is NOT a widget, so there is no Frame and
 * no rollover state to give it.
 */
resource PNGA(kKFCPaletteIconResID) "KohakuFindChangeTab.png"

/*  
 * PanelList definition.
 */
resource PanelList (kSDKDefPanelResourceID)
{
	{
		// 1st panel in the list
		kSDKDefPanelResourceID,		// Resource ID for this panel (use SDK default rsrc ID)
		kKFCUIPluginID,			// ID of plug-in that owns this panel
		kIsResizable,
		kKFCPanelWidgetActionID,	// Action ID to show/hide the panel
		kKFCPanelWindowMenuName,	// Window > Kohaku Plug-Ins > Kohaku Find/Change (the author's call:
									// "like KCM"). *The colon inside this key is what buys the
									// sub-menu level (PanelList.fh on this field).
		"",							// *NO ALTERNATE MENU PATH: the panel lives on the Window menu alone,
									// where InDesign's own panels live. (An empty panelName would mean NO
									// Window entry at all.)
		0.0,						// Alternate menu position - meaningless without a path.
		kKFCPaletteIconResID, kKFCUIPluginID,	// PNG icon for the collapsed dock tab
		c_Panel
	}
};

/* 
 * PanelView definition.
 * Note: it is not necessary to use EVE for panels.
 * The view is not currently localised: therefore, it can reside here.
 * However, if you wish to localise it, it is recommended to locate it in one of
 * the localised framework resource files (i.e. KFCUI_enUS.fr etc.).
 */
resource KFCPanelWidget(kSDKDefPanelResourceID + index_enUS)
{
	__FILE__, __LINE__,					// Localization macro
	kKFCPanelWidgetID,					// WidgetID
	kPMRsrcID_None,						// RsrcID
	kBindNone,							// Binding (0=none)
	Frame(0, 0, 300, 360),				// Default size. Resizable (kIsResizable in PanelList), down
										// to a floor of 266 - the width the panel is actually worked
										// at, measured off the running panel. *Lining up with KCM's
										// width when docked together is deliberately GIVEN UP - see
										// KFCPanelMetrics.cpp. This 300 is the size the panel OPENS
										// at, where the opening message takes three lines on a
										// Japanese UI - and FOUR is what the block is sized to hold,
										// at this width and at the floor alike, because the longest
										// message the panel can put up needs them. Both numbers, and
										// the measurements behind them, are in KFCPanelMetrics.cpp.
	kTrue, kTrue,						// Visible, Enabled
	kTrue,								// Erase background (the result tree needs it)
	kInterfacePaletteFill,				// Erase to color
	kFalse,								// Draw dropshadow
	kKFCPanelTitleKey,					// Panel name
	{
		// Status read-out at the top: the search summary (total hits / chapters). WRAPPING over
		// several lines, not one line ellipsized (the author's call): a book search can append the
		// names of chapters it could not open, and the end of the sentence is the part an ellipsis
		// throws away. Bound left/right/top so it widens with the panel and stays put vertically.
		//
		// THE HEIGHT MUST BE A WHOLE NUMBER OF LINES. A line is 12px on an ENGLISH UI (measured off a
		// screenshot: four baselines 11.8px apart), so the block is kKFCMessageLines of them (KFCUIID.h -
		// 48px). The box draws into whatever room it is given: at four lines and 4px over, narrowing the
		// panel pushed the text to five lines and the TOP 4px OF THE FIFTH appeared below the fourth, a
		// sliver of chopped-off letters. A remainder of zero leaves nothing for a part-line to be drawn into.
		//
		// AND THE LINE IS NOT 12px IN EVERY LANGUAGE. On a JAPANESE UI the palette font draws 18px
		// lines (measured on the running panel: baselines at y=218, 236, 254), so a 48px box holds two
		// and two thirds of them. A resource carries one set of numbers and these are the English set;
		// KFCPanelMetrics puts the real height on when the panel appears - four of the palette font's
		// own lines, asked of the font (72 on a Japanese UI), so every language gets FOUR lines - and
		// falls back to this 48 when the font cannot be asked. The numbers are KFCUIID.h's, and it
		// reads the same ones, so the resource and the code cannot drift apart.
		//
		// FOUR LINES, NOT THREE: a 128-character message drew only as far as "the document has" in
		// three lines, losing the sentence that says what to do (see KFCPanelMetrics.cpp, which carries
		// the measurement). If the palette font ever changes size,
		// measure again - the rule is the remainder, not the number 48.
		//
		// DRAWN BY HAND (KFCStatusTextView.cpp), not a StaticMultiLineTextWidget: the stock widget
		// cannot draw two colours in one box, and this box shows a selected GREP row's Preview Text - what
		// its Replace would write, at full colour between the row's context faded. The same move KCM made
		// with its own message area (kKCMStatusTextWidgetBoss). The WidgetID, the Frame, the binding and
		// the way messages arrive (KFCResultTree::ShowStatus) are the stock widget's, so KFCPanelMetrics'
		// 72px and the illustrations sitting on the block's bottom edge did not move.
		// ! The stock fields are gone: the alignment (always left), the ellipsize style (a wrapping box
		//   has no "one line"; the view ends a message that does not fit with an ellipsis), the
		//   ampersand flag (kFalse in the drawing - no more doubling), the font (the rows' system-script
		//   palette font) and the LINE COUNT (as many whole lines as the height holds - 4 in both
		//   languages at the heights above). The initial text is written when the panel is shown
		//   (KFCResultTree::RestoreStatusOnPanelShow), as it always was in effect.
		KFCStatusTextWidget
		(
			kKFCStaticTextWidgetID,			 // WidgetId
			kPMRsrcID_None,					 // RsrcId
			kBindLeft | kBindRight | kBindTop, // Frame binding
			Frame(5, kKFCMessageTop, 256, kKFCMessageBottom),	// Frame: left, top, right, bottom (KFCUIID.h)
			kTrue, kTrue,					 // Visible, Enabled
			"",								 // Panel name (none)
			{
			}
		),

		/* The panel's illustration, to the right of the message: hover it for the plug-in's home
		 * page, click it to go there (KFCIconTip supplies the tip text, the panel's own observer
		 * hears the click). Bound RIGHT so it keeps its place beside the message as the panel is
		 * resized (KCM's resizable panel binds its own right for the same reason).
		 *
		 * 32x32, sitting on the BOTTOM of the message block (top = kKFCMessageBottom - 32): a picture
		 * hanging off the top of a part-empty message box reads as detached from it. The two share a
		 * bottom edge, and that is the whole of why the top is what it is.
		 *
		 * THE PICTURES, STACKED at one frame: the plain cat until something has been run, the
		 * searching cat once it has, and the changing cat once a Change All has written something.
		 * KFCPanelIcon owns which - it is the only place that names them, so another picture is a
		 * widget here and a row there. All but the first come up HIDDEN; KFCPanelIcon writes the real
		 * answer when the panel appears, because these widgets are rebuilt on every show and a
		 * default written here would otherwise outrank the actual state.
		 * ONE frame for the three, named once below: KFCPanelMetrics::Update moves each down for the UI language
		 * keeping its own left, right and height, so frames that drifted apart would show the pictures apart.
		 */
#define kKFCIconFrame Frame(260, kKFCMessageBottom - 32, 292, kKFCMessageBottom)	// 4px clear of the text, 8px in from the panel's edge
		KFCIconWidget
		(
			kKFCIconWidgetID,
			kKFCIconResID, kKFCUIPluginID,
			kBindRight | kBindTop,
			kKFCIconFrame,
			kTrue, kTrue,
			kADBEIconSuiteButtonType,
		),
		KFCIconWidget
		(
			kKFCIconFoundWidgetID,
			kKFCIconFoundResID, kKFCUIPluginID,
			kBindRight | kBindTop,
			kKFCIconFrame,
			kFalse, kTrue,
			kADBEIconSuiteButtonType,
		),
		KFCIconWidget
		(
			kKFCIconChangedWidgetID,
			kKFCIconChangedResID, kKFCUIPluginID,
			kBindRight | kBindTop,
			kKFCIconFrame,
			kFalse, kTrue,
			kADBEIconSuiteButtonType,
		),

		// Result tree: the result rows, filling the rest of the panel and bound to all four
		// edges so it grows with the window. Root hidden, multiple selection (below), vertical
		// scroll bar only; scroll increments = one 19px row.
		KFCResultListWidget
		(
			kKFCResultListWidgetID, kPMRsrcID_None,	// WidgetId, RsrcId
			kBindAll,						// Frame binding: grow with the panel
			Frame(4, kKFCMessageBottom + kKFCGapUnderMessage, 296, 356),	// Frame (below the message block
											// to the panel's edges, the gap under it - KFCUIID.h)
			kTrue, kTrue,					// Visible, Enabled
			kTrue,							// EraseBeforeDraw
			kInterfacePaletteFill,			// InterfaceColor
			"",								// Panel name
			kHideRootNode,					// Options: the root is not a row
			kFalse,							// Use H scroll bar
			kTrue,							// Use V scroll bar
			kKFCResultRowHeight,			// fVScrollButtonIncrement (one row)
			kKFCResultRowHeight,			// fVThumbScrollIncrement
			kKFCResultRowHeight,			// fHScrollButtonIncrement (unused, no H bar)
			kKFCResultRowHeight,			// fHThumbScrollIncrement
			2,								// Items selectable: 2 = multiple selection (hit rows together,
											// KFCResultTreeController.cpp, which sets the same three again)
			kTrue,							// Allow children from multiple parents to be selected: yes - the rows of
											// two stories or two documents (KFC's own rule keeps one kind)
			kTrue,							// Allow discontiguous selection: Ctrl+click
			{
			},
		),
	}

	kKFCInternalPopupMenuNameKey		// Popup menu name (internal)
};

/*
 * One BRANCH row of the result tree - book, document and story alike - created at runtime by
 * KFCResultListWidgetMgr for every node that is not a hit: a stock expander arrow (hidden by the
 * widget manager on a childless row) and the "<name>  (R/N)" label after the expander's zone. The widget manager
 * owns the runtime layout; these frames are only the default state.
 */
resource KFCResultNodeWidget(kKFCResultChapterNodeWidgetRsrcID + index_enUS)
{
	__FILE__, __LINE__,
	kKFCResultChapterNodeWidgetID, kPMRsrcID_None,	// WidgetId, RsrcId
	kBindLeft | kBindRight,				// Frame binding: follow the list's width
	Frame(0, 0, 296, kKFCResultRowHeight),	// Frame (left, top, right, bottom)
	kTrue, kTrue,						// Visible, Enabled
	"",									// Panel name
	{
		// The expand / collapse arrow (stock part; the tree framework owns its clicks and its
		// collapsed / expanded state icon). Field-for-field the paneltreeview sample's.
		TreeExpanderWidget
		(
			kTreeNodeExpanderWidgetID,		// WidgetId
			kTreeBranchCollapsedRsrcID,		// RsrcId for collapsed node icon
			kApplicationRsrcPluginID,		// RsrcPlugin for collapsed node icon
			kBindNone,						// Frame binding
			Frame(2, 1, 18, 17),			// Frame (inside the 19px row)
			kTrue, kTrue,					// Visible, Enabled
			kTreeBranchExpandedRsrcID, 		// RsrcId for expanded node icon
			kApplicationRsrcPluginID,		// RsrcPlugin for expanded node icon
			kTrue,							// Cmd-Click expands/collapses children
			kFalse,							// Scroll to show children when expanded
			kIconNoCentering,
			kIconRaisedLook,				// Icon look
			kFalse							// Draws a well
		),

		InfoStaticTextWidget
		(
			kKFCResultChapterLabelWidgetID,	// WidgetId
			kPMRsrcID_None,					// RsrcId
			kBindLeft | kBindRight,			// Frame binding: take the rest of the row
			Frame(18, 1, 292, 17),			// Frame
			kTrue, kTrue,					// Visible, Enabled
			kAlignLeft,						// Alignment
			kEllipsizeEnd, kTrue,			// Ellipsize style, Convert ampersands
			"",								// Text Control Data
			0,								// WidgetId for associated control for shortcut focus
			kPaletteWindowSystemScriptFontId, kPaletteWindowSystemScriptFontId,
		),
	}
};

