/*
 * THE KOHAKU TAB'S OFFER TO FIND/CHANGE (KFCKohakuTab.cpp): IDList names the dialog (its service - FindChangeID.h); IDListPair
 * the same, with the view to build and the plug-in that owns it. Both under the id the face's IPanelCreator hands back.
 */
resource IDList (kKFCKohakuTabIDListRsrcID)
{
	{
		kFindChangeMiniTabbedDialogService,
	},
};

resource IDListPair (kKFCKohakuTabIDListRsrcID)
{
	{
		kFindChangeMiniTabbedDialogService,	// the dialog (InDesign's)
		kKFCKohakuTabRsrcID,				// the view to add (ours)
		kKFCUIPluginID						// the plug-in that owns it (ours)
	},
};

type KFCKohakuTabPanelWidget (kViewRsrcType) : PrimaryResourcePanelWidget (ClassID = kKFCKohakuTabPanelBoss)
{
	WidgetEveInfo;
};

resource LocaleIndex (kKFCKohakuTabRsrcID)
{
	kViewRsrcType,
	{
		kWildFS, k_Wild, kKFCKohakuTabRsrcID + index_enUS
	}
};

/*
 * THE FACE: Find: and Search: over the part Find: chooses, the parts stacked one on another (KFCKohakuTab.cpp shows one and hides and disables the others). No Done: the dialog's frame has one on every
 * tab (QR-24 - measured).
 * LAID OUT AS INDESIGN'S OWN FACES (the author's call: "match the Object tab's button sizes and positions" - measured on its Object tab, the face 486 x 356): a margin of 15 all round; the left part
 * 330 wide - "Find:" and "Search:" (55, no room beside them: the author's call) and their lists (170) in a row each, 5 apart - and 10 to the buttons' column, whose button is 116 x 26 from the top right
 * (15 + 330 + 10 + 116 + 15 = 486, the face's width).
 */
resource KFCKohakuTabPanelWidget (kKFCKohakuTabRsrcID + index_enUS)
{
	__FILE__, __LINE__,					// Localization macro
	kKFCKohakuTabPanelWidgetID,			// WidgetId - the face the dialog's switcher names
	kPMRsrcID_None,						// RsrcId
	kBindNone,							// Frame binding (EVE decides the frame)
	Frame(0, 0, 0, 0),					// Frame
	kTrue,								// Visible
	kTrue,								// Enabled
	kKFCKohakuTabTitleKey,				// Panel name - the tab's label
	{
		// ----- the head: Find: and Search:, and the QR Code part's Find Next -----
		EVEGenericPanelWidget
		(
			kInvalidWidgetID, kPMRsrcID_None,
			kBindNone,
			Frame(0, 0, 456, 0)
			kTrue, kTrue,
			kEVEAlignLeft | kEVELargeSpaceAfter | kEVEArrangeChildrenInRow | kEVENoMargin,
			{
				EVEGenericPanelWidget
				(
					kInvalidWidgetID, kPMRsrcID_None,
					kBindNone,
					Frame(0, 0, 330, 0)
					kTrue, kTrue,
					kEVEAlignLeft | kEVELargeSpaceAfter | kEVEArrangeChildrenInColumn | kEVENoMargin,
					{
						// Find: [QR Code]
						EVEGenericPanelWidget
						(
							kInvalidWidgetID, kPMRsrcID_None,
							kBindNone,
							Frame(0, 0, 230, 21)
							kTrue, kTrue,
							kEVEAlignLeft | kEVERegularSpaceAfter | kEVEArrangeChildrenInRow | kEVENoMargin,
							{
								EVEStaticTextWidget
								(
									kInvalidWidgetID, kSysStaticTextPMRsrcId, kBindNone,
									Frame(0, 0, 55, 21)
									kTrue, kTrue, kAlignLeft,
									kDontEllipsize, kTrue,
									kKFCKohakuFindLabelKey,		// "Find:"
									0,
									kEVERegularSpaceAfter,
								),
								EVEDropDownListWidget
								(
									kKFCKohakuTabKindWidgetID, kSysDropDownPMRsrcId, kBindNone,
									Frame(0, 0, 170, 21)
									kTrue, kTrue,
									{{
										kKFCKohakuTabQRCodeKey,
										kKFCKohakuTabTableKey,
									}}
									kEVENoSpaceAfter,
								),
							}
						),
						// (the left part's width, the lists being narrower: what keeps Find Next at the top right)
						KFCQueryFixedTextWidget
						(
							kInvalidWidgetID, kSysStaticTextPMRsrcId, kBindNone,
							Frame(0, 0, 330, 1)
							kTrue, kTrue, kAlignLeft,
							kEllipsizeEnd, kFalse,
							"",
							kInvalidWidgetID
							kEVENoSpaceAfter,
						),
						// Search: [Document] - its three more for what stands in a story's text: KFCKohakuTab.cpp's ShowScopeEntries
						EVEGenericPanelWidget
						(
							kInvalidWidgetID, kPMRsrcID_None,
							kBindNone,
							Frame(0, 0, 230, 21)
							kTrue, kTrue,
							kEVEAlignLeft | kEVENoSpaceAfter | kEVEArrangeChildrenInRow | kEVENoMargin,
							{
								EVEStaticTextWidget
								(
									kInvalidWidgetID, kSysStaticTextPMRsrcId, kBindNone,
									Frame(0, 0, 55, 21)			// the faces' label (their "Search (S) :")
									kTrue, kTrue, kAlignLeft,
									kDontEllipsize, kTrue,
									kKFCKohakuTabSearchKey,		// "Search:"
									0,
									kEVERegularSpaceAfter,
								),
								EVEDropDownListWidget
								(
									kKFCKohakuTabScopeWidgetID, kSysDropDownPMRsrcId, kBindNone,
									Frame(0, 0, 170, 21)		// the faces' Search: list
									kTrue, kTrue,
									{{
										kKFCKohakuTabAllDocumentsKey,
										kKFCKohakuDocumentKey,
									}}
									kEVENoSpaceAfter,
								),
							}
						),
					}
				),
				// the buttons' column: Find Next, as the faces' Find Next (116 x 26, top right). THE STRUT UNDER IT holds the column's size: once, in a long session, the column stood 0 x 0 with Find Next outside it, visible,
				// enabled and taking no click (2026-10-31). What brought it on is not known - the flows tried do not - so this guards, it does not cure.
				EVEGenericPanelWidget
				(
					kInvalidWidgetID, kPMRsrcID_None,
					kBindNone,
					Frame(0, 0, 116, 26)
					kTrue, kTrue,
					kEVEAlignLeft | kEVENoSpaceAfter | kEVEArrangeChildrenStacked | kEVENoMargin,
					{
						KFCQueryFixedTextWidget
						(
							kInvalidWidgetID, kSysStaticTextPMRsrcId, kBindNone,
							Frame(0, 0, 116, 26)
							kTrue, kTrue, kAlignLeft,
							kEllipsizeEnd, kFalse,
							"",
							kInvalidWidgetID
							kEVENoSpaceAfter,
						),
						EVEButtonWidget
						(
							kKFCQRTabFindNextWidgetID,	// WidgetId
							kSysButtonPMRsrcId,			// RsrcId
							kBindNone,					// Frame binding
							Frame(0, 0, 116, 26)		// Frame
							kTrue, kTrue,				// Visible, Enabled
							kKFCQRTabFindNextKey,		// "Find Next"
							kEVENoSpaceAfter,
						),
					}
				),
			}
		),
		// ----- the part Find: chooses -----
		EVEGenericPanelWidget
		(
			kInvalidWidgetID, kPMRsrcID_None,
			kBindNone,
			Frame(0, 0, 456, 0)
			kTrue, kTrue,
			kEVEAlignLeft | kEVENoSpaceAfter | kEVEArrangeChildrenStacked | kEVENoMargin,
			{
				// QR CODE (QR-02): the two lines Find Next speaks on (the panel's own line is the panel's - Find Next says what it found where the person is looking): what it found, then why it could
				// not select it - one line each, as a static text is one line and cut at its end: a long content cuts its own line only. Each line is the query dialog's fixed-size text, so a long
				// sentence does not grow the dialog.
				EVEGenericPanelWidget
				(
					kKFCKohakuQRSectionWidgetID, kPMRsrcID_None,
					kBindNone,
					Frame(0, 0, 456, 0)
					kTrue, kTrue,
					kEVEAlignLeft | kEVENoSpaceAfter | kEVEArrangeChildrenInColumn | kEVENoMargin,
					{
						KFCQueryFixedTextWidget
						(
							kKFCQRTabStatusWidgetID,	// WidgetId - what Find Next found (KFCKohakuTab.cpp)
							kSysStaticTextPMRsrcId,		// RsrcId
							kBindNone,					// Frame binding
							Frame(0, 0, 456, 20)		// Frame - the size it gets, not a floor (kKFCQueryFixedTextWidgetBoss)
							kTrue, kTrue, kAlignLeft,	// Visible, Enabled, Alignment
							kEllipsizeEnd, kFalse,		// Ellipsize style (a sentence is read from the front), Convert ampersands
							"",							// Text (Find Next fills it; empty at every launch)
							kInvalidWidgetID			// Associated control (none)
							kEVEAlignFill | kEVENoSpaceAfter,
						),
						KFCQueryFixedTextWidget
						(
							kKFCQRTabNoteWidgetID,		// WidgetId - why Find Next could not select it (KFCKohakuTab.cpp)
							kSysStaticTextPMRsrcId,		// RsrcId
							kBindNone,					// Frame binding
							Frame(0, 0, 456, 20)		// Frame
							kTrue, kTrue, kAlignLeft,	// Visible, Enabled, Alignment
							kEllipsizeEnd, kFalse,		// Ellipsize style, Convert ampersands
							"",							// Text (empty when it was selected)
							kInvalidWidgetID			// Associated control (none)
							kEVEAlignFill | kEVENoSpaceAfter,
						),
					}
				),
				// TABLE: each list under its words (the author's call), long enough for a group's path. No Find Next (the design's T13): the two lines at the foot say where the finding is done.
				EVEGenericPanelWidget
				(
					kKFCKohakuTableSectionWidgetID, kPMRsrcID_None,
					kBindNone,
					Frame(0, 0, 456, 0)
					kTrue, kTrue,
					kEVEAlignLeft | kEVENoSpaceAfter | kEVEArrangeChildrenInColumn | kEVENoMargin,
					{
						EVEStaticTextWidget
						(
							kInvalidWidgetID, kSysStaticTextPMRsrcId, kBindNone,
							Frame(0, 0, 330, 21)
							kTrue, kTrue, kAlignLeft,
							kDontEllipsize, kTrue,
							kKFCTableTabFindStyleKey,
							0,
							kEVESmallSpaceAfter,
						),
						EVEDropDownListWidget
						(
							kKFCTableTabFindStyleWidgetID, kSysDropDownPMRsrcId, kBindNone,
							Frame(0, 0, 330, 21)
							kTrue, kTrue,
							{{
								kKFCTableTabAnyStyleKey,	// entry 0 - the styles after it (KFCKohakuTab.cpp's FillStyles)
							}}
							kEVERegularSpaceAfter,
						),
						EVECheckBoxWidget
						(
							kKFCTableTabOverridesOnlyWidgetID, kSysCheckBoxPMRsrcId, kBindNone,
							Frame(0, 0, 200, 19)
							kTrue, kTrue, kAlignLeft,
							kKFCTableTabOverridesOnlyKey,
							kEVELargeSpaceAfter,
						),
						EVEStaticTextWidget
						(
							kInvalidWidgetID, kSysStaticTextPMRsrcId, kBindNone,
							Frame(0, 0, 330, 21)
							kTrue, kTrue, kAlignLeft,
							kDontEllipsize, kTrue,
							kKFCTableTabChangeStyleKey,
							0,
							kEVESmallSpaceAfter,
						),
						EVEDropDownListWidget
						(
							kKFCTableTabChangeStyleWidgetID, kSysDropDownPMRsrcId, kBindNone,
							Frame(0, 0, 330, 21)
							kTrue, kTrue,
							{{
								kKFCTableTabLeaveStyleKey,	// entry 0 - the styles after it (KFCKohakuTab.cpp's FillStyles)
							}}
							kEVERegularSpaceAfter,
						),
						EVECheckBoxWidget
						(
							kKFCTableTabClearOverridesWidgetID, kSysCheckBoxPMRsrcId, kBindNone,
							Frame(0, 0, 200, 19)
							kTrue, kTrue, kAlignLeft,
							kKFCTableTabClearOverridesKey,
							kEVELargeSpaceAfter,
						),
						KFCQueryFixedTextWidget
						(
							kInvalidWidgetID, kSysStaticTextPMRsrcId, kBindNone,
							Frame(0, 0, 456, 20)
							kTrue, kTrue, kAlignLeft,
							kEllipsizeEnd, kFalse,
							kKFCTableTabGuideFindKey,
							kInvalidWidgetID
							kEVEAlignFill | kEVENoSpaceAfter,
						),
						KFCQueryFixedTextWidget
						(
							kInvalidWidgetID, kSysStaticTextPMRsrcId, kBindNone,
							Frame(0, 0, 456, 20)
							kTrue, kTrue, kAlignLeft,
							kEllipsizeEnd, kFalse,
							kKFCTableTabGuideReplaceKey,
							kInvalidWidgetID
							kEVEAlignFill | kEVENoSpaceAfter,
						),
					}
				),
				// RUBY: the labels one width so the fields stand in a line. The text fields notify at every key stroke: the panel's Find may be pressed with one still focused (KFCKohakuTab.h).
				EVEGenericPanelWidget
				(
					kKFCKohakuRubySectionWidgetID, kPMRsrcID_None,
					kBindNone,
					Frame(0, 0, 456, 0)
					kTrue, kTrue,
					kEVEAlignLeft | kEVENoSpaceAfter | kEVEArrangeChildrenInColumn | kEVENoMargin,
					{
						// Look For: [Text With Ruby]
						EVEGenericPanelWidget
						(
							kInvalidWidgetID, kPMRsrcID_None,
							kBindNone,
							Frame(0, 0, 456, 21)
							kTrue, kTrue,
							kEVEAlignLeft | kEVERegularSpaceAfter | kEVEArrangeChildrenInRow | kEVENoMargin,
							{
								EVEStaticTextWidget
								(
									kInvalidWidgetID, kSysStaticTextPMRsrcId, kBindNone,
									Frame(0, 0, 110, 21)
									kTrue, kTrue, kAlignLeft,
									kDontEllipsize, kTrue,
									kKFCRubyTabLookForKey,
									0,
									kEVERegularSpaceAfter,
								),
								EVEDropDownListWidget
								(
									kKFCRubyTabKindWidgetID, kSysDropDownPMRsrcId, kBindNone,
									Frame(0, 0, 170, 21)
									kTrue, kTrue,
									{{
										kKFCRubyTabWithKey,
										kKFCRubyTabWithoutKey,
										kKFCRubyTabMarksKey,
									}}
									kEVENoSpaceAfter,
								),
							}
						),
						// Base Text: [ ]
						EVEGenericPanelWidget
						(
							kInvalidWidgetID, kPMRsrcID_None,
							kBindNone,
							Frame(0, 0, 456, 21)
							kTrue, kTrue,
							kEVEAlignLeft | kEVERegularSpaceAfter | kEVEArrangeChildrenInRow | kEVENoMargin,
							{
								EVEStaticTextWidget
								(
									kInvalidWidgetID, kSysStaticTextPMRsrcId, kBindNone,
									Frame(0, 0, 110, 21)
									kTrue, kTrue, kAlignLeft,
									kDontEllipsize, kTrue,
									kKFCRubyTabBaseKey,
									0,
									kEVERegularSpaceAfter,
								),
								EVETextEditBoxWidget
								(
									kKFCRubyTabBaseWidgetID, kSysEditBoxPMRsrcId, kBindNone,
									Frame(0, 0, 300, 0)		// a height of 0: the field's own
									kTrue, kTrue,
									kInvalidWidgetID,		// Nudge control (none)
									1.0, 10.0,				// Small / large nudge
									0,						// Max chars (no limit)
									kFalse,					// Read only
									kTrue,					// Notify every key stroke
									kFalse,					// Range checking
									kTrue,					// Blank entry allowed
									0, 0,					// Upper / lower limits
									"",						// Initial text (the face fills it)
									kEVENoSpaceAfter,
								),
							}
						),
						// Ruby: [ ]
						EVEGenericPanelWidget
						(
							kInvalidWidgetID, kPMRsrcID_None,
							kBindNone,
							Frame(0, 0, 456, 21)
							kTrue, kTrue,
							kEVEAlignLeft | kEVELargeSpaceAfter | kEVEArrangeChildrenInRow | kEVENoMargin,
							{
								EVEStaticTextWidget
								(
									kInvalidWidgetID, kSysStaticTextPMRsrcId, kBindNone,
									Frame(0, 0, 110, 21)
									kTrue, kTrue, kAlignLeft,
									kDontEllipsize, kTrue,
									kKFCRubyTabReadingKey,
									0,
									kEVERegularSpaceAfter,
								),
								EVETextEditBoxWidget
								(
									kKFCRubyTabReadingWidgetID, kSysEditBoxPMRsrcId, kBindNone,
									Frame(0, 0, 300, 0)
									kTrue, kTrue,
									kInvalidWidgetID,
									1.0, 10.0,
									0,
									kFalse,
									kTrue,
									kFalse,
									kTrue,
									0, 0,
									"",
									kEVENoSpaceAfter,
								),
							}
						),
						// Change Ruby To: [ ]
						EVEGenericPanelWidget
						(
							kInvalidWidgetID, kPMRsrcID_None,
