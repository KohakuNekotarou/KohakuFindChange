/*
 * Plugin version definition.
 */
resource PluginVersion (kSDKDefPluginVersionResourceID)
{
	kTargetVersion,
	kKFCUIPluginID,
	kSDKDefPlugInMajorVersionNumber, kSDKDefPlugInMinorVersionNumber,
	kSDKDefHostMajorVersionNumber, kSDKDefHostMinorVersionNumber,
	kKFCUICurrentMajorFormatNumber, kKFCUICurrentMinorFormatNumber,
	{ kInDesignProduct },
	{ kWildFS },
	kUIPlugIn,
	kKFCVersion			// one version for both halves (KFCBoundaryID.h)
};

/*
 * The ExtraPluginInfo resource adds extra information to the Missing Plug-in dialog.
 */
resource ExtraPluginInfo(1)
{
	kKFCCompanyValue,			// Company name (KFCBoundaryID.h - the same publisher for both halves)
	kKFCUIMissingPluginURLValue,	// URL
	kKFCUIMissingPluginAlertValue,	// Missing plug-in alert text
};

/*
 * This half does not stand on its own: the panel's rows, its commands and its status all come from
 * the model half through the three session interfaces (IKFCResults / IKFCRuns / IKFCChapters). Guide
 * gs-03 - a UI plug-in makes no sense without its model half - so say so and let InDesign enforce the
 * load order and report the missing half. The SDK's shape (transparencyeffectui/TranFxUI.fr), and KCM's.
 * The dependency is ONE-WAY: the model half declares none, and has to keep working on its own.
 */
resource PluginDependency(kSDKDefPluginDependencyResourceID)
{
	kWildFS
	{
		kKFCPluginID,			// the model half's PluginID (KFCBoundaryID.h)
		kKFCPluginName,			// "KohakuBookSearch" (KFCBoundaryID.h)
		kSDKDefPlugInMajorVersionNumber,
		kSDKDefPlugInMinorVersionNumber,
	}
}

/*
 * Boss class definitions.
 */
resource ClassDescriptionTable(kSDKDefClassDescriptionTableResourceID)
{{{


	/*
	 * The plug-in's menu commands. It inherits kBaseActionComponentBoss, which is what EVERY action
	 * component in the product does - layerpanel/LayerPanelClass.fr:403, spellpanel:339,
	 * linksui:170 and :178, buttonui:103 - and what the samples do (basicpanel/BscPnl.fr:92).
	 *
	 * What the parent brings, read off the running application's object model (debug-boss-registry/
	 * IObjectModel_RomanFS.txt:492-493, kAboutMenuComponentBoss): IID_IPMPERSIST (kPMPersistImpl)
	 * AND IID_NEVERWRITESTODOCUMENT (kNeverWritesToDocumentImpl).
	 *
	 * Not kInvalidClass with IID_IPMPERSIST written out by hand - the shape candlechartui/CdlChtUI.fr:93
	 * has. That shape runs, but it is missing the second interface, and the product's form gives both
	 * without spelling either out.
	 *
	 * @ingroup kohakubooksearch
	 */
	Class
	{
		kKFCActionComponentBoss,
		kBaseActionComponentBoss,
		{
			// Handle the actions from the menu. The rest comes from the parent boss above.
			IID_IACTIONCOMPONENT, kKFCActionComponentImpl,
		}
	},

    /*
	 * This boss class inherits from an API panel boss class, and
	 * adds an interface to control a pop-up menu on the panel.
	 * The implementation for this interface is provided by the API.
     *
	 * 
	 * @ingroup kohakubooksearch
	 */
	Class
	{
		kKFCPanelWidgetBoss,
		kPalettePanelWidgetBoss,
		{
			/*
			 * The plug-in's implementation of ITextControlData with an exotic IID of IID_IPANELMENUDATA.
			 * Implementation provided by the API.
			 */
			IID_IPANELMENUDATA, kCPanelMenuDataImpl,
			/*
			 * The panel's observer (KFCPanelTitle.cpp): what has to be written on each time the panel
			 * is shown, because the panel is rebuilt every time - the tab's name, the layout for the
			 * UI language, the picture, the message - and, while it is up, the picture's click and
			 * what the tab's name follows (the Find/Change settings and the selection: it is an
			 * ActiveSelectionObserver).
			 */
			IID_IOBSERVER, kKFCPanelObserverImpl,
			/*
			 * The panel's view replaced: PalettePanelView plus a floor under how small the panel can
			 * be dragged, and a height rounded down to whole result rows, both through
			 * ConstrainDimensions. See KFCPanelView.cpp - the same shape KESCL uses, which took it
			 * from customconditionaltextui.
			 */
			IID_ICONTROLVIEW, kKFCPanelViewImpl,
			/*
			 * Roll-over (ported from KCM): while the "Translucent Panel" toggle is ON, the panel goes
			 * back to solid with the pointer on it. Verified over the whole panel area in KCM.
			 * Note that IMouseRollOver has no usage example anywhere in the SDK; besides this AddIn
			 * it needs CREATE_PMINTERFACE *and* an entry in KFCUIFactoryList.h - a missing factory
			 * entry fails completely silently. Implementation: KFCPanelAlpha.cpp.
			 */
			IID_IMOUSEROLLOVER, kKFCPanelRollOverImpl,
		}
	},

	/*
	 * The panel's illustration: the system rollover icon button plus a tooltip of our own, so
	 * hovering the picture says where clicking it goes. Nothing else is added - the click itself is
	 * heard by the panel's observer (KFCPanelTitle.cpp), which is already there.
	 *
	 * Same shape as kLinksUIButtonBoss in open/components/linksui, and as KCM's
	 * kKCMIconWidgetBoss - which is where this panel's layout comes from.
	 */
	Class
	{
		kKFCIconWidgetBoss,
		kRollOverIconButtonBoss,
		{
			IID_ITIP, kKFCIconTipImpl,
		}
	},

	/*
	 * Result tree list: the tree-view widget carrying our hierarchy adapter and row
	 * widget manager. The framework provides the tree controller and default event handling
	 * (selection, expand/collapse); the row-click jump handler is the row's (kKFCResultNodeWidgetBoss, below).
	 */
	Class
	{
		kKFCResultListWidgetBoss,
		kTreeViewWidgetBoss,
		{
			IID_ITREEVIEWHIERARCHYADAPTER, kKFCResultListAdapterImpl,
			IID_ITREEVIEWWIDGETMGR, kKFCResultListWidgetMgrImpl,
			/* Extends the stock handler so the up / down arrows OPEN the row they land on and run
			   that row's action - see KFCResultTreeEH.cpp. A book search comes up with every
			   chapter closed, and the stock keys walk visible rows only.
			   NOTE: this line alone does not create the handler. Implementations are made on first
			   QueryInterface, and the one that asks is KFCResultNodeEH's key-focus hand-off. */
			IID_IEVENTHANDLER, kKFCResultTreeEHImpl,
		}
	},

	/*
	 * The hit line's multi-colour text cell: a generic panel widget whose IControlView
	 * is our self-drawing view (KFCColorTextView), plus the per-row draw data it paints.
	 */
	Class
	{
		kKFCColorTextWidgetBoss,
		kGenericPanelWidgetBoss,
		{
			IID_ICONTROLVIEW, kKFCColorTextViewImpl,
			IID_IKFCROWDATA, kKFCRowDataImpl,
		}
	},

	/*
	 * The panel's MESSAGE AREA, built the same way as the cell above and for the same
	 * reason: a replaced row, once selected, shows its text as it was BEFORE the replace here, and
	 * "which characters were replaced" is a question one colour cannot answer (KFCStatusTextView.cpp).
	 * Brought over from KCM, whose kKCMStatusTextWidgetBoss replaced the same stock widget.
	 * ! No ITextControlData of our own: the one kGenericPanelWidgetBoss carries is persistent, and the
	 *   data implementation writes the message into it for a reader that walks the widgets.
	 */
	Class
	{
		kKFCStatusTextWidgetBoss,
		kGenericPanelWidgetBoss,
		{
			IID_ICONTROLVIEW, kKFCStatusTextViewImpl,
			IID_IKFCSTATUSTEXTDATA, kKFCStatusTextDataImpl,
		}
	},

	/*
	 * Result tree row: the node boss carries the click handler that jumps to a hit.
	 * Shared by the chapter and hit row resources; the handler tells them apart by the node index
	 * (only hit rows jump).
	 */
	Class
	{
		kKFCResultNodeWidgetBoss,
		kTreeNodeWidgetBoss,
		{
			IID_IEVENTHANDLER, kKFCResultNodeEHImpl,
		}
	},

	/*
	 * Marker-expiry idle task boss: a one-shot idle task, armed each time the marker is
	 * shown, that takes it back off the screen a second later. IID_IIDLETASK comes from ShuksanID.h.
	 */
	Class
	{
		kKFCMarkerExpiryIdleTaskBoss,
		kInvalidClass,
		{
			IID_IIDLETASK, kKFCMarkerExpiryIdleTaskImpl,
		}
	},

	/*
	 * The UI half's startup/shutdown service boss (KFCUIStartupShutdown.cpp): the saved settings, the
	 * windows the panel follows, the marker's countdown and the ear on the model half. A boss of its own
	 * because a startup/shutdown service is declared per boss. UI code, so this half's; lazy here.
	 */
	Class
	{
		kKFCUIStartupShutdownBoss,
		kInvalidClass,
		{
			IID_ISTARTUPSHUTDOWN, kKFCUIStartupShutdownImpl,
			IID_IK2SERVICEPROVIDER, kLazyStartupShutdownProviderImpl,
		}
	},

	/*
	 * The UI half's ear on the model half: the observer that draws what KFCModelNotify.h sends on the
	 * session's subject. Attached by the startup (KFCModelObserver.cpp); this line only puts our IID, and
	 * so the implementation, onto the session. An AddIn that points at UI code, in this half's resource.
	 */
	AddIn
	{
		kSessionBoss,
		kInvalidClass,
		{
			IID_IKFCMODELOBSERVER, kKFCModelObserverImpl,
		}
	},

	/*
	 * What the model half asks the UI half for (IKFCUIServices.h): the progress bar, the windows, the
	 * Book panel's front tab and the alert. A UI implementation on a model boss, which the guide allows
	 * only through an AddIn in the UI plug-in's resource (vol1-07, Object-Model Rule 2) - and which a
	 * background thread does not see, where the model does without.
	 */
	AddIn
	{
		kSessionBoss,
		kInvalidClass,
		{
			IID_IKFCUISERVICES, kKFCUIServicesImpl,
		}
	},

	/*
	 * Panel visibility observer (ported from KCM). Subscribes to the panel
	 * manager's subject and waits for kPaletteVisibilityChangedMessage, which fires whenever a panel
	 * is opened, closed, restored from an icon or drawer-expanded. The "Translucent Panel" toggle
	 * puts its alpha on the panel's CURRENT top-level window (an OWL.Dock), and that window is thrown
	 * away and recreated by those very actions - so without this the translucency would be silently
	 * lost. The attach itself is in KFCPanelAlpha.cpp; this line only puts our IID, and so the
	 * observer implementation, onto the boss.
	 *
	 * It goes on kActiveContextBoss rather than the kSessionBoss above because that is the proven
	 * arrangement: KCM carries its observers there, this one among them. (A free-floating
	 * observer boss did NOT receive these notifications in practice - see KCMUI.fr.)
	 */
	AddIn
	{
		kActiveContextBoss,
		kInvalidClass,
		{
			IID_IKFCPANELVISIBILITYOBSERVER, kKFCPanelVisibilityObserverImpl,
		}
	},

	/*
	 * "Link the Application Bar's Search Field to This Panel": the observer that makes the
	 * application bar's search field show what Edit > Find/Change holds. On kActiveContextBoss for the same
	 * reason as the one above; attached to the Find/Change settings while the toggle is ON
	 * (KFCAppBarSearchEnter.cpp). An AddIn that points at UI code, in this half's resource.
	 */
	AddIn
	{
		kActiveContextBoss,
		kInvalidClass,
		{
			IID_IKFCAPPBARMIRROROBSERVER, kKFCAppBarMirrorObserverImpl,
		}
	},

	/*
	 * "Remember Book Panel Placement": the observer that puts InDesign's own Book panel
	 * back where it was when it appears (kPaletteVisibilityChangedMessage, on the panel manager's
	 * subject - the subject the observer above listens to). Measuring it as it closes is the command
	 * interceptor's job further down: a closing book says nothing on this subject (measured).
	 * On kActiveContextBoss for the same reason as the one above. The attach
	 * itself is in KFCBookPanelPlacement.cpp; this line only puts our IID onto the boss.
	 * An AddIn that points at UI code, in this half's resource.
	 */
	AddIn
	{
		kActiveContextBoss,
		kInvalidClass,
		{
			IID_IKFCBOOKPANELOBSERVER, kKFCBookPanelObserverImpl,
		}
	},

	/*
	 * ...and the service that tells it when to start and stop: kPaletteMgrService, which calls
	 * PaletteMgrStarted once the palettes are laid out and PaletteMgrAboutToShutdown just before
	 * they close (IPaletteMgrService.h). InDesign's own Book panel is the one product user of this
	 * service (kBookPanelStartupShutdownBoss). No stock provider exists for it, hence ours.
	 */
	Class
	{
		kKFCBookPanelServiceBoss,
		kInvalidClass,
		{
			IID_IK2SERVICEPROVIDER, kKFCBookPanelServiceProviderImpl,
			IID_IPALETTEMGRSERVICE, kKFCBookPanelPaletteMgrServiceImpl,
		}
	},

	/*
	 * ...and the command interceptor that catches a book as it is about to close. Measured:
	 * closing a book - by script and by the Book panel's own "Close Book" alike -
	 * destroys its panel without one notification on the panel manager's subject, so the observer
	 * above never hears of it. Created by name and handed to ICommandProcessor::InstallInterceptor
	 * (the shape KIDMCP's command watcher uses); nothing looks it up, so it inherits nothing.
	 * IID_ICOMMANDINTERCEPTOR is CommandID.h's, included above.
	 */
	Class
	{
		kKFCBookPanelCmdWatchBoss,
		kInvalidClass,
		{
			IID_ICOMMANDINTERCEPTOR, kKFCBookPanelCmdWatchImpl,
		}
	},

}}};

/*  
 * Implementation definition.
 */
resource FactoryList (kSDKDefFactoryListResourceID)
{
	kImplementationIDSpace,
	{
		#include "KFCUIFactoryList.h"
	}
};

/*  
 * Menu definition.
 */
resource MenuDef (kSDKDefMenuResourceID)
{
	{
		// The About sub-menu item for this plug-in.
		kKFCAboutActionID,			// ActionID (kInvalidActionID for positional entries)
		kKFCAboutMenuPath,			// Menu Path.
		kSDKDefAlphabeticPosition,											// Menu Position.
		kSDKDefIsNotDynamicMenuFlag,										// kSDKDefIsNotDynamicMenuFlag or kSDKDefIsDynamicMenuFlag

		// ----- The panel's flyout menu -----
		// Written here in the order it is DRAWN. What actually decides that order is each item's
		// position number, and the blocks those numbers form are laid out in KFCUIID.h. The
		// separators' names are in the order they were added, not the order they appear in - the
		// first one written was the rule above About, which is why it is Separator1 down at 10.0.

		// --- Block 1: Find/Change - the search, then the one command that rewrites the documents ---

		// Open Find/Change... (the author's call): InDesign's own Find/Change dialog, opened from here -
		// with no document open as well, where the Edit menu greys it out. Open, type the query, then search.
		kKFCOpenFindChangeActionID,
		kKFCTargetMenuPath
		kKFCOpenFindChangeMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Find in <scope>: run the search over the current scope using the settings in InDesign's own
		// Find/Change dialog. Drawn under the name the scope calls for (see the action definition below).
		kKFCSearchBookActionID,
		kKFCTargetMenuPath
		kKFCSearchBookMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Change All in Book (No List): InDesign's own Change All over the book's chapters, no list (KFCChangeAll).
		// Greyed with Book Scope off (F18 - a document's Change All is InDesign's own dialog's).
		kKFCChangeAllActionID,
		kKFCTargetMenuPath
		kKFCChangeAllMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Clear Results: the list emptied, so Change All can run.
		kKFCClearResultsActionID,
		kKFCTargetMenuPath
		kKFCClearResultsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// (Block 2 - Find Missing Glyphs and Find Overset - is gone: the Book panel's preflight reports both.)

		// Separator between Clear Results and the toggles.
		kKFCSeparator3ActionID,
		kKFCInternalPopupMenuNameKey kSDKDefDelimiterAndSeparatorPath,	// :- to mark an item as a separator.
		kKFCSeparator3MenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// --- Block 3: the check-mark toggles (their positions are in KFCUIID.h) ---

		// Book Scope: toggle (check mark). ON = the whole book, OFF = what Edit > Find/Change's Search:
		// names. Leads the block because it is what the commands in block 1 run on.
		kKFCScopeBookActionID,
		kKFCTargetMenuPath
		kKFCBookScopeMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Hide Previous Chapter: toggle (check mark). Closes the previous chapter window on jump.
		kKFCHidePrevChapterActionID,
		kKFCTargetMenuPath
		kKFCHidePrevChapterMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Link the Application Bar's Search Field to This Panel: toggle (check mark). Return in the search
		// field of InDesign's application bar searches with this panel. *Windows only. KFCAppBarSearchEnter.h.
		// A search toggle, so it comes before the window ones below.
		kKFCAppBarSearchEnterActionID,
		kKFCTargetMenuPath
		kKFCAppBarSearchEnterMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Translucent Find/Change: toggle (check mark) for InDesign's OWN Find/Change dialog.
		// *Windows only.
		kKFCTranslucentFindChangeActionID,
		kKFCTargetMenuPath
		kKFCTranslucentFindChangeMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Minimizable Find/Change: toggle (check mark). Puts a minimize box on InDesign's OWN
		// Find/Change dialog, so it can be sent to the taskbar instead of closed. Directly under
		// the translucency toggle - the two act on the same window. *Windows only.
		kKFCMinimizableFindChangeActionID,
		kKFCTargetMenuPath
		kKFCMinimizableFindChangeMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Translucent Panel: Translucent Find/Change's idea applied to this panel - drawn faint while it
		// floats, and back to solid while the pointer is on it. Under the two that act on InDesign's
		// dialog. *Windows only.
		kKFCTranslucentPanelActionID,
		kKFCTargetMenuPath
		kKFCTranslucentPanelMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Remember Book Panel Placement: toggle (check mark). InDesign's own Book panel comes back
		// where it was closed. Last in the block - it is about a window, like the three above.
		kKFCRememberBookPanelActionID,
		kKFCTargetMenuPath
		kKFCRememberBookPanelMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Separator between the toggles and the command that writes a file.
		kKFCSeparator4ActionID,
		kKFCInternalPopupMenuNameKey kSDKDefDelimiterAndSeparatorPath,	// :- to mark an item as a separator.
		kKFCSeparator4MenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// --- Block 4: the command that writes a file of our own ---

		// Save Panel Settings: write the toggles above to a JSON file of our own in the user's
		// preferences folder, read back at startup. A plain command, not a toggle.
		kKFCSavePanelSettingsActionID,
		kKFCTargetMenuPath
		kKFCSavePanelSettingsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Separator between those and the two reference items that close the menu.
		kKFCSeparator1ActionID,
		kKFCInternalPopupMenuNameKey kSDKDefDelimiterAndSeparatorPath,	// :- to mark an item as a separator.
		kKFCSeparator1MenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// --- Block 5: the two reference items ---

		// "How to Use...": the plug-in's operating reference, in a scrollable dialog (KFCHowTo.cpp).
		// Between the separator and About.
		kKFCHowToActionID,
		kKFCTargetMenuPath
		kKFCHowToMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// About this plug-in sub-menu for the popup menu on the panel
		kKFCPopupAboutThisActionID,
		kKFCTargetMenuPath
		kKFCAboutThisMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ----- A hit row's right-click menu -----
		// Popped by KFCResultNodeEH::RButtonDn over a hit row: Replace replaces that row alone with no
		// prompt.
		kKFCReplaceHitActionID,
		kKFCResultHitMenuName
		kKFCReplaceHitMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

	}
};

/* 
 * Action definition.
 */
resource ActionDef (kSDKDefActionResourceID)
{
	{
		kKFCActionComponentBoss, 		// ClassID of boss class that implements the ActionID.
		kKFCAboutActionID,	// ActionID.
		kKFCAboutMenuKey,	// Sub-menu string.
		// The Help > About Plug-ins entry belongs to the help menu's area, which is what the samples
		// (basicpanel/BscPnl.fr:200) give it. The area only ever
		// matters to the keyboard shortcut editor, and every action here is invisible in it, but
		// this is the classification the SDK puts on this one item. The popup's own "About This
		// Plug-in..." below stays kOtherActionArea - so does basicpanel's (:230).
		kHelpMenuActionArea,			// Area name (see ActionDefs.h).
		kNormalAction,					// Type of action (see ActionDefs.h).
		kDisableIfLowMem,				// Enabling type (see ActionDefs.h).
		kInvalidInterfaceID,			// Selection InterfaceID this action cares about or kInvalidInterfaceID.
		kSDKDefInvisibleInKBSCEditorFlag, // kSDKDefVisibleInKBSCEditorFlag or kSDKDefInvisibleInKBSCEditorFlag.

		kKFCActionComponentBoss,
		kKFCPopupAboutThisActionID,
		kSDKDefAboutThisPlugInMenuKey,	// Key to the name of this action
		kOtherActionArea,
		kNormalAction,
		kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Open Find/Change.... NOT kDisableIfNoFrontDocument - opening the dialog with no document is the
		// point of it. In the Keyboard Shortcuts editor under Palette Menus (the author's call), like the
		// search below.
		kKFCActionComponentBoss,
		kKFCOpenFindChangeActionID,
		kKFCOpenFindChangeMenuKey,		// "Open Find/Change..."
		kKFCPanelMenuActionArea,
		kNormalAction,
		kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefVisibleInKBSCEditorFlag,

		// The search command. kCustomEnabling is what lets UpdateActionStates rename it for the scope it
		// would search (KFCSearchEngine::FindCommandName - "Find in Book", "Find in Document", ...);
		// without it that hook is never called for this action.
		// NOT kDisableIfNoFrontDocument: a book search runs off the Book panel's book (or the active
		// book as a fallback - KFCBookScope::ResolveTargetBook) and opens
		// its chapters windowless, so "a book is open but no document window is" is a normal, working
		// state here. That flag would grey this out - and skip UpdateActionStates, losing the name -
		// exactly when the panel is most useful. The Layers panel can afford it; this one cannot.
		// "There is nothing to run on" IS answered, but in UpdateActionStates, where the question can
		// be put to the CURRENT scope (KFCBookScope::HasScopeTarget).
		// IN THE KEYBOARD SHORTCUTS EDITOR (the author's call), under Palette Menus
		// as "Kohaku Find/Change: <name>" - KCM's shape (kKFCPanelMenuActionArea). The enabling is
		// unchanged: a shortcut runs the same UpdateActionStates test the flyout does.
		kKFCActionComponentBoss,
		kKFCSearchBookActionID,
		kKFCSearchBookMenuKey,			// "Search" (renamed at run time to carry the scope)
		kKFCPanelMenuActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefVisibleInKBSCEditorFlag,


		kKFCActionComponentBoss,
		kKFCScopeBookActionID,
		kKFCBookScopeMenuKey,			// "Book Scope" (toggle, check mark)
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKFCActionComponentBoss,
		kKFCHidePrevChapterActionID,
		kKFCHidePrevChapterMenuKey,		// "Hide Previous Chapter" (toggle, check mark)
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Translucent Panel. kCustomEnabling for the check mark, like the two toggles above - and for
		// nothing else: it is deliberately NOT greyed out while the panel is docked, where it has no
		// visible effect (the author's call, as in KCM). Pressing it there sets the flag,
		// which applies the moment the panel floats again, and the status line says so rather than
		// leaving a click with no result unexplained.
		kKFCActionComponentBoss,
		kKFCTranslucentPanelActionID,
		kKFCTranslucentPanelMenuKey,	// "Translucent Panel" (toggle, check mark)
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Translucent Find/Change. kCustomEnabling for the check mark, like the toggle above it. Not
		// greyed out while the dialog is closed, for the same reason the panel one is not greyed out
		// while docked: the flag is what the user is setting, and it applies the moment the dialog
		// opens. The status line says which of the two happened.
		kKFCActionComponentBoss,
		kKFCTranslucentFindChangeActionID,
		kKFCTranslucentFindChangeMenuKey,	// "Translucent Find/Change" (toggle, check mark)
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Link the Application Bar's Search Field to This Panel. kCustomEnabling for the check mark, like
		// the toggles beside it. Not greyed out while the field is hidden: the flag is what is being set.
		kKFCActionComponentBoss,
		kKFCAppBarSearchEnterActionID,
		kKFCAppBarSearchEnterMenuKey,	// "Link the Application Bar's Search Field to This Panel" (toggle, check mark)
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Minimizable Find/Change. kCustomEnabling for the check mark, like the toggle above it.
		// Not greyed out while the dialog is closed, for the same reason: the flag is what the user
		// is setting, and it applies the moment the dialog opens.
		kKFCActionComponentBoss,
		kKFCMinimizableFindChangeActionID,
		kKFCMinimizableFindChangeMenuKey,	// "Minimizable Find/Change" (toggle, check mark)
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Remember Book Panel Placement. kCustomEnabling for the check mark, like the toggles above -
		// without it the check mark never appears (ActionDefs.h:40). Not greyed out with no book open:
		// the flag is what is being set, and it acts the next time a book panel closes or opens.
		kKFCActionComponentBoss,
		kKFCRememberBookPanelActionID,
		kKFCRememberBookPanelMenuKey,	// "Remember Book Panel Placement" (toggle, check mark)
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Save Panel Settings. NO kCustomEnabling: there is nothing to enable it against - it writes
		// the settings down, which is possible with nothing loaded and no results.
		// !Without kCustomEnabling this action never reaches UpdateActionStates at all, so the blanket
		// disable at the top of that method does NOT cover it - the hook completes the enabling only
		// for actions that ask for it (ActionDefs.h:40). It changes nothing in practice: a run's
		// progress bar is modal, so the flyout cannot be opened while one is going (measured on the
		// running panel).
		kKFCActionComponentBoss,
		kKFCSavePanelSettingsActionID,
		kKFCSavePanelSettingsMenuKey,	// "Save Panel Settings"
		kOtherActionArea,
		kNormalAction,
		kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Change All in Book (No List). kCustomEnabling: UpdateActionStates greys it (Book Scope off - F18 -, a list on
		// the panel, no book to run on, the Object and Colour tabs, nothing to find). In the Keyboard Shortcuts editor
		// under Palette Menus, like Find.
		kKFCActionComponentBoss,
		kKFCChangeAllActionID,
		kKFCChangeAllMenuKey,			// "Change All in Book (No List)"
		kKFCPanelMenuActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefVisibleInKBSCEditorFlag,

		// Clear Results. kCustomEnabling: grey with no list.
		kKFCActionComponentBoss,
		kKFCClearResultsActionID,
		kKFCClearResultsMenuKey,		// "Clear Results"
		kKFCPanelMenuActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefVisibleInKBSCEditorFlag,

		// Replace - a hit row's right-click menu (since 2026-10-06 the one write from the list - spec F16).
		// kCustomEnabling: UpdateActionStates greys it by the row the menu is over.
		kKFCActionComponentBoss,
		kKFCReplaceHitActionID,
		kKFCReplaceHitMenuKey,			// "Replace"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// "How to Use...". NO kCustomEnabling: this one has nothing to be enabled against. It reads a
		// text - no document, no result set, no selection - so it stays live with nothing loaded, which
		// is exactly when a first-time user reaches for it. (Not caught by the blanket disable at the top
		// of UpdateActionStates either - see Save Panel Settings above.)
		kKFCActionComponentBoss,
		kKFCHowToActionID,
		kKFCHowToMenuKey,				// "How to Use..."
		kOtherActionArea,
		kNormalAction,
		kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

	}
};


/*  
 * Locale Indicies.
 * The LocaleIndex should have indicies that point at your
 * localizations for each language system that you are localized for.
 */

/*  
 * String LocaleIndex.
 */
resource LocaleIndex ( kSDKDefStringsResourceID)
{
	kStringTableRsrcType,
	{
		// ONE wild row, the same as the model half's: model/KFC.fr's LocaleIndex says why (a single
		// table, matched by every locale; a named-locale list strands every locale it leaves out on raw
		// keys; the Japanese is switched in at run time - KFCLoc.h).
		kWildFS, k_Wild, kSDKDefStringsResourceID + index_enUS
	}
};

resource LocaleIndex (kSDKDefStringsNoTransResourceID)
{
	kStringTableRsrcType,
	{
		kWildFS, k_Wild, kSDKDefStringsNoTransResourceID + index_enUS
	}
};

// Strings not being localized
resource StringTable (kSDKDefStringsNoTransResourceID + index_enUS)
{
	k_enUS,									// Locale Id
	kEuropeanMacToWinEncodingConverter,		// Character encoding converter
	{
		kKFCInternalPopupMenuNameKey,	kKFCInternalPopupMenuNameKey,		// No need to translate, internal menu name.
	
	}
};

/*  
 * Panel LocaleIndex.
 */
resource LocaleIndex (kSDKDefPanelResourceID)
{
	kViewRsrcType,
	{
		kWildFS, k_Wild, 	kSDKDefPanelResourceID + index_enUS
	}
};

/*
 * LocaleIndex wrappers for the result tree's row resources. KFCResultListWidgetMgr
 * creates these at runtime via RsrcSpec(..., kViewRsrcType, <base RsrcID>); these map that base
 * ID to the +index_enUS body. The rows carry no localized strings (text is stamped at runtime),
 * so one wild locale suffices.
 */
resource LocaleIndex (kKFCResultChapterNodeWidgetRsrcID)
{
	kViewRsrcType,
	{
		kWildFS, k_Wild, 	kKFCResultChapterNodeWidgetRsrcID + index_enUS
	}
};

resource LocaleIndex (kKFCResultHitNodeWidgetRsrcID)
{
	kViewRsrcType,
	{
		kWildFS, k_Wild, 	kKFCResultHitNodeWidgetRsrcID + index_enUS
	}
};

/*  
 * Type definition.
 */
type KFCPanelWidget(kViewRsrcType) : PalettePanelWidget(ClassID = kKFCPanelWidgetBoss)
{
	CPanelMenuData;
};

/*
 * Result tree types. The list on our tree boss; the row on our tree node boss (it carries
 * the row-click handler, KFCResultNodeEH), shared by the branch and hit row resources; the hit
 * line's colour cell on our generic-panel boss.
 */
type KFCResultListWidget(kViewRsrcType) : TreeViewWidget(ClassID = kKFCResultListWidgetBoss)
{
};

type KFCResultNodeWidget(kViewRsrcType) : PrimaryResourcePanelWidget(ClassID = kKFCResultNodeWidgetBoss)
{
};

type KFCColorTextWidget(kViewRsrcType) : GenericPanelWidget(ClassID = kKFCColorTextWidgetBoss)
{
};

// The panel's message area: drawn by hand for the same reason (see kKFCStatusTextWidgetBoss).
// ! The field list is GenericPanelWidget's, NOT StaticMultiLineTextWidget's - the line that uses it
// carries no alignment, ellipsize style, ampersand flag, font, LINE COUNT or initial string. The drawing
// code decides all of them, and the line count is the box's own height (KFCStatusTextView.cpp). KCM's
// KCMStatusTextWidget is the same type.
type KFCStatusTextWidget(kViewRsrcType) : GenericPanelWidget(ClassID = kKFCStatusTextWidgetBoss)
{
};

/*
 * The panel's illustration. KFCIconWidget rather than the plain RollOverIconButtonWidget so that it
 * comes up on kKFCIconWidgetBoss and therefore carries IID_ITIP (the tooltip naming the URL).
 */
type KFCIconWidget(kViewRsrcType) : RollOverIconButtonWidget(ClassID = kKFCIconWidgetBoss)
{
};

/*
 * The illustration's artwork, compiled into the plug-in. The same image is given to the normal
 * (PNGA) and rollover (PNGR) states: the picture is a link, not a control that changes state, so
 * there is no second look for it to take. KCM does the same with its status icons.
 *
 * !! Replacing the .png alone does NOT reach a build - the build watches the .fr's timestamp, not
 *   the image's, so the icon compile step is skipped and the old artwork is linked again (the
 *   .pln's own date still moves, which is what makes this hard to spot). Touch this file after
 *   swapping the picture.
 *
 * KohakuNeko_On.png sits in this folder beside the files named below and is DELIBERATELY not one of
 * them: it is the original artwork (400x400) the 32px icons were drawn down from, kept so they can
 * be redrawn from it rather than enlarged from a thumbnail. Nothing compiles it in and nothing
 * loads it - if it is ever wanted on screen, it needs a resource line of its own here, and a
 * properly sized version to point that line at.
 */
resource PNGA(kKFCIconResID) "Kohakuneko_OFF32.png"
resource PNGR(kKFCIconResID) "Kohakuneko_OFF32.png"
resource PNGA(kKFCIconFoundResID) "KohakuFind32.png"
resource PNGR(kKFCIconFoundResID) "KohakuFind32.png"
resource PNGA(kKFCIconChangedResID) "KohakuChange32.png"
resource PNGR(kKFCIconChangedResID) "KohakuChange32.png"

/*
 * The small dock-tab icon, shown in place of the tab's name once the panel is collapsed to its
 * narrowest. Named by the PanelList entry above (kKFCPaletteIconResID, kKFCUIPluginID), which is
 * where a palette is told which picture is its own - it is NOT a widget, so there is no Frame and
 * no rollover state to give it.
 */
resource PNGA(kKFCPaletteIconResID) "KohakuFindChangeTab.png"

/*  
 * PanelList definition.
 */
resource PanelList (kSDKDefPanelResourceID)
{
	{
		// 1st panel in the list
		kSDKDefPanelResourceID,		// Resource ID for this panel (use SDK default rsrc ID)
		kKFCUIPluginID,			// ID of plug-in that owns this panel
		kIsResizable,
		kKFCPanelWidgetActionID,	// Action ID to show/hide the panel
		kKFCPanelWindowMenuName,	// Window > Kohaku Plug-Ins > Kohaku Find/Change (the author's call:
									// "like KCM"). *The colon inside this key is what buys the
									// sub-menu level (PanelList.fh on this field).
		"",							// *NO ALTERNATE MENU PATH: the panel lives on the Window menu alone,
									// where InDesign's own panels live. (An empty panelName would mean NO
									// Window entry at all.)
		0.0,						// Alternate menu position - meaningless without a path.
		kKFCPaletteIconResID, kKFCUIPluginID,	// PNG icon for the collapsed dock tab
		c_Panel
	}
};

/* 
 * PanelView definition.
 * Note: it is not necessary to use EVE for panels.
 * The view is not currently localised: therefore, it can reside here.
 * However, if you wish to localise it, it is recommended to locate it in one of
 * the localised framework resource files (i.e. KFCUI_enUS.fr etc.).
 */
resource KFCPanelWidget(kSDKDefPanelResourceID + index_enUS)
{
	__FILE__, __LINE__,					// Localization macro
	kKFCPanelWidgetID,					// WidgetID
	kPMRsrcID_None,						// RsrcID
	kBindNone,							// Binding (0=none)
	Frame(0, 0, 300, 360),				// Default size. Resizable (kIsResizable in PanelList), down
										// to a floor of 266 - the width the panel is actually worked
										// at, measured off the running panel. *Lining up with KCM's
										// width when docked together is deliberately GIVEN UP - see
										// KFCPanelMetrics.cpp. This 300 is the size the panel OPENS
										// at, where the opening message takes three lines on a
										// Japanese UI - and FOUR is what the block is sized to hold,
										// at this width and at the floor alike, because the longest
										// message the panel can put up needs them. Both numbers, and
										// the measurements behind them, are in KFCPanelMetrics.cpp.
	kTrue, kTrue,						// Visible, Enabled
	kTrue,								// Erase background (the result tree needs it)
	kInterfacePaletteFill,				// Erase to color
	kFalse,								// Draw dropshadow
	kKFCPanelTitleKey,					// Panel name
	{
		// Status read-out at the top: the search summary (total hits / chapters). WRAPPING over
		// several lines, not one line ellipsized (the author's call): a book search can append the
		// names of chapters it could not open, and the end of the sentence is the part an ellipsis
		// throws away. Bound left/right/top so it widens with the panel and stays put vertically.
		//
		// THE HEIGHT MUST BE A WHOLE NUMBER OF LINES. A line is 12px on an ENGLISH UI (measured off a
		// screenshot: four baselines 11.8px apart), so 48 = exactly four. The box draws into whatever
		// room it is given: at four lines and 4px over, narrowing the panel pushed the text to five
		// lines and the TOP 4px OF THE FIFTH appeared below the fourth, a sliver of chopped-off
		// letters. A remainder of zero leaves nothing for a part-line to be drawn into.
		//
		// AND THE LINE IS NOT 12px IN EVERY LANGUAGE. On a JAPANESE UI the palette font draws 18px
		// lines (measured on the running panel: baselines at y=218, 236, 254), so a 48px box holds two
		// and two thirds of them. A resource carries one set of numbers and these are the English set;
		// KFCPanelMetrics puts the real height on when the panel appears - four of the palette font's
		// own lines, asked of the font (72 on a Japanese UI), so every language gets FOUR lines - and
		// falls back to this 48 when the font cannot be asked. If this number changes, change
		// kMessageHeightResource there too - the two are stated against each other.
		//
		// FOUR LINES, NOT THREE: the line a stopped replace leaves is 128 characters, and three lines
		// drew it only as far as "the document has", losing the sentence that says what to do (see
		// KFCPanelMetrics.cpp, which carries the measurement). If the palette font ever changes size,
		// measure again - the rule is the remainder, not the number 48.
		//
		// DRAWN BY HAND (KFCStatusTextView.cpp), not a StaticMultiLineTextWidget: the stock widget
		// cannot draw two colours in one box, and this box shows a replaced row's text as it was BEFORE
		// the replace, where the question is "which characters were replaced". The same move KCM made
		// with its own message area (kKCMStatusTextWidgetBoss). The WidgetID, the Frame, the binding and
		// the way messages arrive (KFCResultTree::ShowStatus) are the stock widget's, so KFCPanelMetrics'
		// 72px and the illustrations sitting on the block's bottom edge did not move.
		// ! The stock fields are gone: the alignment (always left), the ellipsize style (a wrapping box
		//   has no "one line"; the view ends a message that does not fit with an ellipsis), the
		//   ampersand flag (kFalse in the drawing - no more doubling), the font (the rows' system-script
		//   palette font) and the LINE COUNT (as many whole lines as the height holds - 4 in both
		//   languages at the heights above). The initial text is written when the panel is shown
		//   (KFCResultTree::RestoreStatusOnPanelShow), as it always was in effect.
		KFCStatusTextWidget
		(
			kKFCStaticTextWidgetID,			 // WidgetId
			kPMRsrcID_None,					 // RsrcId
			kBindLeft | kBindRight | kBindTop, // Frame binding
			Frame(5, 6, 256, 54),			 // Frame: left, top, right, bottom (48px = four 12px lines)
			kTrue, kTrue,					 // Visible, Enabled
			"",								 // Panel name (none)
			{
			}
		),

		/* The panel's illustration, to the right of the message: hover it for the plug-in's home
		 * page, click it to go there (KFCIconTip supplies the tip text, the panel's own observer
		 * hears the click). Bound RIGHT so it keeps its place beside the message as the panel is
		 * resized (KCM's resizable panel binds its own right for the same reason).
		 *
		 * 32x32, sitting on the BOTTOM of the message block (top 22 = 54 - 32): a picture hanging
		 * off the top of a part-empty message box reads as detached from it. The two share a bottom
		 * edge, and that is the whole of why this number is what it is.
		 *
		 * THREE of them, STACKED at one frame: the plain cat until something has been run, the
		 * searching cat once it has, and the changing cat once a replace has written something.
		 * KFCPanelIcon owns which - it is the only place that names them, so a fourth picture is a
		 * widget here and a row there. All but the first come up HIDDEN; KFCPanelIcon writes the real
		 * answer when the panel appears, because these widgets are rebuilt on every show and a
		 * default written here would otherwise outrank the actual state.
		 */
		KFCIconWidget
		(
			kKFCIconWidgetID,
			kKFCIconResID, kKFCUIPluginID,
			kBindRight | kBindTop,
			Frame(260, 22, 292, 54),		// 4px clear of the text, 8px in from the panel's edge
			kTrue, kTrue,
			kADBEIconSuiteButtonType,
		),
		KFCIconWidget
		(
			kKFCIconFoundWidgetID,
			kKFCIconFoundResID, kKFCUIPluginID,
			kBindRight | kBindTop,
			Frame(260, 22, 292, 54),		// SAME frame as the one above - they are alternatives
			kFalse, kTrue,
			kADBEIconSuiteButtonType,
		),
		KFCIconWidget
		(
			kKFCIconChangedWidgetID,
			kKFCIconChangedResID, kKFCUIPluginID,
			kBindRight | kBindTop,
			Frame(260, 22, 292, 54),		// SAME frame again
			kFalse, kTrue,
			kADBEIconSuiteButtonType,
		),

		// Result tree: the result rows, filling the rest of the panel and bound to all four
		// edges so it grows with the window. Root hidden, single selection, vertical scroll bar
		// only; scroll increments = one 19px row.
		KFCResultListWidget
		(
			kKFCResultListWidgetID, kPMRsrcID_None,	// WidgetId, RsrcId
			kBindAll,						// Frame binding: grow with the panel
			Frame(4, 57, 296, 356),			// Frame (below the message block to the panel's edges)
											// 3px under the message block's bottom edge (54).
			kTrue, kTrue,					// Visible, Enabled
			kTrue,							// EraseBeforeDraw
			kInterfacePaletteFill,			// InterfaceColor
			"",								// Panel name
			kHideRootNode,					// Options: the root is not a row
			kFalse,							// Use H scroll bar
			kTrue,							// Use V scroll bar
			kKFCResultRowHeight,			// fVScrollButtonIncrement (one row)
			kKFCResultRowHeight,			// fVThumbScrollIncrement
			kKFCResultRowHeight,			// fHScrollButtonIncrement (unused, no H bar)
			kKFCResultRowHeight,			// fHThumbScrollIncrement
			1,								// Items selectable: 1 = single selection
			kFalse,							// Allow children from multiple parents to be selected
			kFalse,							// Allow discontiguous selection
			{
			},
		),
	}

	kKFCInternalPopupMenuNameKey		// Popup menu name (internal)
};

/*
 * One BRANCH row of the result tree - book, document, run and story alike - created at runtime by
 * KFCResultListWidgetMgr for every node that is not a hit: a stock expander arrow (hidden by the
 * widget manager on a childless row) and the "<name>  (N)" label after the expander's zone. The widget manager
 * owns the runtime layout; these frames are only the default state.
 */
resource KFCResultNodeWidget(kKFCResultChapterNodeWidgetRsrcID + index_enUS)
{
	__FILE__, __LINE__,
	kKFCResultChapterNodeWidgetID, kPMRsrcID_None,	// WidgetId, RsrcId
	kBindLeft | kBindRight,				// Frame binding: follow the list's width
	Frame(0, 0, 296, kKFCResultRowHeight),	// Frame (left, top, right, bottom)
	kTrue, kTrue,						// Visible, Enabled
	"",									// Panel name
	{
		// The expand / collapse arrow (stock part; the tree framework owns its clicks and its
		// collapsed / expanded state icon). Field-for-field the paneltreeview sample's.
		TreeExpanderWidget
		(
			kTreeNodeExpanderWidgetID,		// WidgetId
			kTreeBranchCollapsedRsrcID,		// RsrcId for collapsed node icon
			kApplicationRsrcPluginID,		// RsrcPlugin for collapsed node icon
			kBindNone,						// Frame binding
			Frame(2, 1, 18, 17),			// Frame (inside the 19px row)
			kTrue, kTrue,					// Visible, Enabled
			kTreeBranchExpandedRsrcID, 		// RsrcId for expanded node icon
			kApplicationRsrcPluginID,		// RsrcPlugin for expanded node icon
			kTrue,							// Cmd-Click expands/collapses children
			kFalse,							// Scroll to show children when expanded
			kIconNoCentering,
			kIconRaisedLook,				// Icon look
			kFalse							// Draws a well
		),

		InfoStaticTextWidget
		(
			kKFCResultChapterLabelWidgetID,	// WidgetId
			kPMRsrcID_None,					// RsrcId
			kBindLeft | kBindRight,			// Frame binding: take the rest of the row
			Frame(18, 1, 292, 17),			// Frame
			kTrue, kTrue,					// Visible, Enabled
			kAlignLeft,						// Alignment
			kEllipsizeEnd, kTrue,			// Ellipsize style, Convert ampersands
			"",								// Text Control Data
			0,								// WidgetId for associated control for shortcut focus
			kPaletteWindowSystemScriptFontId, kPaletteWindowSystemScriptFontId,
		),
	}
};

/*
 * One HIT row of the result tree: the match's line in the custom multi-colour text cell
 * (KFCColorTextView highlights the matched part). No expander (a leaf); the widget manager
 * indents the cell one expander zone deeper than the chapter row's text at apply time, so this
 * frame is only the default state.
 */
resource KFCResultNodeWidget(kKFCResultHitNodeWidgetRsrcID + index_enUS)
{
	__FILE__, __LINE__,
	kKFCResultHitNodeWidgetID, kPMRsrcID_None,	// WidgetId, RsrcId
	kBindLeft | kBindRight,				// Frame binding: follow the list's width
	Frame(0, 0, 296, kKFCResultRowHeight),	// Frame (left, top, right, bottom)
	kTrue, kTrue,						// Visible, Enabled
	"",									// Panel name
	{
		KFCColorTextWidget
		(
			kKFCResultTextWidgetID, kPMRsrcID_None,	// WidgetId, RsrcId
			kBindLeft | kBindRight,			// Frame binding: take the rest of the row
			Frame(50, 1, 292, 17),			// Frame (indented; the widget manager re-places it)
			kTrue, kTrue,					// Visible, Enabled
			"",								// Panel name
			{
			}
		),
	}
};
#endif // __ODFRC__


