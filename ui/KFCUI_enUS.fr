#ifdef __ODFRC__

// English string table is defined here

resource StringTable (kSDKDefStringsResourceID + index_enUS)
{
        k_enUS,									// Locale Id
        kEuropeanWinToMacEncodingConverter,		// Character encoding converter (irp) I made this WinToMac as we have a bias to generate on Win...
        {
        	 // ----- Menu strings
                kKBSCompanyKey,					"Kohaku Plug-Ins",	// menu-group display name (KCM's shape; distinct from kKBSCompanyValue)
                kKBSAboutMenuKey,					kKBSDisplayName "...",

                kSDKDefAboutThisPlugInMenuKey,			kSDKDefAboutThisPlugInMenuValue_enUS,

                // ----- Command strings
                kKBSSearchBookMenuKey,			"Search",
                kKBSBookScopeMenuKey,			"Book Scope",
                kKBSHidePrevChapterMenuKey,		"Hide Previous Chapter",
                kKBSTranslucentPanelMenuKey,	"Translucent Panel",
                kKBSTranslucentFindChangeMenuKey,	"Translucent Find/Change",
                kKBSMinimizableFindChangeMenuKey,	"Minimizable Find/Change",
                kKBSRememberBookPanelMenuKey,	"Remember Book Panel Placement",
                kKBSAppBarSearchEnterMenuKey,	"Link the Application Bar's Search Field to This Panel",
                kKBSSavePanelSettingsMenuKey,	"Save Panel Settings",
                kKBSReplaceCheckedMenuKey,		"Change Checked",
                kKBSCheckAllMenuKey,			"Check All",
                kKBSReplaceHitMenuKey,			"Replace",
                // The Reject / Accept items name KohakuFindChange as the changes' author - they act on its
                // own changes only (the plug-in author's call) - one name per level.
                kKBSRejectChangeMenuKey,		"Reject Change by KohakuFindChange",
                kKBSStoryRejectMenuKey,			"Reject Changes by KohakuFindChange in This Story",
                kKBSChapterRejectMenuKey,		"Reject All Changes by KohakuFindChange in This Document",
                kKBSRunRejectMenuKey,			"Reject Changes by KohakuFindChange in This Run",
                kKBSAcceptChangeMenuKey,		"Accept Change by KohakuFindChange",
                kKBSStoryAcceptMenuKey,			"Accept Changes by KohakuFindChange in This Story",
                kKBSRunAcceptMenuKey,			"Accept Changes by KohakuFindChange in This Run",
                kKBSAcceptAllChangesMenuKey,	"Accept All Changes by KohakuFindChange in This Document",
                kKBSShowChangesMenuKey,			"Show Changes by KohakuFindChange",
                // The story and document rows' second replace (the code's "Redo"). The name says what it
                // writes with - Find/Change as it stands now, not the replace it takes back (the plug-in
                // author's call).
                kKBSRedoMenuKey,				"Replace Again (Current Find/Change Settings)",
                kKBSUncheckAllMenuKey,			"Uncheck All",
                // The operating reference. English in every UI language, like the rest of the flyout.
                kKBSHowToMenuKey,				"How to Use...",
                kKBSOpenFindChangeMenuKey,		"Open Find/Change...",
                // The Keyboard Shortcuts editor's area (kKBSPanelMenuActionArea): files the
                // shortcut-assignable actions under "Palette Menus" as "Kohaku Find/Change: <name>".
                kKBSPanelMenuActionArea,		kKBSPanelMenuActionAreaValue,

                // ----- Panel/dialog strings
                kKBSPanelTitleKey,				kKBSDisplayName,
                // The message line as a freshly opened panel shows it - the plug-in has no search
                // box of its own, so the first thing to say is where the query is typed.
                // Read through InitialMessage (KBSResultListWidgetMgr.cpp) whenever the message line falls
                // back to what a panel with nothing run says; the resource itself carries no initial text,
                // the message area being drawn by hand (KFCUI.fr). Kept here so the wording is not spelled
                // out in the code. It names no Find command (the plug-in author's call): the command's name
                // follows Find/Change's Search: (KBSSearchEngine::FindCommandName), so any one name would
                // be wrong as often as not.
                kKBSStaticTextKey,				"Type what to find in Edit > Find/Change, then run Find from this panel's menu.",

                // (The model half's strings - the replace's own alert and what Edit > Undo calls a
                //  KBS write - are in model/KBS_enUS.fr.)


		// ----- Misc strings
                // The About box is the plug-in's NAME AND VERSION, nothing else, and it reads the
                // same in every UI language (the plug-in author's call) - no description, credit, URL
                // or Japanese wording. Same shape as KCM's (KCMUI_enUS.fr, kKCMAboutBoxStringKey).
                kKBSAboutBoxStringKey,			kKBSDisplayName " version " kKBSVersion,


        }

};

#endif // __ODFRC__
