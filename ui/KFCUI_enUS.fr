#ifdef __ODFRC__

// English string table is defined here

resource StringTable (kSDKDefStringsResourceID + index_enUS)
{
        k_enUS,									// Locale Id
        kEuropeanWinToMacEncodingConverter,		// Character encoding converter (irp) I made this WinToMac as we have a bias to generate on Win...
        {
        	 // ----- Menu strings
                kKFCCompanyKey,					"Kohaku Plug-Ins",	// menu-group display name (KCM's shape; distinct from kKFCCompanyValue)
                kKFCAboutMenuKey,					kKFCDisplayName "...",

                kSDKDefAboutThisPlugInMenuKey,			kSDKDefAboutThisPlugInMenuValue_enUS,

                // ----- Command strings
                kKFCSearchBookMenuKey,			"Search",
                kKFCBookScopeMenuKey,			"Book Scope",
                kKFCSelectedDocumentsMenuKey,	"Find/Change Selected Documents (Book)",
                kKFCHidePrevChapterMenuKey,		"Hide Previous Chapter",
                kKFCTranslucentPanelMenuKey,	"Translucent Panel",
                kKFCTranslucentFindChangeMenuKey,	"Translucent Find/Change",
                kKFCMinimizableFindChangeMenuKey,	"Minimizable Find/Change",
                kKFCRememberBookPanelMenuKey,	"Remember Book Panel Placement",
                kKFCAppBarSearchEnterMenuKey,	"Link the Application Bar's Search Field to This Panel",
                kKFCSavePanelSettingsMenuKey,	"Save Panel Settings",
                kKFCChangeAllMenuKey,			"Change All in Book (No List)",
                kKFCClearResultsMenuKey,		"Clear Results",
                kKFCReplaceHitMenuKey,			"Replace",
                // The operating reference. English in every UI language, like the rest of the flyout.
                kKFCHowToMenuKey,				"How to Use...",
                kKFCOpenFindChangeMenuKey,		"Open Find/Change...",
                kKFCRunSavedQueriesMenuKey,		"Run Saved Queries...",
                // The Keyboard Shortcuts editor's area (kKFCPanelMenuActionArea): files the
                // shortcut-assignable actions under "Palette Menus" as "Kohaku Find/Change: <name>".
                kKFCPanelMenuActionArea,		kKFCPanelMenuActionAreaValue,

                // ----- Panel/dialog strings
                kKFCPanelTitleKey,				kKFCDisplayName,
                // The query dialog (2026-10-07, Run Saved Queries...): its title (the spec's D11 name), the lists'
                // headings, the buttons between them, Run and Close.
                kKFCQueryDialogTitleKey,		"Kohaku Find/Change Queries",
                kKFCQuerySavedLabelKey,			"Saved Queries:",
                kKFCQueryOrderLabelKey,			"Run Order:",
                kKFCQueryAddKey,				"Add >",
                kKFCQueryRemoveKey,				"< Remove",
                kKFCQueryUpKey,					"Move Up",
                kKFCQueryDownKey,				"Move Down",
                kKFCQueryClearKey,				"Clear",
                kKFCQueryRunKey,				"Run",
                kKFCQueryCloseKey,				"Close",
                // The message line as a freshly opened panel shows it - the plug-in has no search
                // box of its own, so the first thing to say is where the query is typed.
                // Read through InitialMessage (KFCResultListWidgetMgr.cpp) whenever the message line falls
                // back to what a panel with nothing run says; the resource itself carries no initial text,
                // the message area being drawn by hand (KFCUI.fr). Kept here so the wording is not spelled
                // out in the code. It names no Find command (the plug-in author's call): the command's name
                // follows Find/Change's Search: (KFCSearchEngine::FindCommandName), so any one name would
                // be wrong as often as not.
                kKFCStaticTextKey,				"Type what to find in Edit > Find/Change, then run Find from this panel's menu.",

                // (The model half's strings - the replace's own alert and what Edit > Undo calls a
                //  KFC write - are in model/KFC_enUS.fr.)


		// ----- Misc strings
                // The About box is the plug-in's NAME AND VERSION, nothing else, and it reads the
                // same in every UI language (the plug-in author's call) - no description, credit, URL
                // or Japanese wording. Same shape as KCM's (KCMUI_enUS.fr, kKCMAboutBoxStringKey).
                kKFCAboutBoxStringKey,			kKFCDisplayName " version " kKFCVersion,


        }

};

#endif // __ODFRC__
