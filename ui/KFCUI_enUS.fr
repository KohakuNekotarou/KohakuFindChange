#ifdef __ODFRC__

// English string table is defined here

resource StringTable (kSDKDefStringsResourceID + index_enUS)
{
        k_enUS,									// Locale Id
        kEuropeanWinToMacEncodingConverter,		// Character encoding converter (irp) I made this WinToMac as we have a bias to generate on Win...
        {
        	 // ----- Menu strings
                kKFCCompanyKey,					"Kohaku Plug-Ins",	// menu-group display name (KCM's shape; distinct from kKFCCompanyValue)
                kKFCAboutMenuKey,					kKFCDisplayName "...",

                kKFCAboutThisPlugInMenuKey,		"About This Plug-In...",	// KFC's own key - KFCUIID.h says why

                // ----- Command strings
                kKFCSearchBookMenuKey,			"Search",
                kKFCBookScopeMenuKey,			"Book Scope",
                kKFCSelectedDocumentsMenuKey,	"Find/Change Selected Documents (Book)",
                kKFCHidePrevChapterMenuKey,		"Hide Previous Chapter",
                kKFCTranslucentPanelMenuKey,	"Translucent Panel",
                kKFCTranslucentFindChangeMenuKey,	"Translucent Find/Change",
                kKFCMinimizableFindChangeMenuKey,	"Minimizable Find/Change",
                kKFCRememberBookPanelMenuKey,	"Remember Book Panel Placement",
                kKFCAppBarSearchEnterMenuKey,	"Link the Application Bar's Search Field to This Panel",
                kKFCSavePanelSettingsMenuKey,	"Save Panel Settings",
                kKFCChangeAllMenuKey,			"Change All in Book (No List)",
                kKFCClearResultsMenuKey,		"Clear Results",
                kKFCReplaceHitMenuKey,			"Replace",
                kKFCSearchStoryAgainMenuKey,	"Search This Story Again",
                kKFCSearchDocumentAgainMenuKey,	"Search This Document Again",
                kKFCSelectAllRowsMenuKey,		"Select All Rows",
                kKFCClearTierResultsMenuKey,	"Clear These Results",
                kKFCSearchTierAgainMenuKey,	"Search These Results Again",
                kKFCCreateOutlinesMenuKey,	"Create Outlines",
                kKFCRestoreOriginalMenuKey,	"Restore from Copy",
                kKFCClearRowsMenuKey,			"Clear from Results",
                kKFCCopyResultsMenuKey,			"Copy Results",
                kKFCCopyRowsMenuKey,			"Copy Rows",
                kKFCCopyTierResultsMenuKey,		"Copy These Results",
                kKFCNarrowDownSubmenuKey,		"Narrow Down",
                kKFCNarrowInTablesMenuKey,		"In Tables",
                kKFCNarrowInFootnotesMenuKey,	"In Footnotes",
                kKFCNarrowInEndnotesMenuKey,	"In Endnotes",
                kKFCNarrowPagesMenuKey,			"Pages...",
                kKFCNarrowOnPasteboardMenuKey,	"On Pasteboard",
                kKFCNarrowFramesMenuKey,		"Frames of These Matches",
                // An object row's other Special Operations - InDesign's own English command names.
                kKFCFillFramePropMenuKey,			"Fill Frame Proportionally",
                kKFCContentProportionalMenuKey,		"Fit Content Proportionally",
                kKFCContentAwareFitMenuKey,			"Content-Aware Fit",
                kKFCFrameToContentMenuKey,			"Fit Frame to Content",
                kKFCFitContentToFrameMenuKey,		"Fit Content to Frame",
                kKFCCenterContentMenuKey,			"Center Content",
                kKFCBringToFrontMenuKey,			"Bring to Front",
                kKFCBringForwardMenuKey,			"Bring Forward",
                kKFCSendBackwardMenuKey,			"Send Backward",
                kKFCSendToBackMenuKey,				"Send to Back",
                kKFCRotate90CWMenuKey,				"Rotate 90 Degrees Clockwise",
                kKFCRotate90CCWMenuKey,				"Rotate 90 Degrees Counter-clockwise",
                kKFCRotate180MenuKey,				"Rotate 180 Degrees",
                kKFCFlipHorizontalMenuKey,			"Flip Horizontal",
                kKFCFlipVerticalMenuKey,			"Flip Vertical",
                kKFCRedefineScalingMenuKey,			"Redefine Scaling as 100%",
                kKFCClearTransformationsMenuKey,	"Clear Transformations",
                kKFCLockMenuKey,					"Lock",
                kKFCUnlockMenuKey,					"Unlock",
                kKFCHideMenuKey,					"Hide",
                kKFCShowMenuKey,					"Show",
                kKFCMoveToLayerMenuKey,				"Move to Active Layer",
                kKFCClearStyleOverridesMenuKey,		"Clear Object Style Overrides",
                kKFCDeleteMenuKey,					"Delete",
                kKFCMoveMenuKey,					"Move...",
                kKFCScaleMenuKey,					"Scale...",
                kKFCRotateMenuKey,					"Rotate...",
                kKFCShearMenuKey,					"Shear...",
                kKFCFittingSubmenuKey,				"Fitting",
                kKFCArrangeSubmenuKey,				"Arrange",
                kKFCTransformSubmenuKey,			"Transform",
                // The operating reference. English in every UI language, like the rest of the flyout.
                kKFCHowToMenuKey,				"How to Use...",
                kKFCOpenFindChangeMenuKey,		"Open Find/Change...",
                kKFCFindOnActiveLayerMenuKey,	"Find Objects on Active Layer",
                kKFCRunSavedQueriesMenuKey,		"Run Saved Queries...",
                // The Keyboard Shortcuts editor's area (kKFCPanelMenuActionArea): files the
                // shortcut-assignable actions under "Palette Menus" as "Kohaku Find/Change: <name>".
                kKFCPanelMenuActionArea,		kKFCPanelMenuActionAreaValue,

                // ----- Panel/dialog strings
                kKFCPanelTitleKey,				kKFCDisplayName,
                // The query dialog (Run Saved Queries...): its title (the name its design gave it - D11 of
                // docs/superpowers/specs/_done/2026-10-07-kfc-query-dialog-and-selected-documents-design.md),
                // the lists' headings, the buttons between them, Find, Run and Close.
                kKFCQueryDialogTitleKey,		"Kohaku Find/Change Queries",
                kKFCQuerySavedLabelKey,			"Saved Queries:",
                kKFCQueryOrderLabelKey,			"Run Order:",
                kKFCQueryAddKey,				"Add >",
                kKFCQueryRemoveKey,				"< Remove",
                kKFCQueryUpKey,					"Move Up",
                kKFCQueryDownKey,				"Move Down",
                kKFCQueryClearKey,				"Clear",
                kKFCQueryFindKey,				"Find",
                kKFCQueryRunKey,				"Run",
                kKFCQueryCloseKey,				"Close",
                // Save Order... / Load Order...: the buttons, InDesign's Save / Open dialogs' titles,
                // and the file type's name in them.
                kKFCQuerySaveOrderKey,			"Save Order...",
                kKFCQueryLoadOrderKey,			"Load Order...",
                kKFCQuerySaveOrderTitleKey,		"Save Query Order",
                kKFCQueryLoadOrderTitleKey,		"Load Query Order",
                kKFCQueryOrderFileTypeKey,		"KFC Query Order",
                // The message line as a freshly opened panel shows it - the plug-in has no search
                // box of its own, so the first thing to say is where the query is typed.
                // Read through InitialMessage (KFCResultListWidgetMgr.cpp) whenever the message line falls
                // back to what a panel with nothing run says; the resource itself carries no initial text,
                // the message area being drawn by hand (KFCUI.fr). Kept here so the wording is not spelled
                // out in the code. It names no Find command (the plug-in author's call): the command's name
                // follows Find/Change's Search: (KFCSearchEngine::FindCommandName), so any one name would
                // be wrong as often as not.
                kKFCStaticTextKey,				"Type what to find in Edit > Find/Change, then run Find from this panel's menu.",

                // (The model half's strings - the names Edit > Undo gives KFC's writes - are in
                //  model/KFC_enUS.fr.)


		// ----- Misc strings
                // The About box is the plug-in's NAME AND VERSION, nothing else, and it reads the
                // same in every UI language (the plug-in author's call) - no description, credit, URL
                // or Japanese wording. Same shape as KCM's (KCMUI_enUS.fr, kKCMAboutBoxStringKey).
                kKFCAboutBoxStringKey,			kKFCDisplayName " version " kKFCVersion,


        }

};

#endif // __ODFRC__
