#ifdef __ODFRC__

// English string table is defined here

resource StringTable (kSDKDefStringsResourceID + index_enUS)
{
        k_enUS,									// Locale Id
        kEuropeanWinToMacEncodingConverter,		// Character encoding converter (irp) I made this WinToMac as we have a bias to generate on Win...
        {
        	 // ----- Menu strings
                kKBSCompanyKey,					"Kohaku Plug-Ins",	// menu-group display name (KESCM-style; distinct from kKBSCompanyValue)
                kKBSAboutMenuKey,					kKBSDisplayName "...",
                // kKBSPluginsMenuKey was here until 2026-08-06. Its menu path macro was never used
                // by the .fr, so nothing ever asked for this string (see KBSID.h).

                kSDKDefAboutThisPlugInMenuKey,			kSDKDefAboutThisPlugInMenuValue_enUS,

                // ----- Command strings
                kKBSSearchBookMenuKey,			"Search",
                kKBSFindMissingGlyphsMenuKey,	"Find Missing Glyphs",
                kKBSFindOversetMenuKey,			"Find Overset",
                kKBSBookScopeMenuKey,			"Book Scope",
                kKBSHidePrevChapterMenuKey,		"Hide Previous Chapter",
                kKBSTranslucentPanelMenuKey,	"Translucent Panel",
                kKBSTranslucentFindChangeMenuKey,	"Translucent Find/Change",
                kKBSSavePanelSettingsMenuKey,	"Save Panel Settings",
                kKBSReplaceCheckedMenuKey,		"Change Checked",
                kKBSCheckAllMenuKey,			"Check All",
                kKBSUncheckAllMenuKey,			"Uncheck All",
                kKBSSaveResultsMenuKey,			"Save Results...",
                // The operating reference. English in both tables, like the rest of the flyout.
                kKBSHowToMenuKey,				"How to Use...",

                // ----- Window strings

                // ----- Panel/dialog strings
                kKBSPanelTitleKey,				kKBSDisplayName,
                // The message line as a freshly opened panel shows it - the plug-in has no search
                // box of its own, so the first thing to say is where the query is typed. It is not
                // only the .fr's initial value: KBSResultTree::RestoreStatusOnPanelShow reads this
                // same key whenever the panel is shown with nothing run this session, which is why
                // the wording cannot be spelled out in the code as well. Naming the DOCUMENT command
                // is always right here, because Book Scope starts OFF at every launch.
                kKBSStaticTextKey,				"Type what to find in Edit > Find/Change, then run Find in Document from this panel's menu.",

                // ----- Change Checked confirmation prompt
                // ^1 takes real data (a count, the user's find / change string), which is marked
                // untranslatable before it goes in - see KBSActionComponent::ConfirmReplace.
                // The Japanese wording lives in KBSLoc.h (runtime switch by UI language - the
                // jaJP string table is gone, 2026-08-05).
                kKBSConfirmReplaceOneKey,		"Change 1 checked hit?",
                kKBSConfirmReplaceManyKey,		"Change ^1 checked hits?",
                kKBSConfirmFindKey,				"Find: ^1",
                kKBSConfirmChangeToKey,			"Change to: ^1",
                kKBSConfirmEmptyReplaceKey,		"(empty - the matches will be deleted)",
                // The Find/Change dialog's own names for its two format panes. Shown when a format
                // is set: "cat  + Find Format", or alone when the box beside it is empty (a search
                // by format with nothing typed - which the dialog allows and KBS now runs).
                kKBSConfirmFindFormatKey,		"Find Format",
                kKBSConfirmChangeFormatKey,		"Change Format",
                // Sits between the query and the closing lines: what is about to be written, then
                // what could go wrong with it, then what the run leaves behind.
                //
                // ***** NOT ON THIS PROMPT - these five are the replace's own alert. ***** An
                // opening that names what was edited, then what it can cost, then what Cancel does.
                // Shown once per chapter, as the replace opens that chapter and finds its counters
                // have moved: the only point at which a chapter the user had CLOSED can be asked.
                // They were a line on this prompt for one afternoon on 2026-08-08; KBSID.h says why
                // they left it. ...Many has had no caller since (the alert names one chapter,
                // because it asks once per chapter).
                kKBSConfirmEditedDocKey,		"The text has been edited since the search.",
                kKBSConfirmEditedOneKey,		"The text of ^1 has been edited since the search.",
                // The other axis (KBSEditStamp::kScopeStateChanged): nothing edited, but a layer
                // or a lock changed while the scope switches exclude that state.
                kKBSConfirmGatesDocKey,			"A layer or a lock has changed since the search.",
                kKBSConfirmGatesOneKey,			"A layer or a lock of ^1 has changed since the search.",
                kKBSConfirmEditedManyKey,		"The text of ^1 chapters has been edited since the search.",
                kKBSConfirmEditedTailKey,		"A replacement can land somewhere you did not intend.",
                kKBSConfirmEditedCancelAllKey,	"Cancel stops the whole replace.",
                // Unconditional again since 2026-08-05: both used to open with "Unless you tick the
                // box below", because a "save after replace" box underneath could make them false.
                // That box is gone with its feature, so a run has only one outcome left to state.
                // ONE string since 2026-08-07 (user's wording): it states the case instead of
                // counting chapters, so the singular/plural pair it replaced is gone and there is
                // no ^1 left in it.
                kKBSConfirmUnsavedKey,			"When a replace covers several documents in a book, every document it changes is left open and UNSAVED.",
                // Follows the line above on both layouts, whatever the count. Just the warning
                // since 2026-08-07 (user's wording): the line above already states the condition
                // it used to repeat.
                kKBSConfirmCareKey,				"Please take care.",

                // ----- Glyph tab confirmation (the dialog that draws the glyphs themselves)
                // The count and the closing line above are shared with it - only these four are new.
                kKBSGlyphConfirmFindLabelKey,	"Find",
                kKBSGlyphConfirmChangeLabelKey,	"Change to",
                kKBSGlyphConfirmArrowKey,		"->",
                kKBSGlyphConfirmDontShowKey,	"Don't show again",

                // "Save after replace" had three strings here (the box, its note, and the extra
                // warning that went up when it was ticked) from 2026-08-02 until the feature was
                // removed on 2026-08-05. Their keys are retired in KBSID.h.

		// ----- Misc strings
                // The About box is the plug-in's NAME AND VERSION, nothing else, and it reads the
                // same in every UI language (user's call, 2026-08-09). It used to carry a
                // description, a credit and the repository URL, and a separate Japanese wording in
                // KBSLoc.h - all removed. The separator is a plain space: the Japanese version had
                // an ideographic comma there, which is the sort of thing that had to go for the two
                // languages to read alike. Same shape as KESCM's (KESCM_enUS.fr:84).
                kKBSAboutBoxStringKey,			kKBSDisplayName " version " kKBSVersion,


        }

};

#endif // __ODFRC__
