#ifdef __ODFRC__

// English string table is defined here

resource StringTable (kSDKDefStringsResourceID + index_enUS)
{
        k_enUS,									// Locale Id
        kEuropeanWinToMacEncodingConverter,		// Character encoding converter (irp) I made this WinToMac as we have a bias to generate on Win...
        {
        	 // ----- Menu strings
                kKBSCompanyKey,					"Kohaku Plug-Ins",	// menu-group display name (KESCM-style; distinct from kKBSCompanyValue)
                kKBSAboutMenuKey,					kKBSDisplayName "...",
                kKBSPluginsMenuKey,				kKBSDisplayName,

                kSDKDefAboutThisPlugInMenuKey,			kSDKDefAboutThisPlugInMenuValue_enUS,

                // ----- Command strings
                kKBSSearchBookMenuKey,			"Search",
                kKBSFindMissingGlyphsMenuKey,	"Find Missing Glyphs",
                kKBSFindOversetMenuKey,			"Find Overset",
                kKBSBookScopeMenuKey,			"Book Scope",
                kKBSHidePrevChapterMenuKey,		"Hide Previous Chapter",
                kKBSTranslucentPanelMenuKey,	"Translucent Panel",
                kKBSTranslucentFindChangeMenuKey,	"Translucent Find/Change",
                kKBSSavePanelSettingsMenuKey,	"Save Panel Settings",
                kKBSReplaceCheckedMenuKey,		"Change Checked",
                kKBSCheckAllMenuKey,			"Check All",
                kKBSUncheckAllMenuKey,			"Uncheck All",
                kKBSSaveResultsMenuKey,			"Save Results...",
                // The operating reference. English in both tables, like the rest of the flyout.
                kKBSHowToMenuKey,				"How to Use...",

                // ----- Window strings

                // ----- Panel/dialog strings
                kKBSPanelTitleKey,				kKBSDisplayName,
                // The message line as a freshly opened panel shows it - the plug-in has no search
                // box of its own, so the first thing to say is where the query is typed. It is not
                // only the .fr's initial value: KBSResultTree::RestoreStatusOnPanelShow reads this
                // same key whenever the panel is shown with nothing run this session, which is why
                // the wording cannot be spelled out in the code as well. Naming the DOCUMENT command
                // is always right here, because Book Scope starts OFF at every launch.
                kKBSStaticTextKey,				"Type what to find in Edit > Find/Change, then run Find in Document from this panel's menu.",

                // ----- Change Checked confirmation prompt
                // ^1 takes real data (a count, the user's find / change string), which is marked
                // untranslatable before it goes in - see KBSActionComponent::ConfirmReplace.
                // The Japanese wording lives in KBS_jaJP.fr; read its header before editing it,
                // the encoding rules there are not obvious.
                kKBSConfirmReplaceOneKey,		"Change 1 checked hit?",
                kKBSConfirmReplaceManyKey,		"Change ^1 checked hits?",
                kKBSConfirmFindKey,				"Find: ^1",
                kKBSConfirmChangeToKey,			"Change to: ^1",
                kKBSConfirmEmptyReplaceKey,		"(empty - the matches will be deleted)",
                // The Find/Change dialog's own names for its two format panes. Shown when a format
                // is set: "cat  + Find Format", or alone when the box beside it is empty (a search
                // by format with nothing typed - which the dialog allows and KBS now runs).
                kKBSConfirmFindFormatKey,		"Find Format",
                kKBSConfirmChangeFormatKey,		"Change Format",
                // Both start with the condition, because the box below can make them false: a run
                // that saves writes every chapter to disk and closes the ones this plug-in opened,
                // and no undo puts a saved file back. The box is ticked AFTER this text is drawn,
                // so it cannot be rewritten at that moment - stating the condition up front is what
                // keeps the dialog honest either way.
                kKBSConfirmUnsavedOneKey,		"Unless you tick the box below, the chapter is opened and left UNSAVED - a single undo puts it back.",
                kKBSConfirmUnsavedManyKey,		"Unless you tick the box below, the ^1 chapters are opened and left UNSAVED - a single undo puts them all back.",

                // ----- Glyph tab confirmation (the dialog that draws the glyphs themselves)
                // The count and the closing line above are shared with it - only these four are new.
                kKBSGlyphConfirmFindLabelKey,	"Find",
                kKBSGlyphConfirmChangeLabelKey,	"Change to",
                kKBSGlyphConfirmArrowKey,		"->",
                kKBSGlyphConfirmDontShowKey,	"Don't show again",

                // ----- "Save after replace" (the box, what it does besides saving, and the warning)
                kKBSSaveAfterReplaceKey,		"Save each chapter after replace",
                kKBSSaveAfterReplaceNoteKey,	"Chapters are opened one at a time and closed again after saving.",
                // No quotation marks around the box's name: no string in this table escapes a
                // double quote, and the resource compiler is not worth finding out about here.
                kKBSSaveAfterReplaceWarningKey,	"Save each chapter after replace is ticked." kLineSeparatorString kLineSeparatorString "Documents are saved as their replacements are done, and the ones this plug-in opened are then closed. Cancelling part-way through does not put a saved file back." kLineSeparatorString kLineSeparatorString "Continue?",

		// ----- Misc strings
                kKBSAboutBoxStringKey,			kKBSDisplayName ", version " kKBSVersion "\n\n"
                	"Adobe InDesign C++ SDK Plug-In.\n"
                	"Searches the front document, or every chapter of the active book (.indb) at once, with the query set in InDesign's own Find/Change dialog, and lists every hit in a tree. Click a row to jump to it, or tick rows and replace only those.\n\n"
                	"Designed and implemented by KohakuNekotarou in collaboration with Anthropic's AI Claude (Claude Code).\n\n"
                	"Source: " kKBSRepoURL,


        }

};

#endif // __ODFRC__
