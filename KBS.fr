};

/*  
 * The ExtraPluginInfo resource adds extra information to the Missing Plug-in dialog
 * that is popped when a document containing this plug-in's data is opened when
 * this plug-in is not present. These strings are not translatable strings
 * since they must be available when the plug-in isn't around. They get stored
 * in any document that this plug-in contributes data to.
 */
resource ExtraPluginInfo(1)
{
	kKBSCompanyValue,			// Company name
	kKBSMissingPluginURLValue,	// URL 
	kKBSMissingPluginAlertValue,	// Missing plug-in alert text
};

/* 
 * Boss class definitions.
 */
resource ClassDescriptionTable(kSDKDefClassDescriptionTableResourceID)
{{{

	/*
	 * This boss class supports two interfaces:
	 * IActionComponent and IPMPersist.
     *
	 * 
	 * @ingroup kohakubooksearch
	 */
	Class
	{
		kKBSActionComponentBoss,
		kInvalidClass,
		{
			// Handle the actions from the menu.
			IID_IACTIONCOMPONENT, kKBSActionComponentImpl,
			// Persist the state of the menu across application instantiation. Implementation provided by the API.
			IID_IPMPERSIST, kPMPersistImpl
		}
	},

    /*
	 * This boss class inherits from an API panel boss class, and
	 * adds an interface to control a pop-up menu on the panel.
	 * The implementation for this interface is provided by the API.
     *
	 * 
	 * @ingroup kohakubooksearch
	 */
	Class
	{
		kKBSPanelWidgetBoss,
		kPalettePanelWidgetBoss,
		{
			/*
			 * The plug-in's implementation of ITextControlData with an exotic IID of IID_IPANELMENUDATA.
			 * Implementation provided by the API.
			 */
			IID_IPANELMENUDATA, kCPanelMenuDataImpl,
			/*
			 * Observer whose only job is the tab's name: the panel is rebuilt every time it is
			 * shown, and the palette that draws the tab is only laid out while it is visible, so
			 * the scope has to be (re)written the moment the panel appears. See KBSPanelTitle.cpp.
			 */
			IID_IOBSERVER, kKBSPanelObserverImpl,
		}
	},

	/*
	 * Result tree list (Task 2): the tree-view widget carrying our hierarchy adapter and row
	 * widget manager. The framework provides the tree controller and default event handling
	 * (selection, expand/collapse); the row-click jump handler arrives in Task 3.
	 */
	Class
	{
		kKBSResultListWidgetBoss,
		kTreeViewWidgetBoss,
		{
			IID_ITREEVIEWHIERARCHYADAPTER, kKBSResultListAdapterImpl,
			IID_ITREEVIEWWIDGETMGR, kKBSResultListWidgetMgrImpl,
		}
	},

	/*
	 * The hit line's multi-colour text cell (Task 2): a generic panel widget whose IControlView
	 * is our self-drawing view (KBSColorTextView), plus the per-row draw data it paints.
	 */
	Class
	{
		kKBSColorTextWidgetBoss,
		kGenericPanelWidgetBoss,
		{
			IID_ICONTROLVIEW, kKBSColorTextViewImpl,
			IID_IKBSROWDATA, kKBSRowDataImpl,
		}
	},

	/*
	 * Result tree row (Task 3): the node boss now carries the click handler that jumps to a hit.
	 * Shared by the chapter and hit row resources; the handler tells them apart by the node index
	 * (only hit rows jump).
	 */
	Class
	{
		kKBSResultNodeWidgetBoss,
		kTreeNodeWidgetBoss,
		{
			IID_IEVENTHANDLER, kKBSResultNodeEHImpl,
		}
	},

	/*
	 * The hit row's check box (replace feature): a STOCK check box with our observer aggregated on
	 * it, so a click flips that hit's "replace me" flag. The system draws the box, so it follows
	 * the UI theme and needs no icon resources of ours - the layer panel's eyeball pattern
	 * (source/open/components/layerpanel). Only the hit row resource carries one.
	 */
	Class
	{
		kKBSResultCheckWidgetBoss,
		kCheckBoxWidgetBoss,
		{
			IID_IOBSERVER, kKBSResultCheckObserverImpl,
		}
	},

	/*
	 * Draw-event-handler service boss (Task 3): registers kDrawEventService (via IK2ServiceProvider)
	 * so the sibling IDrwEvtHandler is hooked into the draw-event dispatcher at startup; it draws
	 * the translucent red marker rectangle around a jumped-to hit.
	 */
	Class
	{
		kKBSDrawEventServiceBoss,
		kInvalidClass,
		{
			IID_IK2SERVICEPROVIDER, kKBSDrawEventSrvcImpl,
			IID_IDRWEVTHANDLER,     kKBSDrawEventHandlerImpl,
		}
	},

	/*
	 * Marker-expiry idle task boss (Task 3): a one-shot idle task, armed each time the marker is
	 * shown, that takes it back off the screen a second later. IID_IIDLETASK comes from ShuksanID.h.
	 */
	Class
	{
		kKBSMarkerExpiryIdleTaskBoss,
		kInvalidClass,
		{
			IID_IIDLETASK, kKBSMarkerExpiryIdleTaskImpl,
		}
	},

	/*
	 * Startup/shutdown service boss (Task 3): retires the marker idle task and clears module state
	 * during controlled shutdown. kLazyStartupShutdownProviderImpl (API-provided) registers it.
	 */
	Class
	{
		kKBSStartupShutdownBoss,
		kInvalidClass,
		{
			IID_ISTARTUPSHUTDOWN, kKBSStartupShutdownImpl,
			IID_IK2SERVICEPROVIDER, kLazyStartupShutdownProviderImpl,
		}
	},

	/*
	 * Book-close watcher: retires a BOOK-scope result set when the book it was searched in is
	 * closed - the book half of what KBSCloseDocResponder does for a single document. Books have
	 * no signal to responder-register for (not one of the SDK's signal ServiceIDs comes from
	 * BookID.h), so this has to be an observer.
	 *
	 * The AddIn goes on kSessionBoss because that is the subject the cue is broadcast from:
	 * kCloseBookCmdBoss @ kSessionBoss, protocol IID_IBOOKCONTENT - read off a debug build's
	 * Test > Spy. The attach itself is in KBSBookWatch.cpp; this line only puts our IID, and so
	 * the observer implementation, onto the session.
	 */
	AddIn
	{
		kSessionBoss,
		kInvalidClass,
		{
			IID_IKBSBOOKWATCH, kKBSBookWatchImpl,
		}
	},

	/*
	 * Close-document responder boss: retires a DOCUMENT-scope result set when the searched document
	 * is closed - a row naming a closed document would still jump, and Change Checked would still
	 * reopen it to replace in it. Book results are left to the book-side responder.
	 *
	 * A boss that answers ONE signal does not need a ServiceProvider of its own: naming the API's
	 * kBeforeCloseDocSignalRespServiceImpl (DocumentID.h) registers this responder for that signal.
	 * CServiceProvider + HasMultipleIDs is only for a boss that answers several, as in
	 * linksui/ClosingDocumentsResponder.cpp. IID_IRESPONDER comes from ShuksanID.h, included above.
	 */
	Class
	{
		kKBSCloseDocResponderBoss,
		kInvalidClass,
		{
			IID_IK2SERVICEPROVIDER, kBeforeCloseDocSignalRespServiceImpl,
			IID_IRESPONDER,         kKBSCloseDocResponderImpl,
		}
	},

	/*
	 * Scripting provider: serves app.kbsStatus. Derives from kBaseScriptProviderBoss, which brings
	 * the machinery that dispatches script requests; all this boss adds is our own handler. The
	 * property itself is declared in the VersionedScriptElementInfo resource at the end of this file.
	 */
	Class
	{
		kKBSScriptProviderBoss,
		kBaseScriptProviderBoss,
		{
			IID_ISCRIPTPROVIDER, kKBSScriptProviderImpl,
		}
	},

}}};

