/*  
 * Menu definition.
 */
resource MenuDef (kSDKDefMenuResourceID)
{
	{
		// The About sub-menu item for this plug-in.
		kKBSAboutActionID,			// ActionID (kInvalidActionID for positional entries)
		kKBSAboutMenuPath,			// Menu Path.
		kSDKDefAlphabeticPosition,											// Menu Position.
		kSDKDefIsNotDynamicMenuFlag,										// kSDKDefIsNotDynamicMenuFlag or kSDKDefIsDynamicMenuFlag

		// Separator for the popup menu on the panel
		kKBSSeparator1ActionID,
		kKBSInternalPopupMenuNameKey kSDKDefDelimiterAndSeparatorPath,	// :- to mark an item as a separator.
		kKBSSeparator1MenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Search Book: run the book-wide search using the current Find/Change settings.
		kKBSSearchBookActionID,
		kKBSTargetMenuPath
		kKBSSearchBookMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Separator between the search command and the toggles.
		kKBSSeparator2ActionID,
		kKBSInternalPopupMenuNameKey kSDKDefDelimiterAndSeparatorPath,	// :- to mark an item as a separator.
		kKBSSeparator2MenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Book Scope: toggle (check mark). ON = the whole book, OFF = the front document.
		kKBSScopeBookActionID,
		kKBSTargetMenuPath
		kKBSBookScopeMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Hide Previous Chapter: toggle (check mark). Closes the previous chapter window on jump.
		kKBSHidePrevChapterActionID,
		kKBSTargetMenuPath
		kKBSHidePrevChapterMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Separator between the search/scope toggles and the replace block.
		kKBSSeparator3ActionID,
		kKBSInternalPopupMenuNameKey kSDKDefDelimiterAndSeparatorPath,	// :- to mark an item as a separator.
		kKBSSeparator3MenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Change Checked: replace every checked hit with the Find/Change dialog's change string.
		kKBSReplaceCheckedActionID,
		kKBSTargetMenuPath
		kKBSReplaceCheckedMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Check All / Uncheck All: select every stored hit for replacement, or none.
		kKBSCheckAllActionID,
		kKBSTargetMenuPath
		kKBSCheckAllMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKBSUncheckAllActionID,
		kKBSTargetMenuPath
		kKBSUncheckAllMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// About this plug-in sub-menu for the popup menu on the panel
		kKBSPopupAboutThisActionID,
		kKBSTargetMenuPath
		kKBSAboutThisMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

	}
};

/* 
 * Action definition.
 */
resource ActionDef (kSDKDefActionResourceID)
{
	{
		kKBSActionComponentBoss, 		// ClassID of boss class that implements the ActionID.
		kKBSAboutActionID,	// ActionID.
		kKBSAboutMenuKey,	// Sub-menu string.
		kOtherActionArea,				// Area name (see ActionDefs.h).
		kNormalAction,					// Type of action (see ActionDefs.h).
		kDisableIfLowMem,				// Enabling type (see ActionDefs.h).
		kInvalidInterfaceID,			// Selection InterfaceID this action cares about or kInvalidInterfaceID.
		kSDKDefInvisibleInKBSCEditorFlag, // kSDKDefVisibleInKBSCEditorFlag or kSDKDefInvisibleInKBSCEditorFlag.

		kKBSActionComponentBoss,
		kKBSPopupAboutThisActionID,
		kSDKDefAboutThisPlugInMenuKey,	// Key to the name of this action
		kOtherActionArea,
		kNormalAction,
		kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// The search command. kCustomEnabling is what lets UpdateActionStates rename it to
		// "Search Book" / "Search Document" as the Book Scope toggle flips; without it that hook
		// is never called for this action.
		// NOT kDisableIfNoFrontDocument: a book search runs off IBookManager's active book and opens
		// its chapters windowless, so "a book is open but no document window is" is a normal, working
		// state here. That flag would grey this out - and skip UpdateActionStates, losing the name -
		// exactly when the panel is most useful. The Layers panel can afford it; this one cannot.
		kKBSActionComponentBoss,
		kKBSSearchBookActionID,
		kKBSSearchBookMenuKey,			// "Search" (renamed at run time to carry the scope)
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKBSActionComponentBoss,
		kKBSScopeBookActionID,
		kKBSBookScopeMenuKey,			// "Book Scope" (toggle, check mark)
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKBSActionComponentBoss,
		kKBSHidePrevChapterActionID,
		kKBSHidePrevChapterMenuKey,		// "Hide Previous Chapter" (toggle, check mark)
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Change Checked. kCustomEnabling so UpdateActionStates can grey it out while nothing is
		// checked - the same flag the toggles need. Guarding it against closed documents has to
		// happen in UpdateActionStates (per-hit, via KBSBookScope::IsDocStillOpen), NOT with
		// kDisableIfNoFrontDocument: replacing in windowless book chapters is a supported case.
		kKBSActionComponentBoss,
		kKBSReplaceCheckedActionID,
		kKBSReplaceCheckedMenuKey,		// "Change Checked"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Check All / Uncheck All. kCustomEnabling so UpdateActionStates can grey them out when
		// there are no results to check.
		kKBSActionComponentBoss,
		kKBSCheckAllActionID,
		kKBSCheckAllMenuKey,			// "Check All"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKBSActionComponentBoss,
		kKBSUncheckAllActionID,
		kKBSUncheckAllMenuKey,			// "Uncheck All"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

	}
};


