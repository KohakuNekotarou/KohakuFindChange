/*  
 * Type definition.
 */
type KBSPanelWidget(kViewRsrcType) : PalettePanelWidget(ClassID = kKBSPanelWidgetBoss)
{
	CPanelMenuData;
};

/*
 * Result tree types (Task 2). The list on our tree boss; the row on the STOCK tree node boss
 * (nothing to replace on it yet - the row-click handler arrives in Task 3), shared by the
 * chapter and hit row resources; the hit line's colour cell on our generic-panel boss.
 */
type KBSResultListWidget(kViewRsrcType) : TreeViewWidget(ClassID = kKBSResultListWidgetBoss)
{
};

type KBSResultNodeWidget(kViewRsrcType) : PrimaryResourcePanelWidget(ClassID = kKBSResultNodeWidgetBoss)
{
};

type KBSColorTextWidget(kViewRsrcType) : GenericPanelWidget(ClassID = kKBSColorTextWidgetBoss)
{
};

type KBSResultCheckWidget(kViewRsrcType) : CheckBoxWidget(ClassID = kKBSResultCheckWidgetBoss)
{
};

/*
 * The panel's illustration. KBSIconWidget rather than the plain RollOverIconButtonWidget so that it
 * comes up on kKBSIconWidgetBoss and therefore carries IID_ITIP (the tooltip naming the URL).
 */
type KBSIconWidget(kViewRsrcType) : RollOverIconButtonWidget(ClassID = kKBSIconWidgetBoss)
{
};

/*
 * The illustration's artwork, compiled into the plug-in. The same image is given to the normal
 * (PNGA) and rollover (PNGR) states: the picture is a link, not a control that changes state, so
 * there is no second look for it to take. KESCM does the same with its status icon.
 *
 * !! Replacing the .png alone does NOT reach a build - the build watches the .fr's timestamp, not
 *   the image's, so the icon compile step is skipped and the old artwork is linked again (the
 *   .pln's own date still moves, which is what makes this hard to spot). Touch this file after
 *   swapping the picture.
 */
resource PNGA(kKBSIconResID) "Kohakuneko_OFF32.png"
resource PNGR(kKBSIconResID) "Kohakuneko_OFF32.png"
resource PNGA(kKBSIconFoundResID) "KohakuFind32.png"
resource PNGR(kKBSIconFoundResID) "KohakuFind32.png"
resource PNGA(kKBSIconChangedResID) "KohakuChange32.png"
resource PNGR(kKBSIconChangedResID) "KohakuChange32.png"

/*
 * The small dock-tab icon, shown in place of the tab's name once the panel is collapsed to its
 * narrowest. Named by the PanelList entry above (kKBSPaletteIconResID, kKBSPluginID), which is
 * where a palette is told which picture is its own - it is NOT a widget, so there is no Frame and
 * no rollover state to give it.
 */
resource PNGA(kKBSPaletteIconResID) "KohakuFindChangeTab.png"

/*
 * The Glyph tab's replace confirmation. "DialogBoss" is the exotic name of what is really a widget;
 * WidgetEveInfo is what lets the dialog lay itself out with EVE (basicdialog's BscDlg.fr does the
 * same). The glyph frame inherits EVEGenericPanelWidget, which already carries WidgetEveInfo, so
 * the frame takes part in that layout while its IControlView is ours.
 */
type KBSReplaceConfirmDialogWidget(kViewRsrcType) : DialogBoss(ClassID = kKBSReplaceConfirmDialogBoss)
{
	WidgetEveInfo;
};

// A LEAF, not a container: it holds a drawing, not child widgets. That distinction is what decides
// its size under EVE - a panel widget is measured from its children, so an empty one collapses to
// nothing (which is exactly what happened when this inherited EVEGenericPanelWidget: the frame
// vanished and the font name sat directly under the label). The shape here is the one EveInfo.fh
// uses for its own leaves - see EVEButtonBarWidget: CControlView plus WidgetEveInfo, and no
// CPanelControlData - so the Frame written in the resource is the size EVE lays out.
type KBSGlyphViewWidget(kViewRsrcType) : Widget(ClassID = kKBSGlyphViewWidgetBoss)
{
	CControlView;
	WidgetEveInfo;
};

/*  
 * PanelList definition.
 */
resource PanelList (kSDKDefPanelResourceID)
{
	{
		// 1st panel in the list
		kSDKDefPanelResourceID,		// Resource ID for this panel (use SDK default rsrc ID)
		kKBSPluginID,			// ID of plug-in that owns this panel
		kIsResizable,
		kKBSPanelWidgetActionID,	// Action ID to show/hide the panel
		"",							// panelName empty: placed via altMenu below (Plug-Ins menu, not Window) - like KESCL/KESCM.
		kKBSPanelPluginsMenuPath,	// Plug-Ins > KohakuNekotarou > KohakuBookSearch
		kKBSPanelPluginsMenuPosition,	// Alternate menu position
		kKBSPaletteIconResID, kKBSPluginID,	// PNG icon for the collapsed dock tab
		c_Panel
	}
};

/* 
 * PanelView definition.
 * Note: it is not necessary to use EVE for panels.
 * The view is not currently localised: therefore, it can reside here.
 * However, if you wish to localise it, it is recommended to locate it in one of
 * the localised framework resource files (i.e. KBS_enUS.fr etc.).
 */
resource KBSPanelWidget(kSDKDefPanelResourceID + index_enUS)
{
	__FILE__, __LINE__,					// Localization macro
	kKBSPanelWidgetID,					// WidgetID
	kPMRsrcID_None,						// RsrcID
	kBindNone,							// Binding (0=none)
	Frame(0, 0, 300, 360),				// Default size (207x32 -> 300x360 with the result tree,
										// Task 2). Resizable (kIsResizable in PanelList).
	kTrue, kTrue,						// Visible, Enabled
	kTrue,								// Erase background (kFalse -> kTrue with the tree)
	kInterfacePaletteFill,				// Erase to color
	kFalse,								// Draw dropshadow
	kKBSPanelTitleKey,					// Panel name
	{
		// Status read-out at the top: the search summary (total hits / chapters, or a scan's own
		// tally). WRAPPING over several lines, not one line ellipsized (user's call 2026-08-02): the
		// summaries outgrew a single line some time ago - a scan appends "Text in overset cannot be
		// checked.", a book search can append the names of chapters it could not open - and the end
		// of the sentence was the part being thrown away. Bound left/right/top so it widens with
		// the panel and stays put vertically.
		//
		// ***** THE HEIGHT MUST BE A WHOLE NUMBER OF LINES. ***** A line is 12px here (measured
		// 2026-08-04 off a screenshot: four baselines 11.8px apart), so 48 = exactly four. The frame
		// was 52 - four lines and 4px over - and the widget draws into whatever room it is given:
		// narrowing the panel pushed the text to five lines and the TOP 4px OF THE FIFTH appeared
		// below the fourth, a sliver of chopped-off letters (user's screenshot, work/キャプチャ.PNG).
		// A remainder of zero leaves nothing for a part-line to be drawn into.
		//
		// ! The old comment here said "3 lines at ~17px", which is what made 52 look right. It was
		// never measured. If the palette font ever changes size, measure again - the rule is the
		// remainder, not the number 48.
		StaticMultiLineTextWidget
		(
			kKBSStaticTextWidgetID,			 // WidgetId
			kPMRsrcID_None,					 // RsrcId
			kBindLeft | kBindRight | kBindTop, // Frame binding
			Frame(5, 6, 256, 54),			 // Frame: left, top, right, bottom (48px = four 12px lines)
			kTrue, kTrue,					 // Visible, Enabled
			// StaticTextAttributes: alignment, ellipsize style, convert ampersands. kDontEllipsize
			// because a wrapping box has somewhere to put the rest of the sentence - the whole point
			// of the change - and a "..." would throw it away again on the last line.
			kAlignLeft, kDontEllipsize, kTrue,
			// StaticMultiLineTextAttr: scroll bar widget, font, pixels between lines, inset.
			// No scroll bar: three lines are the budget, and one that appeared would sit on top of
			// the illustration. The rest are KESCM's values for the same kind of box.
			kInvalidWidgetID,
			kPaletteWindowFontId,
			4,
			2, 0,
			kKBSStaticTextKey				// Initial text.
		),

		/* The panel's illustration, to the right of the message: hover it for the plug-in's home
		 * page, click it to go there (KBSIconTip supplies the tip text, the panel's own observer
		 * hears the click). Bound RIGHT so it keeps its place beside the message as the panel is
		 * resized - KESCM binds its own to the top alone, but that panel does not resize the way
		 * this one does.
		 *
		 * 32x32, sitting on the BOTTOM of the message block (top 22 = 54 - 32), which is where
		 * KESCM puts its own: a picture hanging off the top of a part-empty message box reads as
		 * detached from it. It moved up with the message box on 2026-08-04 - the two share a bottom
		 * edge, and that is the whole of why this number is what it is.
		 *
		 * THREE of them, STACKED at one frame: the plain cat until something has been run, the
		 * searching cat once it has, and the changing cat once a replace has written something.
		 * KBSPanelIcon owns which - it is the only place that names them, so a fourth picture is a
		 * widget here and a row there. All but the first come up HIDDEN; KBSPanelIcon writes the real
		 * answer when the panel appears, because these widgets are rebuilt on every show and a
		 * default written here would otherwise outrank the actual state.
		 */
		KBSIconWidget
		(
			kKBSIconWidgetID,
			kKBSIconResID, kKBSPluginID,
			kBindRight | kBindTop,
			Frame(260, 22, 292, 54),		// 4px clear of the text, 8px in from the panel's edge
			kTrue, kTrue,
			kADBEIconSuiteButtonType,
		),
		KBSIconWidget
		(
			kKBSIconFoundWidgetID,
			kKBSIconFoundResID, kKBSPluginID,
			kBindRight | kBindTop,
			Frame(260, 22, 292, 54),		// SAME frame as the one above - they are alternatives
			kFalse, kTrue,
			kADBEIconSuiteButtonType,
		),
		KBSIconWidget
		(
			kKBSIconChangedWidgetID,
			kKBSIconChangedResID, kKBSPluginID,
			kBindRight | kBindTop,
			Frame(260, 22, 292, 54),		// SAME frame again
			kFalse, kTrue,
			kADBEIconSuiteButtonType,
		),

		// Result tree: chapter -> hit rows, filling the rest of the panel and bound to all four
		// edges so it grows with the window. Root hidden, single selection, vertical scroll bar
		// only; scroll increments = one 19px row.
		KBSResultListWidget
		(
			kKBSResultListWidgetID, kPMRsrcID_None,	// WidgetId, RsrcId
			kBindAll,						// Frame binding: grow with the panel
			Frame(4, 57, 296, 356),			// Frame (below the message block to the panel's edges)
											// Moved up 4px with the message box on 2026-08-04, so the
											// gap under it stays the 3px it always was.
			kTrue, kTrue,					// Visible, Enabled
			kTrue,							// EraseBeforeDraw
			kInterfacePaletteFill,			// InterfaceColor
			"",								// Panel name
			kHideRootNode,					// Options: the root is not a row
			kFalse,							// Use H scroll bar
			kTrue,							// Use V scroll bar
			19,								// fVScrollButtonIncrement (one row)
			19,								// fVThumbScrollIncrement
			19,								// fHScrollButtonIncrement (unused, no H bar)
			19,								// fHThumbScrollIncrement
			1,								// Items selectable: 1 = single selection
			kFalse,							// Allow children from multiple parents to be selected
			kFalse,							// Allow discontiguous selection
			{
			},
		),
	}

	kKBSInternalPopupMenuNameKey		// Popup menu name (internal)
};

/*
 * One CHAPTER row of the result tree, created at runtime by KBSResultListWidgetMgr for chapter
 * nodes: a stock expander arrow (hidden by the widget manager on a childless chapter - never in
 * practice) and the chapter's "<name>  (N)" label after the expander's zone. The widget manager
 * owns the runtime layout; these frames are only the default state.
 */
resource KBSResultNodeWidget(kKBSResultChapterNodeWidgetRsrcID + index_enUS)
{
	__FILE__, __LINE__,
	kKBSResultChapterNodeWidgetID, kPMRsrcID_None,	// WidgetId, RsrcId
	kBindLeft | kBindRight,				// Frame binding: follow the list's width
	Frame(0, 0, 296, 19),				// Frame (left, top, right, bottom)
	kTrue, kTrue,						// Visible, Enabled
	"",									// Panel name
	{
		// The expand / collapse arrow (stock part; the tree framework owns its clicks and its
		// collapsed / expanded state icon). Field-for-field the paneltreeview sample's.
		TreeExpanderWidget
		(
			kTreeNodeExpanderWidgetID,		// WidgetId
			kTreeBranchCollapsedRsrcID,		// RsrcId for collapsed node icon
			kApplicationRsrcPluginID,		// RsrcPlugin for collapsed node icon
			kBindNone,						// Frame binding
			Frame(2, 1, 18, 17),			// Frame (inside the 19px row)
			kTrue, kTrue,					// Visible, Enabled
			kTreeBranchExpandedRsrcID, 		// RsrcId for expanded node icon
			kApplicationRsrcPluginID,		// RsrcPlugin for expanded node icon
			kTrue,							// Cmd-Click expands/collapses children
			kFalse,							// Scroll to show children when expanded
			kIconNoCentering,
			kIconRaisedLook,				// Icon look
			kFalse							// Draws a well
		),

		InfoStaticTextWidget
		(
			kKBSResultChapterLabelWidgetID,	// WidgetId
			kPMRsrcID_None,					// RsrcId
			kBindLeft | kBindRight,			// Frame binding: take the rest of the row
			Frame(18, 1, 292, 17),			// Frame
			kTrue, kTrue,					// Visible, Enabled
			kAlignLeft,						// Alignment
			kEllipsizeEnd, kTrue,			// Ellipsize style, Convert ampersands
			"",								// Text Control Data
			0,								// WidgetId for associated control for shortcut focus
			kPaletteWindowSystemScriptFontId, kPaletteWindowSystemScriptFontId,
		),
	}
};

/*
 * One HIT row of the result tree: the match's line in the custom multi-colour text cell
 * (KBSColorTextView highlights the matched part). No expander (a leaf); the widget manager
 * indents the cell one expander zone deeper than the chapter row's text at apply time, so this
 * frame is only the default state.
 */
resource KBSResultNodeWidget(kKBSResultHitNodeWidgetRsrcID + index_enUS)
{
	__FILE__, __LINE__,
	kKBSResultHitNodeWidgetID, kPMRsrcID_None,	// WidgetId, RsrcId
	kBindLeft | kBindRight,				// Frame binding: follow the list's width
	Frame(0, 0, 296, 19),				// Frame (left, top, right, bottom)
	kTrue, kTrue,						// Visible, Enabled
	"",									// Panel name
	{
		// The "replace me" check box. A stock check box drawn by the system (kSysCheckBoxPMRsrcId),
		// so it matches the UI theme with no icon art of ours. The widget manager re-places it and
		// pushes its state in on every apply; its observer flips the model when it is clicked.
		KBSResultCheckWidget
		(
			kKBSResultCheckWidgetID, kSysCheckBoxPMRsrcId,	// WidgetId, RsrcId
			kBindLeft | kBindTop | kBindBottom,	// Frame binding: stay at the row's left
			Frame(34, 1, 50, 17),			// Frame (the widget manager re-places it)
			kTrue, kTrue,					// Visible, Enabled
			kAlignLeft,						// Alignment
			"",								// No label: the box alone
		),

		KBSColorTextWidget
		(
			kKBSResultTextWidgetID, kPMRsrcID_None,	// WidgetId, RsrcId
			kBindLeft | kBindRight,			// Frame binding: take the rest of the row
			Frame(50, 1, 292, 17),			// Frame (indented; the widget manager re-places it)
			kTrue, kTrue,					// Visible, Enabled
			"",								// Panel name
			{
			}
		),
	}
};


/*
 * Scripting: app.kfcStatus - the panel's status line, readable from a script.
 *
 * One read-only string property on the application object. What it is for is verification: the
 * panel reports what a search or a replace did in a single line, and without this the only way to
 * read that line is to look at the screen. With it, a script - or PowerShell over COM - can run the
 * command and then read the answer:
 *
 *     app.menuActions.itemByName("Search").invoke();
 *     app.kfcStatus;      // "1234 hit(s) in 5 of 12 chapter(s) - book "x.indb"."
 *
 * !! WHICH NAME finds this action MOVES (measured 2026-08-02). itemByName matches the name the
 *   action currently CARRIES, and UpdateActionStates renames it - so "Search", the resource name, is
 *   only good until the flyout is first drawn (or until any script reads .enabled, which runs the
 *   same hook); after that the action answers to "Find in Document" or "Find in Book", whichever the
 *   scope last called for, and "Search" answers isValid = false. A script that has to reach it
 *   reliably tries all three and takes the one that is valid.
 *
 * The value lives in the module, not on the widget (KBSResultTree::GetLastStatus), so it answers
 * with the panel closed as well.
 *
 * The four-character ScriptID is allocated in docs/ai-notes/kes-scriptid-registry.md - what an
 * engine matches on is that code, not the C++ name, so two plug-ins that pick the same four
 * characters cannot be told apart.
 */
resource VersionedScriptElementInfo(1)
{
	// Contexts. Declared from the oldest version this could have worked in, which is how the SDK's
	// own samples do it - a later application still honours it.
	{
		kCS2ScriptVersion, kCoreScriptManagerBoss, kWildFS, k_Wild,
	}

	// Elements
	{
		Property
		{
			kKBSStatusPropertyScriptElement,	// this property's script element ID
			p_KBSStatus,						// ScriptID (KBSScriptingDefs.h)
			"kfc status",						// name -> app.kfcStatus
			"The last message the Kohaku Find/Change panel put on its status line.",	// description
			StringType,							// type
			{}									// alternate types
			kNoAttributeClass,					// attribute class ID
		}

		// The rows behind that sentence. Same reason to exist, one level down: the status line
		// proves the COUNTS, this proves which ROW carries "missing", which one lost its check box
		// to a lock, and what page each one says it is on. None of that is on the status line, and
		// reading it off the screen cannot be automated.
		Property
		{
			kKBSResultsPropertyScriptElement,	// this property's script element ID
			p_KBSResults,						// ScriptID (KBSScriptingDefs.h)
			"kfc results",						// name -> app.kfcResults
			"Every row the Kohaku Find/Change panel is holding, tab-separated, one hit per line.",
			StringType,							// type
			{}									// alternate types
			kNoAttributeClass,					// attribute class ID
		}

		// Puts the property ON the application object.
		//
		// Object{}, not Parent{}. They are different questions: Object names an EXISTING scripting
		// object to add members to, while Parent hangs a NEW object underneath one (which is what a
		// plug-in with its own preferences object needs, and what this first tried - the property
		// then never appeared on app at all). BPI.fr:603-612 is the form being followed here.
		Provider
		{
			kKBSScriptProviderBoss,
			{
				Object{ kApplicationObjectScriptElement },
				Property{ kKBSStatusPropertyScriptElement, kReadOnly },
				Property{ kKBSResultsPropertyScriptElement, kReadOnly },
			}
		}
	}
};

/*
 * The Glyph tab's replace confirmation.
 *
 * What this has that the plain alert cannot have is the two glyphs themselves, drawn in the font
 * that defines them. On that tab the query IS a glyph, and a glyph drawn as a character would come
 * out as the STANDARD form - an alternate form shares its Unicode with it - which would be a lie in
 * the one place the user authorises a rewrite.
 *
 * Laid out with EVE: a column of (sentence / the two frames side by side / sentence / check box /
 * buttons), and each frame is a column of (label / glyph / font name / Unicode). The two lines under
 * a frame are optional and the controller hides them when there is nothing to say - an alternate
 * form has no Unicode, and an empty Change To box has no font either.
 *
 * Cancel is the DEFAULT button (user's decision, 2026-07-31): Enter must not start a rewrite. The
 * plain CAlert lost that guard when it gained its "don't show again" box - WarningAlertWithDont-
 * ShowAgain takes no default-button argument - and a dialog of our own is what gets it back.
 * EVEDefaultButtonWidget means "the default button", not "the OK button"; linksui's ProblemLinks
 * dialog likewise gives it a label of its own.
 */
resource KBSReplaceConfirmDialogWidget (kSDKDefDialogResourceID + index_enUS)
{
	__FILE__, __LINE__,
	kKBSReplaceConfirmDialogWidgetID,	// WidgetID
	kPMRsrcID_None,					// RsrcID
	kBindNone,						// Binding
	Frame(0, 0, 380, 300)			// Frame (l,t,r,b) - EVE resizes it to fit the children
	kTrue, kTrue,					// Visible, Enabled
	kKBSPanelTitleKey,				// Dialog name
	{
		// ----- "Change N checked hits?" -----
		EVEStaticTextWidget
		(
			kKBSReplaceConfirmCountWidgetID,	// WidgetId
			kSysStaticTextPMRsrcId,			// RsrcId
			kBindNone,						// Frame binding
			Frame(0, 0, 340, 20)			// Frame (l,t,r,b)
			kTrue, kTrue, kAlignLeft,		// Visible, Enabled, Alignment
			kDontEllipsize, kFalse,			// Ellipsize style, Convert ampersands
			"",								// Text (the controller fills it)
			0								// Associated control for shortcut focus

			kEVEAlignLeft | kEVELargeSpaceAfter,
		),

		// ----- the two glyph frames, side by side (Glyph tab only) -----
		// Named as a BLOCK so the Text / GREP layout can hide the whole thing in one call; hiding
		// the children one by one leaves EVE holding the row's height.
		EVEGenericPanelWidget
		(
			kKBSReplaceConfirmGlyphBlockWidgetID,	// WidgetId
			0						// RsrcId
			0,						// Widget EVE Info
			kBindNone,				// Frame binding
			Frame(0, 0, 340, 150)	// Frame
			kTrue,					// Visible
			kTrue,					// Enabled
			kEVEAlignCenter | kEVELargeSpaceAfter | kEVEArrangeChildrenInRow,

			{
				// --- the glyph being searched for ---
				EVEGenericPanelWidget
				(
					kInvalidWidgetID,
					0
					0,
					kBindNone,
					Frame(0, 0, 145, 150)
					kTrue,
					kTrue,
					kEVEAlignCenter |kEVELargeSpaceAfter | kEVEArrangeChildrenInColumn | kEVEChildAlignCenter,

					{
						EVEStaticTextWidget
						(
							kInvalidWidgetID,
							kSysStaticTextPMRsrcId,
							kBindNone,
							Frame(0, 0, 140, 18)
							kTrue, kTrue, kAlignCenter,
							kDontEllipsize, kFalse,
							kKBSGlyphConfirmFindLabelKey,	// "Find"
							0

							kEVEAlignCenter | kEVESmallSpaceAfter,
						),

						KBSGlyphViewWidget
						(
							kKBSGlyphConfirmFindGlyphWidgetID,
							kPMRsrcID_None,
							kBindNone,
							Frame(0, 0, 72, 72)
							kTrue, kTrue,

							kEVEAlignCenter | kEVESmallSpaceAfter,
						),

						EVEStaticTextWidget
						(
							kKBSGlyphConfirmFindFontWidgetID,
							kSysStaticTextPMRsrcId,
							kBindNone,
							Frame(0, 0, 140, 18)
							kTrue, kTrue, kAlignCenter,
							kEllipsizeEnd, kFalse,
							"",								// the controller fills it
							0

							kEVEAlignCenter | kEVENoSpaceAfter,
						),

						EVEStaticTextWidget
						(
							kKBSGlyphConfirmFindUnicodeWidgetID,
							kSysStaticTextPMRsrcId,
							kBindNone,
							Frame(0, 0, 140, 18)
							kTrue, kTrue, kAlignCenter,
							kDontEllipsize, kFalse,
							"",								// the controller fills or hides it
							0

							kEVEAlignCenter | kEVENoSpaceAfter,
						),
					}
				),

				// --- the arrow between them ---
				EVEStaticTextWidget
				(
					kInvalidWidgetID,
					kSysStaticTextPMRsrcId,
					kBindNone,
					Frame(0, 0, 30, 18)
					kTrue, kTrue, kAlignCenter,
					kDontEllipsize, kFalse,
					kKBSGlyphConfirmArrowKey,		// "->"
					0

					kEVEAlignCenter | kEVELargeSpaceAfter,
				),

				// --- the glyph that will be written ---
				EVEGenericPanelWidget
				(
					kInvalidWidgetID,
					0
					0,
					kBindNone,
					Frame(0, 0, 145, 150)
					kTrue,
					kTrue,
					kEVEAlignCenter |kEVENoSpaceAfter | kEVEArrangeChildrenInColumn | kEVEChildAlignCenter,

					{
						EVEStaticTextWidget
						(
							kInvalidWidgetID,
							kSysStaticTextPMRsrcId,
							kBindNone,
							Frame(0, 0, 140, 18)
							kTrue, kTrue, kAlignCenter,
							kDontEllipsize, kFalse,
							kKBSGlyphConfirmChangeLabelKey,	// "Change to"
							0

							kEVEAlignCenter | kEVESmallSpaceAfter,
						),

						KBSGlyphViewWidget
						(
							kKBSGlyphConfirmChangeGlyphWidgetID,
							kPMRsrcID_None,
							kBindNone,
							Frame(0, 0, 72, 72)
							kTrue, kTrue,

							kEVEAlignCenter | kEVESmallSpaceAfter,
						),

						EVEStaticTextWidget
						(
							kKBSGlyphConfirmChangeFontWidgetID,
							kSysStaticTextPMRsrcId,
							kBindNone,
							Frame(0, 0, 140, 18)
							kTrue, kTrue, kAlignCenter,
							kEllipsizeEnd, kFalse,
							"",
							0

							kEVEAlignCenter | kEVENoSpaceAfter,
						),

						EVEStaticTextWidget
						(
							kKBSGlyphConfirmChangeUnicodeWidgetID,
							kSysStaticTextPMRsrcId,
							kBindNone,
							Frame(0, 0, 140, 18)
							kTrue, kTrue, kAlignCenter,
							kDontEllipsize, kFalse,
							"",
							0

							kEVEAlignCenter | kEVENoSpaceAfter,
						),
					}
				),
			}
		),

		// ----- Text / GREP: the whole prompt in one wrapped block -----
		// The same sentences the plain alert drew, assembled by KBSActionComponent and handed over
		// whole. ONE widget rather than a line each: the find and change strings are the user's own
		// and can be any length, and a wrapped block is what the alert gave them. Modelled on
		// linksui's ProblemLinksDialog, which is where the button arrangement below came from too.
		EVEStaticMultiLineTextWidget
		(
			kKBSReplaceConfirmMessageWidgetID, kSysStaticTextPMRsrcId,	// WidgetId, RsrcId
			kBindNone,
			Frame(0, 0, 340, 120)			// Frame (l,t,r,b) - EVE grows it to fit the text
			kTrue, kTrue, kAlignLeft,		// Visible, Enabled, Alignment
			kDontEllipsize, kTrue,			// Ellipsize style, Convert ampersands
			// StaticMultiLineTextAttr
			0,								// fScrollBarWidgetID
			kDialogWindowFontId;			// fFontID
			3,								// fNumPixelsBetweenLines
			0, 0,							// fInset
			"",								// Text (the controller fills it)

			kEVEAlignLeft | kEVELargeSpaceAfter,
		),

		// ----- "The chapter is opened and left UNSAVED..." -----
		EVEStaticTextWidget
		(
			kKBSReplaceConfirmUnsavedWidgetID,
			kSysStaticTextPMRsrcId,
			kBindNone,
			Frame(0, 0, 340, 20)
			kTrue, kTrue, kAlignLeft,
			kDontEllipsize, kFalse,
			"",									// the controller fills it
			0

			kEVEAlignLeft | kEVELargeSpaceAfter,
		),

		// A "Don't show again" check box stood here from 2026-07-28 to 2026-08-01. It was removed
		// because ticking it suppressed the confirmation for a DESTRUCTIVE rewrite permanently and
		// almost invisibly - the only way back is Preferences > General > Reset All Warning Dialogs.
		// The box below is the opposite bargain: it asks for MORE than the run would do on its own,
		// and it is asked every time rather than remembered.

		// ----- "Save each chapter after replace" -----
		// Drawn OFF every time - nothing writes to it on open and nothing remembers it between runs.
		// This overwrites the user's files, so it is asked per run rather than configured once.
		EVECheckBoxWidget
		(
			kKBSReplaceConfirmSaveWidgetID,	// WidgetId
			kSysCheckBoxPMRsrcId,			// RsrcId
			kBindNone,						// Frame binding
			Frame(0, 0, 340, 20)			// Frame (l,t,r,b)
			kTrue,							// Visible
			kTrue,							// Enabled
			kAlignLeft,						// Alignment
			kKBSSaveAfterReplaceKey,		// "Save each chapter after replace"

			kEVEAlignLeft | kEVENoSpaceAfter,
		),

		// What the box does BESIDES saving, said here rather than discovered afterwards.
		EVEStaticTextWidget
		(
			kKBSReplaceConfirmSaveNoteWidgetID,
			kSysStaticTextPMRsrcId,
			kBindNone,
			Frame(0, 0, 340, 32)
			kTrue, kTrue, kAlignLeft,
			kDontEllipsize, kFalse,
			kKBSSaveAfterReplaceNoteKey,
			0

			kEVEAlignLeft | kEVELargeSpaceAfter,
		),

		// ----- OK / Cancel (Cancel is the default - see the note above) -----
		EVEGenericPanelWidget
		(
			kInvalidWidgetID,
			0
			0,
			kBindNone,
			Frame(0, 0, 200, 24)
			kTrue,
			kTrue,
			kEVEAlignRight | kEVENoSpaceAfter | kEVEArrangeChildrenInRow,

			{
				EVEButtonWidget
				(
					kOKButtonWidgetID,
					kSysButtonPMRsrcId,
					kBindNone,
					Frame(0, 0, 0, 0)
					kTrue, kTrue,
					kSDKDefOKButtonApplicationKey,

					kEVERegularSpaceAfter,
				),

				EVEDefaultButtonWidget
				(
					kCancelButton_WidgetID,
					kSysButtonPMRsrcId,
					kBindNone,
					Frame(0, 0, 0, 0)
					kTrue, kTrue,
					kSDKDefCancelButtonApplicationKey,

					kEVERegularSpaceAfter,
				),
			}
		),
	},

	kEVEArrangeChildrenInColumn | kEVELargeMargin,
};

#endif // __ODFRC__

#include "KBS_enUS.fr"
#include "KBS_jaJP.fr"
