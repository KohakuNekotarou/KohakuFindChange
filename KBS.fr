/*  
 * Plugin version definition.
 */
resource PluginVersion (kSDKDefPluginVersionResourceID)
{
	kTargetVersion,
	kKBSPluginID,
	kSDKDefPlugInMajorVersionNumber, kSDKDefPlugInMinorVersionNumber,
	kSDKDefHostMajorVersionNumber, kSDKDefHostMinorVersionNumber,
	kKBSCurrentMajorFormatNumber, kKBSCurrentMinorFormatNumber,
	{ kInDesignProduct },
	{ kWildFS },
	kUIPlugIn,
	kKBSVersion
};

/*  
 * The ExtraPluginInfo resource adds extra information to the Missing Plug-in dialog
 * that is popped when a document containing this plug-in's data is opened when
 * this plug-in is not present. These strings are not translatable strings
 * since they must be available when the plug-in isn't around. They get stored
 * in any document that this plug-in contributes data to.
 */
resource ExtraPluginInfo(1)
{
	kKBSCompanyValue,			// Company name
	kKBSMissingPluginURLValue,	// URL 
	kKBSMissingPluginAlertValue,	// Missing plug-in alert text
};

/* 
 * Boss class definitions.
 */
resource ClassDescriptionTable(kSDKDefClassDescriptionTableResourceID)
{{{

	/*
	 * This boss class supports two interfaces:
	 * IActionComponent and IPMPersist.
     *
	 * 
	 * @ingroup kohakubooksearch
	 */
	Class
	{
		kKBSActionComponentBoss,
		kInvalidClass,
		{
			// Handle the actions from the menu.
			IID_IACTIONCOMPONENT, kKBSActionComponentImpl,
			// Persist the state of the menu across application instantiation. Implementation provided by the API.
			IID_IPMPERSIST, kPMPersistImpl
		}
	},

    /*
	 * This boss class inherits from an API panel boss class, and
	 * adds an interface to control a pop-up menu on the panel.
	 * The implementation for this interface is provided by the API.
     *
	 * 
	 * @ingroup kohakubooksearch
	 */
	Class
	{
		kKBSPanelWidgetBoss,
		kPalettePanelWidgetBoss,
		{
			/*
			 * The plug-in's implementation of ITextControlData with an exotic IID of IID_IPANELMENUDATA.
			 * Implementation provided by the API.
			 */
			IID_IPANELMENUDATA, kCPanelMenuDataImpl,
			/*
			 * Observer whose only job is the tab's name: the panel is rebuilt every time it is
			 * shown, and the palette that draws the tab is only laid out while it is visible, so
			 * the scope has to be (re)written the moment the panel appears. See KBSPanelTitle.cpp.
			 */
			IID_IOBSERVER, kKBSPanelObserverImpl,
			/*
			 * The panel's view replaced (2026-08-04): PalettePanelView plus a floor under how small
			 * the panel can be dragged, through ConstrainDimensions. See KBSPanelView.cpp - the same
			 * shape KESCL has used since 2026-07-17, which took it from customconditionaltextui.
			 */
			IID_ICONTROLVIEW, kKBSPanelViewImpl,
			/*
			 * Roll-over (2026-08-04, brought over from KESCM): while the "Translucent Panel" toggle
			 * is ON, the panel goes back to solid with the pointer on it. Verified over the whole
			 * panel area in KESCM, 2026-07-29.
			 * Note that IMouseRollOver has no usage example anywhere in the SDK; besides this AddIn
			 * it needs CREATE_PMINTERFACE *and* an entry in KBSFactoryList.h - a missing factory
			 * entry fails completely silently. Implementation: KBSPanelAlpha.cpp.
			 */
			IID_IMOUSEROLLOVER, kKBSPanelRollOverImpl,
		}
	},

	/*
	 * The panel's illustration: the system rollover icon button plus a tooltip of our own, so
	 * hovering the picture says where clicking it goes. Nothing else is added - the click itself is
	 * heard by the panel's observer, which is already there for the tab name.
	 *
	 * Same shape as kLinksUIButtonBoss in open/components/linksui, and as KESCM's
	 * kKESCMIconWidgetBoss - which is where this panel's layout comes from.
	 */
	Class
	{
		kKBSIconWidgetBoss,
		kRollOverIconButtonBoss,
		{
			IID_ITIP, kKBSIconTipImpl,
		}
	},

	/*
	 * Result tree list (Task 2): the tree-view widget carrying our hierarchy adapter and row
	 * widget manager. The framework provides the tree controller and default event handling
	 * (selection, expand/collapse); the row-click jump handler arrives in Task 3.
	 */
	Class
	{
		kKBSResultListWidgetBoss,
		kTreeViewWidgetBoss,
		{
			IID_ITREEVIEWHIERARCHYADAPTER, kKBSResultListAdapterImpl,
			IID_ITREEVIEWWIDGETMGR, kKBSResultListWidgetMgrImpl,
			/* Extends the stock handler so the up / down arrows OPEN the row they land on and run
			   that row's action - see KBSResultTreeEH.cpp. A book search comes up with every
			   chapter closed, and the stock keys walk visible rows only.
			   NOTE: this line alone does not create the handler. Implementations are made on first
			   QueryInterface, and the one that asks is KBSResultNodeEH's key-focus hand-off. */
			IID_IEVENTHANDLER, kKBSResultTreeEHImpl,
		}
	},

	/*
	 * The hit line's multi-colour text cell (Task 2): a generic panel widget whose IControlView
	 * is our self-drawing view (KBSColorTextView), plus the per-row draw data it paints.
	 */
	Class
	{
		kKBSColorTextWidgetBoss,
		kGenericPanelWidgetBoss,
		{
			IID_ICONTROLVIEW, kKBSColorTextViewImpl,
			IID_IKBSROWDATA, kKBSRowDataImpl,
		}
	},

	/*
	 * Result tree row (Task 3): the node boss now carries the click handler that jumps to a hit.
	 * Shared by the chapter and hit row resources; the handler tells them apart by the node index
	 * (only hit rows jump).
	 */
	Class
	{
		kKBSResultNodeWidgetBoss,
		kTreeNodeWidgetBoss,
		{
			IID_IEVENTHANDLER, kKBSResultNodeEHImpl,
		}
	},

	/*
	 * The hit row's check box (replace feature): a STOCK check box with our observer aggregated on
	 * it, so a click flips that hit's "replace me" flag. The system draws the box, so it follows
	 * the UI theme and needs no icon resources of ours - the layer panel's eyeball pattern
	 * (source/open/components/layerpanel). Only the hit row resource carries one.
	 */
	Class
	{
		kKBSResultCheckWidgetBoss,
		kCheckBoxWidgetBoss,
		{
			IID_IOBSERVER, kKBSResultCheckObserverImpl,
		}
	},

	/*
	 * The Glyph tab's replace confirmation: the stock kDialogBoss plus our controller - the shape
	 * basicdialog and KESCL's offset dialog both use. No IID_IOBSERVER: the dialog has nothing to
	 * do while it is open, only on OK.
	 */
	Class
	{
		kKBSReplaceConfirmDialogBoss,
		kDialogBoss,
		{
			IID_IDIALOGCONTROLLER, kKBSReplaceConfirmDialogControllerImpl,
		}
	},

	/*
	 * One glyph frame of that dialog: a generic panel whose IControlView is our own drawing view,
	 * exactly how the hit row's colour cell is built. Two instances, told apart by their WidgetID -
	 * which is how the view knows whether it is drawing the found glyph or the replacement.
	 */
	Class
	{
		kKBSGlyphViewWidgetBoss,
		kGenericPanelWidgetBoss,
		{
			IID_ICONTROLVIEW, kKBSGlyphViewImpl,
			// EVE decides a widget's size through its IID_IEVEINFO implementation, and the one
			// inherited from kGenericPanelWidgetBoss measures a PANEL - from its children. This
			// frame has no children (it holds a drawing), so that implementation collapsed it to
			// nothing and the font name sat directly under the label. kFixedSizeEVEInfoImpl is the
			// implementation for a widget whose size is simply what the resource says.
			// (No worked example of it exists in the SDK - it is declared in DialogLayoutID.h and
			// used nowhere - so this is confirmed by running it, not by reading.)
			IID_IEVEINFO, kFixedSizeEVEInfoImpl,
		}
	},

	/*
	 * Draw-event-handler service boss (Task 3): registers kDrawEventService (via IK2ServiceProvider)
	 * so the sibling IDrwEvtHandler is hooked into the draw-event dispatcher at startup; it draws
	 * the translucent red marker rectangle around a jumped-to hit.
	 */
	Class
	{
		kKBSDrawEventServiceBoss,
		kInvalidClass,
		{
			IID_IK2SERVICEPROVIDER, kKBSDrawEventSrvcImpl,
			IID_IDRWEVTHANDLER,     kKBSDrawEventHandlerImpl,
		}
	},

	/*
	 * Marker-expiry idle task boss (Task 3): a one-shot idle task, armed each time the marker is
	 * shown, that takes it back off the screen a second later. IID_IIDLETASK comes from ShuksanID.h.
	 */
	Class
	{
		kKBSMarkerExpiryIdleTaskBoss,
		kInvalidClass,
		{
			IID_IIDLETASK, kKBSMarkerExpiryIdleTaskImpl,
		}
	},

	/*
	 * Startup/shutdown service boss (Task 3): retires the marker idle task and clears module state
	 * during controlled shutdown. kLazyStartupShutdownProviderImpl (API-provided) registers it.
	 */
	Class
	{
		kKBSStartupShutdownBoss,
		kInvalidClass,
		{
			IID_ISTARTUPSHUTDOWN, kKBSStartupShutdownImpl,
			IID_IK2SERVICEPROVIDER, kLazyStartupShutdownProviderImpl,
		}
	},

	/*
	 * Book-close watcher: retires a BOOK-scope result set when the book it was searched in is
	 * closed - the book half of what KBSCloseDocResponder does for a single document. Books have
	 * no signal to responder-register for (not one of the SDK's signal ServiceIDs comes from
	 * BookID.h), so this has to be an observer.
	 *
	 * The AddIn goes on kSessionBoss because that is the subject the cue is broadcast from:
	 * kCloseBookCmdBoss @ kSessionBoss, protocol IID_IBOOKCONTENT - read off a debug build's
	 * Test > Spy. The attach itself is in KBSBookWatch.cpp; this line only puts our IID, and so
	 * the observer implementation, onto the session.
	 */
	AddIn
	{
		kSessionBoss,
		kInvalidClass,
		{
			IID_IKBSBOOKWATCH, kKBSBookWatchImpl,
		}
	},

	/*
	 * Panel visibility observer (2026-08-04, brought over from KESCM). Subscribes to the panel
	 * manager's subject and waits for kPaletteVisibilityChangedMessage, which fires whenever a panel
	 * is opened, closed, restored from an icon or drawer-expanded. The "Translucent Panel" toggle
	 * puts its alpha on the panel's CURRENT top-level window (an OWL.Dock), and that window is thrown
	 * away and recreated by those very actions - so without this the translucency would be silently
	 * lost. The attach itself is in KBSPanelAlpha.cpp; this line only puts our IID, and so the
	 * observer implementation, onto the boss.
	 *
	 * It goes on kActiveContextBoss rather than the kSessionBoss above because that is the proven
	 * arrangement: KESCM carries three observers there, this one among them. (A free-floating
	 * observer boss did NOT receive these notifications in practice - see KESCM.fr.)
	 */
	AddIn
	{
		kActiveContextBoss,
		kInvalidClass,
		{
			IID_IKBSPANELVISIBILITYOBSERVER, kKBSPanelVisibilityObserverImpl,
		}
	},

	/*
	 * Close-document responder boss: retires a DOCUMENT-scope result set when the searched document
	 * is closed - a row naming a closed document would still jump, and Change Checked would still
	 * reopen it to replace in it. Book results are left to the book-side responder.
	 *
	 * A boss that answers ONE signal does not need a ServiceProvider of its own: naming the API's
	 * kBeforeCloseDocSignalRespServiceImpl (DocumentID.h) registers this responder for that signal.
	 * CServiceProvider + HasMultipleIDs is only for a boss that answers several, as in
	 * linksui/ClosingDocumentsResponder.cpp. IID_IRESPONDER comes from ShuksanID.h, included above.
	 */
	Class
	{
		kKBSCloseDocResponderBoss,
		kInvalidClass,
		{
			IID_IK2SERVICEPROVIDER, kBeforeCloseDocSignalRespServiceImpl,
			IID_IRESPONDER,         kKBSCloseDocResponderImpl,
		}
	},

	/*
	 * Scripting provider: serves app.kfcStatus. Derives from kBaseScriptProviderBoss, which brings
	 * the machinery that dispatches script requests; all this boss adds is our own handler. The
	 * property itself is declared in the VersionedScriptElementInfo resource at the end of this file.
	 */
	Class
	{
		kKBSScriptProviderBoss,
		kBaseScriptProviderBoss,
		{
			IID_ISCRIPTPROVIDER, kKBSScriptProviderImpl,
		}
	},

}}};

/*  
 * Implementation definition.
 */
resource FactoryList (kSDKDefFactoryListResourceID)
{
	kImplementationIDSpace,
	{
		#include "KBSFactoryList.h"
	}
};

/*  
 * Menu definition.
 */
resource MenuDef (kSDKDefMenuResourceID)
{
	{
		// The About sub-menu item for this plug-in.
		kKBSAboutActionID,			// ActionID (kInvalidActionID for positional entries)
		kKBSAboutMenuPath,			// Menu Path.
		kSDKDefAlphabeticPosition,											// Menu Position.
		kSDKDefIsNotDynamicMenuFlag,										// kSDKDefIsNotDynamicMenuFlag or kSDKDefIsDynamicMenuFlag

		// Separator for the popup menu on the panel
		kKBSSeparator1ActionID,
		kKBSInternalPopupMenuNameKey kSDKDefDelimiterAndSeparatorPath,	// :- to mark an item as a separator.
		kKBSSeparator1MenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Find in Document / Find in Book: run the search over the current scope using the settings
		// in InDesign's own Find/Change dialog. Drawn under whichever of the two names the scope
		// calls for (see the action definition below).
		kKBSSearchBookActionID,
		kKBSTargetMenuPath
		kKBSSearchBookMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Find Missing Glyphs: scan the same scope for notdef glyphs (the boxes InDesign draws when
		// a font has no glyph for a character). Sits under the search command because the two are
		// siblings - both run something over the current scope.
		kKBSFindMissingGlyphsActionID,
		kKBSTargetMenuPath
		kKBSFindMissingGlyphsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Find Overset: list the text that did not fit. The third sibling of the two above - all
		// three run something over the current scope.
		kKBSFindOversetActionID,
		kKBSTargetMenuPath
		kKBSFindOversetMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Separator between the search command and the toggles.
		kKBSSeparator2ActionID,
		kKBSInternalPopupMenuNameKey kSDKDefDelimiterAndSeparatorPath,	// :- to mark an item as a separator.
		kKBSSeparator2MenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Book Scope: toggle (check mark). ON = the whole book, OFF = the front document.
		kKBSScopeBookActionID,
		kKBSTargetMenuPath
		kKBSBookScopeMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Hide Previous Chapter: toggle (check mark). Closes the previous chapter window on jump.
		kKBSHidePrevChapterActionID,
		kKBSTargetMenuPath
		kKBSHidePrevChapterMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Translucent Panel: toggle (check mark). ON = this panel is drawn faint while it floats,
		// and comes back to solid while the pointer is on it. *Windows only.
		kKBSTranslucentPanelActionID,
		kKBSTargetMenuPath
		kKBSTranslucentPanelMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Translucent Find/Change: the same for InDesign's OWN Find/Change dialog. Windows only.
		kKBSTranslucentFindChangeActionID,
		kKBSTargetMenuPath
		kKBSTranslucentFindChangeMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Save Panel Settings: write the toggles above to a JSON file of our own in the user's
		// preferences folder, read back at startup. A plain command, not a toggle.
		kKBSSavePanelSettingsActionID,
		kKBSTargetMenuPath
		kKBSSavePanelSettingsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Separator between the search/scope toggles and the replace block.
		kKBSSeparator3ActionID,
		kKBSInternalPopupMenuNameKey kSDKDefDelimiterAndSeparatorPath,	// :- to mark an item as a separator.
		kKBSSeparator3MenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Change Checked: replace every checked hit with the Find/Change dialog's change string.
		kKBSReplaceCheckedActionID,
		kKBSTargetMenuPath
		kKBSReplaceCheckedMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Save Results...: write the current result set to a tab-separated text file.
		kKBSSaveResultsActionID,
		kKBSTargetMenuPath
		kKBSSaveResultsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ----- The result rows' right-click context menu (2026-08-01) -----
		// Popped at the cursor by the row event handler (KBSResultNodeEH::RButtonDn, through
		// IMenuManager::HandlePopupMenu with this subtree's name). Check All / Uncheck All are its two
		// items; they sat on the flyout above until this date, where they could only ever mean "every
		// hit everywhere". Here they mean the row the menu was popped over - the BOOK row for all of
		// it, a document row for that chapter alone - which is why they moved.
		kKBSCheckAllActionID,
		kKBSResultRowMenuName
		kKBSCheckAllMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKBSUncheckAllActionID,
		kKBSResultRowMenuName
		kKBSUncheckAllMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "How to Use...": the plug-in's operating reference, in a scrollable dialog (KBSHowTo.cpp).
		// Between the separator and About, where KESCM puts its own.
		kKBSHowToActionID,
		kKBSTargetMenuPath
		kKBSHowToMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// About this plug-in sub-menu for the popup menu on the panel
		kKBSPopupAboutThisActionID,
		kKBSTargetMenuPath
		kKBSAboutThisMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

	}
};

/* 
 * Action definition.
 */
resource ActionDef (kSDKDefActionResourceID)
{
	{
		kKBSActionComponentBoss, 		// ClassID of boss class that implements the ActionID.
		kKBSAboutActionID,	// ActionID.
		kKBSAboutMenuKey,	// Sub-menu string.
		kOtherActionArea,				// Area name (see ActionDefs.h).
		kNormalAction,					// Type of action (see ActionDefs.h).
		kDisableIfLowMem,				// Enabling type (see ActionDefs.h).
		kInvalidInterfaceID,			// Selection InterfaceID this action cares about or kInvalidInterfaceID.
		kSDKDefInvisibleInKBSCEditorFlag, // kSDKDefVisibleInKBSCEditorFlag or kSDKDefInvisibleInKBSCEditorFlag.

		kKBSActionComponentBoss,
		kKBSPopupAboutThisActionID,
		kSDKDefAboutThisPlugInMenuKey,	// Key to the name of this action
		kOtherActionArea,
		kNormalAction,
		kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// The search command. kCustomEnabling is what lets UpdateActionStates rename it to
		// "Find in Book" / "Find in Document" as the Book Scope toggle flips; without it that hook
		// is never called for this action.
		// NOT kDisableIfNoFrontDocument: a book search runs off IBookManager's active book and opens
		// its chapters windowless, so "a book is open but no document window is" is a normal, working
		// state here. That flag would grey this out - and skip UpdateActionStates, losing the name -
		// exactly when the panel is most useful. The Layers panel can afford it; this one cannot.
		// "There is nothing to run on" IS answered, but in UpdateActionStates, where the question can
		// be put to the CURRENT scope (KBSBookScope::HasScopeTarget).
		kKBSActionComponentBoss,
		kKBSSearchBookActionID,
		kKBSSearchBookMenuKey,			// "Search" (renamed at run time to carry the scope)
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// The glyph scan. Same flags as the search command above, and for the same reasons: it runs
		// over the same scope, so it must stay live while a book is open with no document window
		// (hence no kDisableIfNoFrontDocument), and kCustomEnabling keeps UpdateActionStates as the
		// one place that decides whether either command can run - including whether the current
		// scope has anything to run on at all.
		kKBSActionComponentBoss,
		kKBSFindMissingGlyphsActionID,
		kKBSFindMissingGlyphsMenuKey,	// "Find Missing Glyphs"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// The overset scan. Same flags as the two commands above, and for the same reasons: it runs
		// over the same scope, so it must stay live while a book is open with no document window
		// (hence no kDisableIfNoFrontDocument), and kCustomEnabling keeps UpdateActionStates as the
		// one place that decides whether it can run - including whether the current scope has
		// anything to run on at all.
		kKBSActionComponentBoss,
		kKBSFindOversetActionID,
		kKBSFindOversetMenuKey,			// "Find Overset"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,


		kKBSActionComponentBoss,
		kKBSScopeBookActionID,
		kKBSBookScopeMenuKey,			// "Book Scope" (toggle, check mark)
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKBSActionComponentBoss,
		kKBSHidePrevChapterActionID,
		kKBSHidePrevChapterMenuKey,		// "Hide Previous Chapter" (toggle, check mark)
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Translucent Panel. kCustomEnabling for the check mark, like the two toggles above - and for
		// nothing else: it is deliberately NOT greyed out while the panel is docked, where it has no
		// visible effect (the user's call in KESCM, 2026-07-29). Pressing it there sets the flag,
		// which applies the moment the panel floats again, and the status line says so rather than
		// leaving a click with no result unexplained.
		kKBSActionComponentBoss,
		kKBSTranslucentPanelActionID,
		kKBSTranslucentPanelMenuKey,	// "Translucent Panel" (toggle, check mark)
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Translucent Find/Change. kCustomEnabling for the check mark, like the toggle above it. Not
		// greyed out while the dialog is closed, for the same reason the panel one is not greyed out
		// while docked: the flag is what the user is setting, and it applies the moment the dialog
		// opens. The status line says which of the two happened.
		kKBSActionComponentBoss,
		kKBSTranslucentFindChangeActionID,
		kKBSTranslucentFindChangeMenuKey,	// "Translucent Find/Change" (toggle, check mark)
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Save Panel Settings. NO kCustomEnabling: there is nothing to enable it against - it writes
		// the settings down, which is possible with nothing loaded and no results. KESCM's own carries
		// the same flags for the same reason.
		// !Without kCustomEnabling this action never reaches UpdateActionStates at all, so the blanket
		// disable at the top of that method does NOT cover it - the hook completes the enabling only
		// for actions that ask for it (ActionDefs.h:40). The note here said the opposite until
		// 2026-08-04. It changes nothing in practice: a run's progress bar is modal, so the flyout
		// cannot be opened while one is going (measured on the running panel, 2026-08-03).
		kKBSActionComponentBoss,
		kKBSSavePanelSettingsActionID,
		kKBSSavePanelSettingsMenuKey,	// "Save Panel Settings"
		kOtherActionArea,
		kNormalAction,
		kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Change Checked. kCustomEnabling so UpdateActionStates can grey it out while nothing is
		// checked - the same flag the toggles need. Guarding it against closed documents has to
		// happen in UpdateActionStates (per-hit, via KBSBookScope::IsDocStillOpen), NOT with
		// kDisableIfNoFrontDocument: replacing in windowless book chapters is a supported case.
		kKBSActionComponentBoss,
		kKBSReplaceCheckedActionID,
		kKBSReplaceCheckedMenuKey,		// "Change Checked"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Save Results.... kCustomEnabling so UpdateActionStates can grey it out while there are no
		// results to write - the same flag every other command here needs. No kDisableIfNoFrontDocument:
		// what it writes is the RESULT SET, which outlives the document window that produced it (a book
		// run leaves no window open at all).
		kKBSActionComponentBoss,
		kKBSSaveResultsActionID,
		kKBSSaveResultsMenuKey,			// "Save Results..."
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// Check All / Uncheck All - the result rows' right-click menu since 2026-08-01 (the MenuDef
		// above). kCustomEnabling so UpdateActionStates can grey them out when the row the menu was
		// popped over has nothing left to check; it is also what lets that hook see them at all, and
		// the hook is where the right-click target is read.
		kKBSActionComponentBoss,
		kKBSCheckAllActionID,
		kKBSCheckAllMenuKey,			// "Check All"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKBSActionComponentBoss,
		kKBSUncheckAllActionID,
		kKBSUncheckAllMenuKey,			// "Uncheck All"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// "How to Use...". NO kCustomEnabling, unlike every command above it: this one has nothing
		// to be enabled against. It reads a text - no document, no result set, no selection - so it
		// stays live with nothing loaded, which is exactly when a first-time user reaches for it.
		//
		// !It is NOT caught by the blanket disable at the top of UpdateActionStates either: an action
		// without kCustomEnabling is never passed to that method, which completes the enabling only
		// for the ones that ask for it (ActionDefs.h:40). This note claimed the reverse until
		// 2026-08-04. It changes nothing in practice: the run's progress bar is modal, so the flyout
		// cannot be opened while one is going (measured on the running panel, 2026-08-03).
		kKBSActionComponentBoss,
		kKBSHowToActionID,
		kKBSHowToMenuKey,				// "How to Use..."
		kOtherActionArea,
		kNormalAction,
		kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

	}
};


